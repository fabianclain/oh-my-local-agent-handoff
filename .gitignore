# Run artifacts: prompts, provider logs, session ids, tree snapshots.
# These contain your source, your plans, and provider transcripts — never commit them.
.handoff/runs/
.handoff/think/
.handoff/debug/

# Agent-harness scratch state. Contains absolute paths, session ids, and usage/cost data.
.omc/
.claude/

# Local config may name internal systems or private conventions.
.handoff/config.sh

*.log
.DS_Store

# Python bytecode from the proxy/shim tools
__pycache__/
*.pyc

# Overnight queue output: logs and per-job state, regenerated every run.
.overnight/

# Regenerated from the bench archive by tools/build-trace-dataset. Megabytes of derived
# data with an authoritative source; the baselines under .handoff/capability/ are kept because
# they are reference points a later diff needs, and are kilobytes.
.handoff/datasets/
