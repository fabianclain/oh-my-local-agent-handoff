#!/usr/bin/env bash
#
# graphs-pass — one unattended replay of the crawler-graphs feature, start to finish.
#
#   bench/graphs-pass <name> pure          no orchestrator; stops at the first rejection
#   bench/graphs-pass <name> consult       asks Claude what kind of failure a rejection was
#   GRAPHS_REROLL=2 bench/graphs-pass <name> pure    re-roll a rejected step twice
#
# Eight steps, in the order the original session ran them, from the tree as it stood before any
# of the work existed. Plans are all present from the start; each step's reviewer test is staged
# immediately before that step runs — see bench/stage-graph-test for why those differ.
#
# ## What the two modes are for
#
# They are the same run with one variable changed, which is the only way to find out whether the
# orchestrator earns its place:
#
#   pure      the harness advances on an accepted step and stops on a rejected one. This is the
#             completion rate with nobody in the loop at all.
#   consult   on a rejection a DIFFERENT model reads the plan, the gates' evidence and the diff,
#             and answers one question: could an ideal implementation satisfy every failing
#             criterion? Model error earns one narrower retry. An unsatisfiable criterion, or any
#             uncertainty, still stops — because the failure this protects against is a criterion
#             the model cannot honestly pass, and against one of those a retry is worse than a
#             stop. It has already produced `Carbon::setTestNow()` in production code.
#
# The comparison is the point. If consult does not move the completion rate, it is latency and
# cost with a story attached, and that is worth knowing before it becomes the default.

set -uo pipefail

NAME="${1:?usage: graphs-pass <name> <pure|consult>}"
MODE="${2:?mode required: pure or consult}"

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HANDOFF_HOME="$(cd "$HERE/.." && pwd)"
BASE="${GRAPHS_BASE:-bench-graphs-base}"
RESULTS="${GRAPHS_RESULTS:-/home/fabbs/dev/bench-trees/results}"

# The sequence, overridable so a step can be dropped without editing this file.
#
# `crawler-graphs-3b-shape` is in the default list because the original session ran it, and it is
# the first thing anyone should drop: it is a REPAIR plan, written because 3-series came back
# damaged that night. When 3-series succeeds it has no work to do, and across three replays it
# produced one no-op round, one that broke the previous step's tests, and one that rewrote a
# correct file 83 insertions deep and scored 2 of 7. A step with nothing to do does not come back
# empty — the model finds something to change, and the only thing available is working code.
if [[ -n "${GRAPHS_STEPS:-}" ]]; then
    read -r -a STEPS <<<"$GRAPHS_STEPS"
else
    STEPS=(
        crawler-graphs-1-schema
        crawler-graphs-2-collect
        crawler-graphs-3-series
        crawler-graphs-3b-shape
        crawler-graphs-4a-command
        crawler-graphs-4b-wiring
        crawler-graphs-5a-chart
        crawler-graphs-5b-page
    )
fi

mkdir -p "$RESULTS"
TREE="$("$HERE/monolith-worktree" "$NAME" "$BASE")" || { echo "could not build a worktree for $NAME" >&2; exit 1; }

ARGS=(--before-step "$HERE/stage-graph-test")
[[ "$MODE" != consult ]] || ARGS+=(--consult claude)

# How many extra independent rolls a rejected step gets. Off by default so every pass recorded
# before this existed remains comparable with one recorded after it — a pass that silently started
# re-rolling would make "landed N of 8" mean two different things in the same summary.tsv.
#
# Deliberately usable with MODE=pure. Re-roll and consult are separate variables and the point of
# the bench is to move one at a time: consult CANCELS remaining rolls when it cannot confirm the
# failure was the model's, so a consult pass measures the pair rather than the re-roll.
[[ "${GRAPHS_REROLL:-0}" == 0 ]] || ARGS+=(--reroll "$GRAPHS_REROLL")

# The recorded mode carries the re-roll count, in the existing field rather than a new one: the
# summary is read by eye and a file with some 5-field rows and some 6-field rows is worse than a
# self-describing label. "landed 3 of 8" means nothing without knowing how many rolls bought it.
MODE_LABEL="$MODE"
[[ "${GRAPHS_REROLL:-0}" == 0 ]] || MODE_LABEL="$MODE+reroll$GRAPHS_REROLL"
# And the implementer, when it is not the local model. Two passes that differ only in who wrote the
# code are the whole point of GRAPHS_PROVIDER, and a summary that does not say which is which
# records two numbers for one label.
[[ "${GRAPHS_PROVIDER:-native}" == native ]] || MODE_LABEL="$MODE_LABEL/${GRAPHS_PROVIDER}"

cd "$TREE" || exit 1

# The implementer is the local model in both modes. `--consult claude` names the ORCHESTRATOR,
# which must be a different model — a model that writes the plan, judges whether its own criteria
# were satisfiable, and then implements against them has removed every independent check at once.
export HANDOFF_PROVIDER="${GRAPHS_PROVIDER:-native}"

LOG="$RESULTS/$NAME.log"
{
    echo "== $NAME ($MODE_LABEL) started $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "   tree $TREE at $(git rev-parse --short HEAD)"
} | tee "$LOG"

"$HANDOFF_HOME/bin/handoff" sequence "${ARGS[@]}" "${STEPS[@]}" 2>&1 | tee -a "$LOG"
STATUS=${PIPESTATUS[0]}

# One line per pass, appended, so a kill at 04:00 still leaves a readable record. How far it got
# is the measurement — `handoff sequence` commits exactly the accepted steps and nothing else, so
# counting them off the base is counting what landed unattended.
# Not every commit on the branch is a landed step: bench/stage-graph-test commits each reviewer
# test before the step it judges, under a distinct author so the two can be told apart. Counting
# all of them would report a pass that landed nothing as having landed eight.
#
# No `|| echo 0` here, however defensive it looks. `grep -c` prints its count and THEN exits 1
# when that count is zero, so the fallback fired at exactly the moment grep had already printed a
# `0`, and the substitution captured both of them. A pass that landed nothing wrote `landed 0`,
# a newline, and `0 of 8` — splitting its own row in two, in the one file whose whole job is to
# stay readable after a kill at 04:00. It corrupted the two rows it was there to protect and
# could never have helped any other.
LANDED="$(git log --format='%ae' "$BASE"..HEAD 2>/dev/null | grep -cv '^reviewer@bench$')"
# grep -c always prints exactly one number, empty input included, so this cannot fire today. It
# is here so that the row stays one row regardless of what the pipeline above ever becomes.
[[ "$LANDED" =~ ^[0-9]+$ ]] || LANDED=0
printf '%s\t%s\t%s\tlanded %s of %s\texit %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NAME" "$MODE_LABEL" "$LANDED" "${#STEPS[@]}" "$STATUS" \
    >>"$RESULTS/summary.tsv"

# Keep the commits reachable after the worktree is reset for the next pass.
git tag -f "pass/$NAME" >/dev/null 2>&1 || true

echo "== $NAME landed $LANDED of ${#STEPS[@]} steps (exit $STATUS)" | tee -a "$LOG"
exit "$STATUS"
