#!/usr/bin/env bash
#
# bench/run — execute one plan across providers without sharing their work.
#
#   bench/run --plan <slug> --providers <name,...> [--repeat <n>] [--force|--append]
#
# Every attempt starts from the same commit in a detached worktree. Reusing a tree would let a
# later provider inherit an earlier provider's edits, turning isolation into a cosmetic claim.

set -euo pipefail

# Serialise benchmarks before anything else runs.
#
# This must sit above argument parsing: the parser consumes "$@" with shift, so a re-exec placed
# after it passes no arguments and the script fails with "--plan is required".
#
# flock --close rather than `exec 9>lock`, because a bare descriptor is inherited by every child
# and an opencode process outliving a timed-out run then holds the lock after its parent exits.
# That wedged the bench for a full 600s wait and made a legitimate queued round look like a
# concurrency violation.
#
# Concurrent runs share the GPU and, with OLLAMA_MAX_LOADED_MODELS=1, evict each other's model
# continuously — so they measure contention rather than the model.
if [[ -z "${BENCH_LOCK_HELD:-}" ]]; then
    export BENCH_LOCK_HELD=1
    BENCH_LOCK="${TMPDIR:-/tmp}/agent-handoff-bench.lock"
    exec flock --close -w "${BENCH_LOCK_WAIT:-600}" "$BENCH_LOCK" "$0" "$@"
fi

usage() {
    echo "usage: bench/run --plan <slug> --providers <name,...> [--repeat <n>] [--force|--append]" >&2
}

PLAN=""
PROVIDERS=""
REPEAT=3
FORCE=0
APPEND=0

while (( $# > 0 )); do
    case "$1" in
    --plan)
        [[ $# -ge 2 ]] || { echo "--plan requires a slug" >&2; usage; exit 64; }
        PLAN="$2"
        shift 2
        ;;
    --plan=*)
        PLAN="${1#*=}"
        shift
        ;;
    --providers)
        [[ $# -ge 2 ]] || { echo "--providers requires a comma-separated list" >&2; usage; exit 64; }
        PROVIDERS="$2"
        shift 2
        ;;
    --providers=*)
        PROVIDERS="${1#*=}"
        shift
        ;;
    --repeat)
        [[ $# -ge 2 ]] || { echo "--repeat requires a positive integer" >&2; usage; exit 64; }
        REPEAT="$2"
        shift 2
        ;;
    --repeat=*)
        REPEAT="${1#*=}"
        shift
        ;;
    --force)
        FORCE=1
        shift
        ;;
    --append)
        APPEND=1
        shift
        ;;
    *)
        echo "unknown argument: $1" >&2
        usage
        exit 64
        ;;
    esac
done

[[ -n "$PLAN" ]] || { echo "--plan is required" >&2; usage; exit 64; }
[[ -n "$PROVIDERS" ]] || { echo "--providers is required" >&2; usage; exit 64; }
[[ "$PROVIDERS" != ,* && "$PROVIDERS" != *, && "$PROVIDERS" != *,,* ]] || {
    echo "--providers contains an empty name" >&2
    exit 64
}
[[ "$PLAN" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid plan slug: $PLAN" >&2
    exit 64
}
[[ "$REPEAT" =~ ^[1-9][0-9]*$ ]] || {
    echo "--repeat must be a positive integer" >&2
    exit 64
}

BENCH_TIMEOUT_SECONDS="${BENCH_TIMEOUT_SECONDS:-3600}"
BENCH_VERIFY_TIMEOUT_SECONDS="${BENCH_VERIFY_TIMEOUT_SECONDS:-120}"
# Attempts per repetition, including the first. 3 means one run plus two repairs.
BENCH_MAX_ATTEMPTS="${BENCH_MAX_ATTEMPTS:-3}"
# How much a repair attempt is told about the attempt before it.
#
#   commands  the failing command lines, and nothing else. The measured baseline.
#   full      also the harness's captured output for each failing command, and the diff of what
#             the previous attempts actually changed.
#
# This is a variable rather than a change in behaviour because richer feedback is a hypothesis,
# not an improvement. It may as easily distract: reasoning at `medium` already made a model write
# its own verification scripts instead of running the plan's, and a longer failure narrative
# pushes in that same direction. The two settings exist so the question can be measured on
# attempts-to-green rather than argued.
BENCH_FEEDBACK_DETAIL="${BENCH_FEEDBACK_DETAIL:-commands}"
BENCH_FEEDBACK_OUTPUT_LINES="${BENCH_FEEDBACK_OUTPUT_LINES:-12}"
BENCH_FEEDBACK_DIFF_BYTES="${BENCH_FEEDBACK_DIFF_BYTES:-24000}"
[[ "$BENCH_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
    echo "BENCH_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 64
}
[[ "$BENCH_VERIFY_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
    echo "BENCH_VERIFY_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 64
}
[[ "$BENCH_FEEDBACK_DETAIL" == commands || "$BENCH_FEEDBACK_DETAIL" == full ]] || {
    echo "BENCH_FEEDBACK_DETAIL must be 'commands' or 'full'" >&2
    exit 64
}
[[ "$BENCH_FEEDBACK_OUTPUT_LINES" =~ ^[0-9]+$ ]] || {
    echo "BENCH_FEEDBACK_OUTPUT_LINES must be a non-negative integer" >&2
    exit 64
}
[[ "$BENCH_FEEDBACK_DIFF_BYTES" =~ ^[1-9][0-9]*$ ]] || {
    echo "BENCH_FEEDBACK_DIFF_BYTES must be a positive integer" >&2
    exit 64
}
[[ "$BENCH_MAX_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || {
    echo "BENCH_MAX_ATTEMPTS must be a positive integer" >&2
    exit 64
}

BENCH_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$BENCH_HOME" rev-parse --show-toplevel)"
PLAN_FILE="$BENCH_HOME/plans/$PLAN.md"
RESULTS_DIR="$BENCH_HOME/results/$PLAN"
WORK_DIR="$BENCH_HOME/.work"
BASE_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD)"

# Which harness produced this result.
#
# Benchmarks run from a clone, and the clone drifted from the working checkout without anything
# noticing. A fix for Cline's retry path — `--id` is incompatible with `--json` plus a prompt
# argument, so every prompt-validate retry died instantly on an empty prompt — was written, tested
# and left in the working repository while 25 of 61 recorded runs went on exercising the broken
# path. Sixteen of those produced a byte-correct tree and were scored down because the recovery
# that should have salvaged the report never ran.
#
# Nothing in a result said which harness it came from, so the drift was invisible for as long as
# nobody diffed two checkouts by hand. Now every metrics file carries it.
HARNESS_COMMIT="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)" ]]; then
    HARNESS_DIRTY=1
else
    HARNESS_DIRTY=0
fi

# The commit is not enough, and the dirty bit is not enough either.
#
# Three arms of the 2026-08-12 night all recorded `harness_commit=628e3b2 harness_dirty=1`. That
# names a commit and says "plus some edits" — it does not say WHICH edits, so two arms hours apart
# can carry identical provenance and have been produced by different code. Every comparison drawn
# across them rests on an assumption the metrics cannot support.
#
# So hash the tree the run actually executed. A throwaway index means this neither touches the real
# index nor requires a clean checkout, which is the same technique the run uses for before/after
# tree snapshots. .gitignore keeps results, logs and scratch out of it; measured at ~25 ms.
HARNESS_TREE="$(
    _harness_index="$(mktemp -u)"
    GIT_INDEX_FILE="$_harness_index" git -C "$REPO_ROOT" add -A 2>/dev/null
    GIT_INDEX_FILE="$_harness_index" git -C "$REPO_ROOT" write-tree 2>/dev/null
    rm -f "$_harness_index"
)"
HARNESS_TREE="${HARNESS_TREE:-unknown}"

[[ -f "$PLAN_FILE" ]] || { echo "plan not found: bench/plans/$PLAN.md" >&2; exit 1; }

# Checked once here rather than discovered mid-round. A missing renderer would abort under `set -e`
# somewhere inside the repair loop, after hours of runs, and the partial matrix left behind would
# look like a model that stopped responding.
FEEDBACK_RENDERER="$REPO_ROOT/tools/render-feedback"
[[ -x "$FEEDBACK_RENDERER" ]] || {
    echo "feedback renderer missing or not executable: tools/render-feedback" >&2
    exit 1
}

# An agent process left over from an earlier round still holds the model and still generates, and
# nothing attributes what it generates to anything. Twice here that has read as a model collapsing.
# It is worse now that tokens are counted by log region: a ghost's output is charged to whichever
# round is open. Checked at startup, when it can still be fixed cheaply.
GHOST_SWEEP="$REPO_ROOT/tools/check-no-ghosts"
[[ -x "$GHOST_SWEEP" ]] || GHOST_SWEEP=""
if [[ -n "$GHOST_SWEEP" ]]; then
    "$GHOST_SWEEP" --kill || exit 1
fi

# An incomplete old directory is still evidence from an earlier attempt. Refusing existing paths
# prevents a rerun from quietly mixing new artifacts with a partial prior matrix.
#
# --force clears only the providers being run, never the whole plan. Deleting the plan directory
# destroys every other provider's baseline, which is unrecoverable and silent: adding a fifth
# model to a comparison would wipe the four already measured, and the report afterwards looks
# like a clean single-provider run rather than a loss. Comparing models one at a time is the
# normal way to use this, so the destructive reading of --force was wrong for the common case.
# Only one benchmark may run at a time on a machine. Two concurrent runs share a GPU and, with
# OLLAMA_MAX_LOADED_MODELS=1, evict each other's model continuously -- so both produce timings and
# outcomes that measure the contention rather than the model. That happened here: a forgotten loop
# and its replacement ran together, each thrashing the other, and neither result was usable.
#
# flock is used rather than a PID file because it releases automatically when the process dies,
# including on kill -9, so a crashed run cannot leave the bench permanently locked.
# Parsed here rather than at first use further down: the --force scoping below needs it, and a
# list parsed twice is a list that can disagree with itself.
IFS=',' read -r -a PROVIDER_LIST <<<"$PROVIDERS"
(( ${#PROVIDER_LIST[@]} > 0 )) || { echo "--providers list is empty" >&2; exit 64; }

(( FORCE && APPEND )) && {
    echo "--force and --append contradict each other: one deletes the prior results, the other" >&2
    echo "continues them. Pick the one you meant." >&2
    exit 64
}

for _provider in "${PROVIDER_LIST[@]}"; do
    _dir="$RESULTS_DIR/$_provider"
    [[ -e "$_dir" ]] || continue
    # --append is the deliberate "yes, mix these" answer to the refusal below. It is safe in a way
    # a rerun is not, because it never reuses a repetition number and so cannot overwrite an
    # artifact: the numbering continues past whatever is there.
    (( APPEND )) && continue
    [[ "$FORCE" -eq 1 ]] || {
        echo "results already exist for '$PLAN/$_provider'; use --force to replace them," >&2
        echo "or --append to add repetitions to them" >&2
        exit 1
    }
    # Move it aside rather than delete it. docs/BENCHMARK-QUEUE.md has warned in prose for weeks —
    # "archive any arm that is a control for published results before re-running its label, or the
    # baseline is gone with no way back" — and on 2026-08-11 a queue's own wave-1 --force deleted a
    # 20-run wide/lcgptossl control that four separate findings had been computed against. The
    # warning was read, believed, and still not acted on, because acting on it required remembering
    # at the right moment. bench/results is not tracked by git, so there was nothing to recover.
    #
    # An archive costs a few megabytes per arm and one rename. That is the whole trade.
    _stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    _archive="$BENCH_HOME/archive/${PLAN}-${_provider}-${_stamp}"
    mkdir -p "$(dirname "$_archive")"
    if mv -- "$_dir" "$_archive" 2>/dev/null; then
        echo "archived $(ls "$_archive" 2>/dev/null | wc -l) existing run(s) to ${_archive#"$BENCH_HOME"/}"
    else
        # Refuse rather than fall back to deleting. A --force that cannot preserve what it is
        # replacing is exactly the case worth stopping on.
        echo "could not archive existing results at $_dir; refusing to delete them" >&2
        exit 1
    fi
done

mkdir -p "$RESULTS_DIR" "$WORK_DIR"

CRITERIA_FILE="$(mktemp)"
VERIFICATION_FILE="$(mktemp)"
ALLOWED_FILE="$(mktemp)"
ACTIVE_WORKTREE=""

cleanup() {
    rm -f "$CRITERIA_FILE" "$VERIFICATION_FILE" "$ALLOWED_FILE"
    if [[ -n "$ACTIVE_WORKTREE" && -d "$ACTIVE_WORKTREE" ]]; then
        # A dead provider must not leave a registered tree that poisons the next invocation.
        git -C "$REPO_ROOT" worktree remove --force "$ACTIVE_WORKTREE" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

grep -E '^- \[ \]' "$PLAN_FILE" >"$CRITERIA_FILE" || true
CRITERIA_TOTAL="$(wc -l <"$CRITERIA_FILE" | tr -d ' ')"

# Verification commands are executable plan data. Restrict extraction to the fenced block under
# its heading so examples elsewhere in a plan can never be run by accident.
awk '
    /^## Verification([[:space:]]+commands)?[[:space:]]*$/ { in_section=1; next }
    in_section && /^```/ {
        if (in_block) exit
        in_block=1
        next
    }
    in_block && NF { print }
' "$PLAN_FILE" >"$VERIFICATION_FILE"

# The first table column is the scope contract. Reading only that section prevents unrelated
# Markdown tables from granting edits the plan never authorised.
awk '
    /^## Files to touch[[:space:]]*$/ { in_section=1; next }
    in_section && /^## / { exit }
    in_section && /^\|/ {
        split($0, cells, "|")
        path=cells[2]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", path)
        gsub(/`/, "", path)
        if (path != "Path" && path !~ /^-+$/ && path != "") print path
    }
' "$PLAN_FILE" >"$ALLOWED_FILE"

[[ "$CRITERIA_TOTAL" -gt 0 ]] || { echo "plan has no checklist criteria: bench/plans/$PLAN.md" >&2; exit 1; }
[[ -s "$VERIFICATION_FILE" ]] || { echo "plan has no verification commands: bench/plans/$PLAN.md" >&2; exit 1; }

# The score's denominator is the checklist and its numerator is the command list, so a plan whose
# two counts disagree can never be fully satisfied and every model on it looks worse than it is.
#
# surgical-discount shipped with six checklist items and two commands, making 2/6 the maximum
# achievable score. That was read as a model scoring a third of the criteria when it was in fact
# passing everything the harness ever ran, and it understated the gap to a model that scored 1/6
# by doing nothing at all. A denominator nothing can reach is not a measurement.
VERIFICATION_TOTAL="$(grep -c . "$VERIFICATION_FILE" | tr -d ' ')"
[[ "$VERIFICATION_TOTAL" -eq "$CRITERIA_TOTAL" ]] || {
    echo "plan bench/plans/$PLAN.md has $CRITERIA_TOTAL checklist criteria but" >&2
    echo "$VERIFICATION_TOTAL verification commands. Scoring counts commands, so the maximum" >&2
    echo "achievable score would be $VERIFICATION_TOTAL/$CRITERIA_TOTAL and every provider would" >&2
    echo "be understated. Give each criterion exactly one command, in the same order." >&2
    exit 1
}
[[ -s "$ALLOWED_FILE" ]] || { echo "plan has no Files to touch entries: bench/plans/$PLAN.md" >&2; exit 1; }

json_balanced() {
    awk '
        { data=data $0 "\n" }
        END {
            braces=0; brackets=0; string=0; escaped=0; seen=0
            for (i=1; i<=length(data); i++) {
                c=substr(data,i,1)
                if (string) {
                    if (escaped) { escaped=0; continue }
                    if (c == "\\") { escaped=1; continue }
                    if (c == "\"") string=0
                    continue
                }
                if (c == "\"") { string=1; seen=1; continue }
                if (c == "{") { braces++; seen=1 }
                else if (c == "}") { braces--; if (braces < 0) exit 1 }
                else if (c == "[") brackets++
                else if (c == "]") { brackets--; if (brackets < 0) exit 1 }
            }
            exit !(seen && !string && braces == 0 && brackets == 0)
        }
    ' "$1"
}

json_array_count() {
    local file="$1" key="$2"
    awk -v key="$key" '
        { data=data $0 "\n" }
        END {
            pattern="\"" key "\"[[:space:]]*:[[:space:]]*\\["
            if (!match(data, pattern)) exit 2
            start=RSTART+RLENGTH-1
            arrays=1; objects=0; string=0; escaped=0; seen=0; commas=0
            for (i=start+1; i<=length(data); i++) {
                c=substr(data,i,1)
                if (string) {
                    if (escaped) { escaped=0; continue }
                    if (c == "\\") { escaped=1; continue }
                    if (c == "\"") string=0
                    continue
                }
                if (c == "\"") { string=1; seen=1; continue }
                if (c == "[") { arrays++; seen=1; continue }
                if (c == "]") {
                    arrays--
                    if (arrays == 0) { print seen ? commas+1 : 0; exit }
                    continue
                }
                if (c == "{") { objects++; seen=1; continue }
                if (c == "}") { objects--; continue }
                if (c == "," && arrays == 1 && objects == 0) { commas++; continue }
                if (c !~ /[[:space:]]/) seen=1
            }
            exit 3
        }
    ' "$file"
}

extract_deviations() {
    awk '
        { data=data $0 "\n" }
        END {
            for (i=1; i<=length(data); i++) {
                if (substr(data,i,1) != "\"") continue
                token=""; escaped=0
                for (j=i+1; j<=length(data); j++) {
                    c=substr(data,j,1)
                    if (escaped) { token=token "\\" c; escaped=0; continue }
                    if (c == "\\") { escaped=1; continue }
                    if (c == "\"") break
                    token=token c
                }
                k=j+1
                while (substr(data,k,1) ~ /[[:space:]]/) k++
                if (token == "what" && substr(data,k,1) == ":") {
                    k++
                    while (substr(data,k,1) ~ /[[:space:]]/) k++
                    if (substr(data,k,1) != "\"") exit 2
                    value=""; escaped=0
                    for (j=k+1; j<=length(data); j++) {
                        c=substr(data,j,1)
                        if (escaped) { value=value "\\" c; escaped=0; continue }
                        if (c == "\\") { escaped=1; continue }
                        if (c == "\"") break
                        value=value c
                    }
                    if (j > length(data)) exit 3
                    print value
                    i=j
                    continue
                }
                i=j
            }
        }
    ' "$1"
}

report_status() {
    tr -d '\n\r' <"$1" |
        sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

report_has_required_fields() {
    local file="$1" field
    for field in status summary files_changed tests_run deviations blockers follow_ups; do
        grep -Eq "\"$field\"[[:space:]]*:" "$file" || return 1
    done
}

write_metrics() {
    local dir="$1" status="$2" criteria_met="$3" scope="$4" deviations="$5"
    local blockers="$6" rounds="$7" elapsed="$8" exit_code="$9"
    local rewrites="${10:-0}" empty="${11:-0}" litter="${12:-0}" outcome="${13:-unknown}"
    printf '%s\n' \
        "status=$status" \
        "outcome=$outcome" \
        "harness_commit=$HARNESS_COMMIT" \
        "harness_dirty=$HARNESS_DIRTY" \
        "harness_tree=$HARNESS_TREE" \
        "feedback_detail=$PROVIDER_FEEDBACK_DETAIL" \
        "prompt_tokens=$PROMPT_TOKENS" \
        "generated_tokens=$GENERATED_TOKENS" \
        "model_requests=$MODEL_REQUESTS" \
        "usage_unattributable=$USAGE_UNATTRIBUTABLE" \
        "truncated_requests=$TRUNCATED_REQUESTS" \
        "context_overflows=$CONTEXT_OVERFLOWS" \
        "criteria_total=$CRITERIA_TOTAL" \
        "criteria_met=$criteria_met" \
        "scope_violations=$scope" \
        "litter=$litter" \
        "rewrite_violations=$rewrites" \
        "attempts=$ATTEMPTS" \
        "empty_diff=$empty" \
        "deviations=$deviations" \
        "blockers=$blockers" \
        "rounds_to_green=$rounds" \
        "wall_clock_seconds=$elapsed" \
        "exit_code=$exit_code" >"$dir/metrics"
}

capture_tree_artifacts() {
    local tree="$1" run_dir="$2" result_dir="$3"
    local before="$run_dir/tree-before" after="$run_dir/tree-after"
    local excludes=(
        ':(exclude).handoff/runs/**'
        # The scratch directory is granted to the model by templates/agent-rules.md — "that
        # directory is yours, it is ignored by the verifier and by git, and it is the only place
        # outside the plan's file list where you may create anything" — and the journal is the
        # harness writing its own records mid-round. Counting either as the model's work scores a
        # model down for following its instructions.
        #
        # This cost a whole night. Of 40 runs, 8 were classified `patch-damaged` on nothing but
        # sanctioned scratch files, dropping the measured usable-tree rate from 90%/100% to
        # 75%/75%. tools/verify-round already excluded these; bench/run did not, and nothing
        # compared the two. That is the same defect shape as tools/check-plan and bench/run once
        # parsing plans with separate copies of the same expressions.
        ':(exclude).handoff/scratch/**'
        ':(exclude).handoff/journal/**'
        ':(exclude).omc/**'
        ':(exclude)storage/logs/**'
        ':(exclude)storage/framework/**'
        ':(exclude)node_modules/**'
        ':(exclude)vendor/**'
    )

    if [[ -s "$before" && -s "$after" ]] &&
        git -C "$tree" cat-file -e "$(cat "$before")^{tree}" 2>/dev/null &&
        git -C "$tree" cat-file -e "$(cat "$after")^{tree}" 2>/dev/null; then
        cp "$before" "$result_dir/tree-before"
        cp "$after" "$result_dir/tree-after"
        git -C "$tree" diff-tree -r -p --binary "$(cat "$before")" "$(cat "$after")" -- \
            . "${excludes[@]}" >"$result_dir/tree.diff"
        git -C "$tree" -c core.quotePath=false diff-tree -r --name-only "$(cat "$before")" "$(cat "$after")" -- \
            . "${excludes[@]}" | sort -u >"$result_dir/tree-files.txt"
        return
    fi

    # A timeout can stop the driver before its after-snapshot. The worktree began clean and the
    # staged plan is known, so this fallback preserves inspectable evidence instead of losing it.
    git -C "$tree" diff --binary "$BASE_COMMIT" -- . \
        ':(exclude).handoff/runs/**' \
        ':(exclude).handoff/scratch/**' \
        ':(exclude).handoff/journal/**' \
        ":(exclude).handoff/plans/$PLAN.md" >"$result_dir/tree.diff"
    {
        git -C "$tree" -c core.quotePath=false diff --name-only "$BASE_COMMIT" -- . \
            ':(exclude).handoff/runs/**' \
            ':(exclude).handoff/scratch/**' \
            ':(exclude).handoff/journal/**' \
            ":(exclude).handoff/plans/$PLAN.md"
        git -C "$tree" -c core.quotePath=false ls-files --others --exclude-standard |
            awk -v plan=".handoff/plans/$PLAN.md" '
                $0 != plan && $0 !~ /^\.handoff\/(runs|scratch|journal)\// { print }
            '
    } | sort -u >"$result_dir/tree-files.txt"

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if git -C "$tree" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
            continue
        fi
        set +e
        ( cd "$tree" && git diff --no-index --binary /dev/null "$file" ) >>"$result_dir/tree.diff"
        local diff_status=$?
        set -e
        [[ "$diff_status" -eq 1 ]] || {
            echo "could not capture untracked file in tree diff: $file" >&2
            return 1
        }
    done <"$result_dir/tree-files.txt"
}

remove_active_worktree() {
    local result_dir="$1" label="$2"
    if ! git -C "$REPO_ROOT" worktree remove --force "$ACTIVE_WORKTREE" \
        >>"$result_dir/worktree.log" 2>&1; then
        echo "could not remove worktree for $label" >&2
        return 1
    fi
    ACTIVE_WORKTREE=""
}

for provider in "${PROVIDER_LIST[@]}"; do
    [[ "$provider" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
        echo "invalid provider name: $provider" >&2
        exit 64
    }

    # Where this provider's numbering starts.
    #
    # Normally 1, because the existence check above guaranteed an empty directory. Under --append
    # it continues from whatever is already there, which is what makes a wave possible: five
    # repetitions of each arm, then five more, so the arms stay balanced at every point in the
    # night rather than only at the end.
    #
    # That matters more than it sounds. Running one arm to n=20 and then the next means a run that
    # stops early — a crash, a deadline, a dead server — leaves one complete arm and nothing to
    # compare it against. Interleaved, the same interruption leaves a usable comparison at
    # whatever n it reached. The statistics are identical; only the failure mode differs.
    REP_START=1
    if (( APPEND )); then
        _highest=0
        for _existing in "$RESULTS_DIR/$provider"/*; do
            _n="${_existing##*/}"
            [[ "$_n" =~ ^[0-9]+$ ]] || continue
            (( _n > _highest )) && _highest="$_n"
        done
        REP_START=$(( _highest + 1 ))
        (( _highest == 0 )) || echo "appending to $PLAN/$provider: $_highest existing, adding $REPEAT"
    fi

    for (( repetition=REP_START; repetition<REP_START+REPEAT; repetition++ )); do
        RESULT_DIR="$RESULTS_DIR/$provider/$repetition"
        mkdir -p "$RESULT_DIR"

        # Initialised here rather than beside the attempt loop, because the preflight and
        # missing-adapter paths below write metrics without ever entering it.
        #
        # ATTEMPTS belongs in this list for exactly the reason the comment gives, and was missing
        # from it. Under `set -u` that turned every early failure into an unbound-variable abort
        # inside write_metrics — so a provider whose preflight failed produced one cryptic line
        # about line 408 and no record of what actually went wrong, which is the worst possible
        # behaviour for a run nobody is watching.
        ATTEMPTS=0
        PROMPT_TOKENS=0
        GENERATED_TOKENS=0
        MODEL_REQUESTS=0
        USAGE_UNATTRIBUTABLE=0
        # A run whose conversation was truncated against the context window is a configuration
        # result, not a model result. One run of round 6 was truncated at 65535 tokens and scored
        # as though it had its whole history; nothing in the harness noticed, and it was found by
        # reading the serving log by hand.
        TRUNCATED_REQUESTS=0
        CONTEXT_OVERFLOWS=0
        PROVIDER_FEEDBACK_DETAIL="$BENCH_FEEDBACK_DETAIL"

        ACTIVE_WORKTREE="$WORK_DIR/$PLAN-$provider-$repetition"
        [[ ! -e "$ACTIVE_WORKTREE" ]] || {
            echo "worktree path already exists: ${ACTIVE_WORKTREE#"$REPO_ROOT"/}" >&2
            exit 1
        }

        if ! git -C "$REPO_ROOT" worktree add --detach "$ACTIVE_WORKTREE" "$BASE_COMMIT" \
            >"$RESULT_DIR/worktree.log" 2>&1; then
            echo "could not create worktree for $PLAN/$provider/$repetition" >&2
            sed -n '1,20p' "$RESULT_DIR/worktree.log" >&2
            exit 1
        fi

        # Preflight comes from the isolated commit, not the control checkout. Otherwise an
        # uncommitted adapter edit could make the availability check disagree with the run.
        PROVIDER_FILE="$ACTIVE_WORKTREE/providers/$provider.sh"
        if [[ ! -f "$PROVIDER_FILE" ]]; then
            printf 'provider adapter not found: providers/%s.sh\n' "$provider" >"$RESULT_DIR/note.txt"
            : >"$RESULT_DIR/preflight.log"
            write_metrics "$RESULT_DIR" skipped 0 0 0 0 null 0 null
            remove_active_worktree "$RESULT_DIR" "$PLAN/$provider/$repetition"
            continue
        fi

        set +e
        ( source "$PROVIDER_FILE"; provider_preflight ) >"$RESULT_DIR/preflight.log" 2>&1
        PREFLIGHT_STATUS=$?
        set -e
        if [[ "$PREFLIGHT_STATUS" -ne 0 ]]; then
            awk 'NF { print; exit }' "$RESULT_DIR/preflight.log" >"$RESULT_DIR/note.txt"
            [[ -s "$RESULT_DIR/note.txt" ]] || echo "provider preflight failed" >"$RESULT_DIR/note.txt"
            write_metrics "$RESULT_DIR" skipped 0 0 0 0 null 0 null
            remove_active_worktree "$RESULT_DIR" "$PLAN/$provider/$repetition"
            continue
        fi

        # An adapter may pin its own feedback level, and that pin wins over the environment.
        #
        # Without this, a provider named for a condition can quietly run under a different one: the
        # A/B arm `lcgptosslfull` would produce `commands` results the moment someone forgot the
        # env var, and the results path would still say `full`. A label that can disagree with the
        # behaviour it names is worse than no label, because it is believed.
        PROVIDER_FEEDBACK_DETAIL="$BENCH_FEEDBACK_DETAIL"
        FEEDBACK_OVERRIDE="$(
            source "$PROVIDER_FILE"
            declare -F provider_feedback_detail >/dev/null && provider_feedback_detail
        )" || FEEDBACK_OVERRIDE=""
        case "$FEEDBACK_OVERRIDE" in
        commands | full) PROVIDER_FEEDBACK_DETAIL="$FEEDBACK_OVERRIDE" ;;
        "") ;;
        *)
            echo "provider $provider requested an unknown feedback level: $FEEDBACK_OVERRIDE" >&2
            exit 64
            ;;
        esac

        # Record the serving stack alongside the result. Optional: adapters that do not define
        # provider_manifest simply produce no file, so this cannot break an existing provider.
        (
            source "$PROVIDER_FILE"
            declare -F provider_manifest >/dev/null || exit 0
            provider_manifest
        ) >"$RESULT_DIR/manifest.json" 2>/dev/null
        [[ -s "$RESULT_DIR/manifest.json" ]] || rm -f "$RESULT_DIR/manifest.json"

        mkdir -p "$ACTIVE_WORKTREE/.handoff/plans"
        cp "$PLAN_FILE" "$ACTIVE_WORKTREE/.handoff/plans/$PLAN.md"

        # Assert the plan is actually readable where the model will look for it, immediately
        # before the run.
        #
        # "The plan file does not exist" is the single most misdiagnosed report in this project:
        # once it was true (a 4,096-token context hid it) and once it was a model asserting it
        # without making a single tool call. Telling those apart after the fact is impossible,
        # because the worktree is removed when the run ends. Checking here means a future
        # "plan not found" can only ever be the model's claim, never the harness's fault.
        [[ -r "$ACTIVE_WORKTREE/.handoff/plans/$PLAN.md" &&
           -s "$ACTIVE_WORKTREE/.handoff/plans/$PLAN.md" ]] || {
            echo "plan was not staged into the worktree for $PLAN/$provider/$repetition" >&2
            exit 1
        }
        RUN_DIR="$ACTIVE_WORKTREE/.handoff/runs/$PLAN"
        STARTED_AT="$(date +%s)"

        # Repair loop. First-pass success is the wrong headline if success within a few attempts
        # is high, and the real target is cost to an accepted patch — so both are measured: the
        # attempt count is recorded whether or not the round ever goes green.
        #
        # The feedback handed back is the harness's own verification output, not the model's
        # opinion of what went wrong. The model's report is the least trustworthy thing available;
        # the list of commands that actually exited non-zero is the most.
        mkdir -p "$RUN_DIR"
        FEEDBACK_FILE="$RUN_DIR/feedback.md"
        rm -f "$FEEDBACK_FILE"
        ATTEMPTS=0
        FIRST_TREE_BEFORE=""
        # Token accounting is summed over every attempt, from the counters zeroed above. A run that
        # needed three attempts cost three attempts' worth of generation, and cost to an accepted
        # patch is the number this project exists to optimise.
        while : ; do
        ATTEMPTS=$(( ATTEMPTS + 1 ))

        USAGE_MARK="$(
            source "$PROVIDER_FILE"
            declare -F provider_usage_mark >/dev/null && provider_usage_mark
        )" || USAGE_MARK=""
        # Sourcing an adapter pulls in its whole chain, and anything on that chain printing to
        # stdout would end up here. A mark that is not a plain number is not a mark.
        [[ "$USAGE_MARK" =~ ^[0-9]+$ ]] || USAGE_MARK=""

        # Run the driver in its own process group and kill the GROUP on timeout.
        #
        # `timeout` signals only the process it launched. The agent CLI is a grandchild, so a
        # timed-out round left it alive: an orphaned Cline from a 30-minute timeout was still
        # running against the deleted worktree while the NEXT repetition ran, both hitting the
        # same GPU model at once. The following runs produced empty diffs and unparseable reports
        # and looked like a model collapsing, when they were competing with a ghost.
        #
        # This is the third variant of the same bug in this harness — an opencode process
        # outliving its parent previously held the bench flock for 600s. Anything that spawns a
        # long-lived child needs the group killed, not the child.
        # The session leader records its own pgid. `$!` here is setsid's pid, not the leader's --
        # setsid forks when it is already a group leader, so killing -$! signals the wrong group
        # and the grandchild survives exactly as before. Verified: the first attempt at this fix
        # still left the child alive, which is why the pgid is read back from the process itself
        # rather than inferred.
        PGID_FILE="$RESULT_DIR/driver.pgid"
        set +e
        # --wait is not optional: without it setsid forks and returns 0 immediately whenever it is
        # already a process-group leader, so the driver detaches, the run records exit 0 before
        # any work happens, and the timeout never applies to anything.
        setsid --wait bash -c '
            echo $$ >"$5"
            cd "$1" || exit 1
            HANDOFF_PROVIDER="$2" HANDOFF_FEEDBACK_FILE="$6" HANDOFF_NO_VERIFY=1 \
                timeout -k 15 "$3" ./bin/handoff do "$4"
        ' _ "$ACTIVE_WORKTREE" "$provider" "$BENCH_TIMEOUT_SECONDS" "$PLAN" "$PGID_FILE" \
            "$FEEDBACK_FILE" >>"$RESULT_DIR/driver.log" 2>&1
        DRIVER_STATUS=$?
        # Sweep whatever the driver left behind. An agent CLI is a grandchild of the driver, so a
        # timed-out round otherwise leaves it running against a worktree that is about to be
        # deleted -- and it then competes with the next repetition for the same GPU model, which
        # reads as the next model collapsing.
        DRIVER_PGID="$(cat "$PGID_FILE" 2>/dev/null)"
        if [[ "$DRIVER_PGID" =~ ^[0-9]+$ ]]; then
            kill -TERM "-$DRIVER_PGID" 2>/dev/null
            sleep 2
            kill -KILL "-$DRIVER_PGID" 2>/dev/null
        fi
        rm -f "$PGID_FILE"
        set -e

        # An adapter with no usage hooks must not leave `prompt_tokens=0` looking like a
        # measurement. Zero tokens and no accounting are different claims.
        if [[ -z "$USAGE_MARK" ]]; then
            USAGE_UNATTRIBUTABLE=1
        else
            ATTEMPT_USAGE="$(
                source "$PROVIDER_FILE"
                declare -F provider_usage_since >/dev/null && provider_usage_since "$USAGE_MARK"
            )" || ATTEMPT_USAGE=""
            # Always yields a number: an empty substitution inside $(( )) is a syntax error, and
            # an adapter that reports nothing must not abort the round.
            usage_field() {
                awk -F= -v k="$1" '$1 == k { print $2 + 0; found = 1 } END { if (!found) print 0 }' \
                    <<<"$ATTEMPT_USAGE"
            }
            if [[ "$(usage_field usage_tokens_unattributable)" == 1 ]]; then
                USAGE_UNATTRIBUTABLE=1
            else
                PROMPT_TOKENS=$(( PROMPT_TOKENS + $(usage_field prompt_tokens) ))
                GENERATED_TOKENS=$(( GENERATED_TOKENS + $(usage_field generated_tokens) ))
                MODEL_REQUESTS=$(( MODEL_REQUESTS + $(usage_field model_requests) ))
                TRUNCATED_REQUESTS=$(( TRUNCATED_REQUESTS + $(usage_field truncated_requests) ))
                CONTEXT_OVERFLOWS=$(( CONTEXT_OVERFLOWS + $(usage_field context_overflows) ))
            fi
        fi

        FINISHED_AT="$(date +%s)"
        ELAPSED=$(( FINISHED_AT - STARTED_AT ))
        printf 'started_epoch=%s\nfinished_epoch=%s\nwall_clock_seconds=%s\n' \
            "$STARTED_AT" "$FINISHED_AT" "$ELAPSED" >"$RESULT_DIR/timing"

        [[ ! -f "$RUN_DIR/result.json" ]] || cp "$RUN_DIR/result.json" "$RESULT_DIR/handoff-report.json"
        [[ ! -f "$RUN_DIR/stdout.log" ]] || cp "$RUN_DIR/stdout.log" "$RESULT_DIR/provider.log"
        [[ ! -f "$RUN_DIR/session-id" ]] || cp "$RUN_DIR/session-id" "$RESULT_DIR/session-id"
        # Per attempt, not once: a repair attempt is sent a different prompt from the first, and
        # the feedback it carries is the variable in half the arms measured here. Overwriting it
        # would leave only the last one, which is the one nobody is asking about.
        [[ ! -f "$RUN_DIR/prompt.md" ]] ||
            cp "$RUN_DIR/prompt.md" "$RESULT_DIR/prompt-attempt-$ATTEMPTS.md"

        # Capture against the tree as it stood before the FIRST attempt, not this one.
        #
        # bin/handoff snapshots tree-before at the start of every invocation, so on a repair
        # attempt the "before" state already contains the previous attempt's work and the captured
        # diff shows only the final increment. One run recorded a 257-byte diff containing nothing
        # but the deletion of a scratch file, while the ~4,500 bytes of real implementation — four
        # files, one of them new — went unrecorded.
        #
        # The scoring itself was unaffected, because the plan's verification commands read the
        # working tree directly. The danger is the gates that read these artifacts: a final attempt
        # that changes nothing because the previous one finished the job would trip the empty-diff
        # gate and be relabelled `false-success`, condemning a correct run as fabrication.
        if [[ -z "$FIRST_TREE_BEFORE" && -s "$RUN_DIR/tree-before" ]]; then
            FIRST_TREE_BEFORE="$(cat "$RUN_DIR/tree-before")"
        elif [[ -n "$FIRST_TREE_BEFORE" ]]; then
            printf '%s\n' "$FIRST_TREE_BEFORE" >"$RUN_DIR/tree-before"
        fi

        capture_tree_artifacts "$ACTIVE_WORKTREE" "$RUN_DIR" "$RESULT_DIR"

        # Accumulate the changed-file list per attempt, inside the loop.
        #
        # A file created in one attempt and deleted in the next nets to zero in the final diff, so
        # anything reading only the end state cannot see it — one run created a scratch `temp.php`
        # and removed it on the retry, leaving no evidence. Littering is worth catching even when
        # the model tidies up after itself, because the next model will not.
        #
        # This must stay inside the loop. Placed after it, the union sees only the last attempt and
        # the transient case is missed — which is exactly how the first version of this check
        # failed its own test.
        cat "$RESULT_DIR/tree-files.txt" >>"$RESULT_DIR/touched-files.txt" 2>/dev/null || true
        [[ ! -s "$RESULT_DIR/touched-files.txt" ]] ||
            sort -u -o "$RESULT_DIR/touched-files.txt" "$RESULT_DIR/touched-files.txt"

        # An empty diff scores zero, before any criterion is evaluated.
        #
        # "The file parses" passes trivially on an unmodified tree, so a run that did nothing at
        # all collected 1/6 rather than 0/6 and sat above the floor in the results table. Devstral
        # scored that way six times out of six while changing zero bytes, three of those runs
        # reporting status: complete with an invented summary. A criterion that a do-nothing run
        # can satisfy is not measuring the model.
        #
        # This is deliberately checked against the captured tree diff rather than the model's
        # report, because the report is the thing least worth trusting here.
        DID_NOTHING=0
        if [[ ! -s "$RESULT_DIR/tree-files.txt" ]]; then
            DID_NOTHING=1
            echo "no file changed; every criterion scored zero" >"$RESULT_DIR/empty-diff.txt"
        fi

        CRITERIA_MET=0
        COMMAND_NUMBER=0
        : >"$RESULT_DIR/verification.log"
        while IFS= read -r command; do
            COMMAND_NUMBER=$(( COMMAND_NUMBER + 1 ))
            printf 'command %s: %s\n' "$COMMAND_NUMBER" "$command" >>"$RESULT_DIR/verification.log"
            set +e
            (
                cd "$ACTIVE_WORKTREE"
                timeout --foreground "$BENCH_VERIFY_TIMEOUT_SECONDS" bash -o pipefail -c "$command"
            ) >>"$RESULT_DIR/verification.log" 2>&1
            COMMAND_STATUS=$?
            set -e
            printf 'exit_code: %s\n\n' "$COMMAND_STATUS" >>"$RESULT_DIR/verification.log"
            [[ "$COMMAND_STATUS" -ne 0 ]] || CRITERIA_MET=$(( CRITERIA_MET + 1 ))
        done <"$VERIFICATION_FILE"
        (( CRITERIA_MET <= CRITERIA_TOTAL )) || CRITERIA_MET="$CRITERIA_TOTAL"
        if [[ "$DID_NOTHING" -eq 1 ]]; then
            printf 'tree unchanged: criteria forced from %s to 0\n' "$CRITERIA_MET" \
                >>"$RESULT_DIR/verification.log"
            CRITERIA_MET=0
        fi

        cp "$RESULT_DIR/verification.log" "$RESULT_DIR/verification-attempt-$ATTEMPTS.log"

        # Green, or out of attempts: stop. Otherwise hand back the failing commands and go again.
        if [[ "$CRITERIA_MET" -eq "$CRITERIA_TOTAL" && "$DID_NOTHING" -eq 0 ]]; then
            break
        fi
        if (( ATTEMPTS >= BENCH_MAX_ATTEMPTS )); then
            break
        fi

        # Rendered by tools/render-feedback rather than here, so that tools/feedback-selftest
        # exercises this exact code path instead of a copy of it.
        BENCH_FEEDBACK_DETAIL="$PROVIDER_FEEDBACK_DETAIL" \
        BENCH_FEEDBACK_OUTPUT_LINES="$BENCH_FEEDBACK_OUTPUT_LINES" \
        BENCH_FEEDBACK_DIFF_BYTES="$BENCH_FEEDBACK_DIFF_BYTES" \
            "$FEEDBACK_RENDERER" \
                "$RESULT_DIR/verification.log" \
                "$RESULT_DIR/tree.diff" \
                "$DID_NOTHING" >"$FEEDBACK_FILE"
        # Preserve exactly what the next attempt was told.
        #
        # Round 7 compared two feedback levels and could not inspect the feedback afterwards: it
        # lived in the worktree, which is deleted when the repetition ends. Diagnosing that round
        # meant re-rendering it from other artifacts and hoping the inputs matched. For an
        # experiment whose independent variable *is* this file, not keeping it was the obvious
        # omission only in hindsight.
        cp "$FEEDBACK_FILE" "$RESULT_DIR/feedback-attempt-$(( ATTEMPTS + 1 )).md" 2>/dev/null || true
        printf '==> attempt %s did not pass; retrying\n' "$ATTEMPTS" >>"$RESULT_DIR/driver.log"
        done

        # Patch-only contract: a tracked file may be modified, never regenerated.
        #
        # The greenfield/edit split recorded earlier is a correlation, and the mechanism behind it
        # matters more than the split. A model that replaces a file loses everything it did not
        # reproduce -- a 421-line service once came back as an 11-line fragment whose code was
        # correct and whose destination was not. That happened to be a parse error, so a syntax
        # gate caught it; a fragment carrying its own class declaration would have been valid PHP
        # and would have deleted 410 working lines silently.
        #
        # opencode cannot prevent this: permission config was measured twice against this exact
        # failure (write=deny, then edit=deny, in a project-level opencode.json) and the file was
        # created both times. So the contract is enforced here, where the harness -- not the model
        # and not the model's report -- decides whether the round stands.
        #
        # Threshold: a tracked file that loses more than half its lines, or whose change rewrites
        # more lines than the file originally had, is treated as regenerated rather than patched.
        REWRITES=0
        : >"$RESULT_DIR/rewrite-violations.txt"
        while IFS= read -r changed; do
            [[ -n "$changed" ]] || continue
            git -C "$ACTIVE_WORKTREE" cat-file -e "$BASE_COMMIT:$changed" 2>/dev/null || continue
            BEFORE_LINES="$(git -C "$ACTIVE_WORKTREE" show "$BASE_COMMIT:$changed" 2>/dev/null | wc -l)"
            [[ "$BEFORE_LINES" -gt 0 ]] || continue
            [[ -f "$ACTIVE_WORKTREE/$changed" ]] && \
                AFTER_LINES="$(wc -l <"$ACTIVE_WORKTREE/$changed")" || AFTER_LINES=0
            REMOVED="$(git -C "$ACTIVE_WORKTREE" diff --numstat "$BASE_COMMIT" -- "$changed" |
                awk '{ print $2 + 0 }')"
            REMOVED="${REMOVED:-0}"
            if (( AFTER_LINES * 2 < BEFORE_LINES )) || (( REMOVED >= BEFORE_LINES )); then
                printf '%s: %s lines -> %s, %s removed (regenerated, not patched)\n' \
                    "$changed" "$BEFORE_LINES" "$AFTER_LINES" "$REMOVED" \
                    >>"$RESULT_DIR/rewrite-violations.txt"
                REWRITES=$(( REWRITES + 1 ))
            fi
        done <"$RESULT_DIR/tree-files.txt"

        # Scope is judged on the union accumulated per attempt, and littering is reported
        # separately from editing a file
        # the plan did not name. They are different mistakes: one leaves rubbish behind, the other
        # changes code that was supposed to be untouched.
        SCOPE_VIOLATIONS=0
        LITTER=0
        : >"$RESULT_DIR/scope-violations.txt"
        : >"$RESULT_DIR/litter.txt"
        while IFS= read -r changed; do
            [[ -n "$changed" ]] || continue
            grep -Fqx -- "$changed" "$ALLOWED_FILE" && continue
            echo "$changed" >>"$RESULT_DIR/scope-violations.txt"
            SCOPE_VIOLATIONS=$(( SCOPE_VIOLATIONS + 1 ))
            # Untracked at the base commit means the agent invented it.
            if ! git -C "$ACTIVE_WORKTREE" cat-file -e "$BASE_COMMIT:$changed" 2>/dev/null; then
                gone=""
                [[ -e "$ACTIVE_WORKTREE/$changed" ]] || gone="  (created then removed)"
                printf '%s%s\n' "$changed" "$gone" >>"$RESULT_DIR/litter.txt"
                LITTER=$(( LITTER + 1 ))
            fi
        done <"$RESULT_DIR/touched-files.txt"

        STATUS=""
        DEVIATIONS=0
        BLOCKERS=0
        : >"$RESULT_DIR/deviations.txt"
        if [[ "$DRIVER_STATUS" -eq 124 ]]; then
            STATUS=timeout
            printf 'run exceeded %s seconds; resume rounds are manual follow-up\n' \
                "$BENCH_TIMEOUT_SECONDS" >"$RESULT_DIR/note.txt"
        elif [[ ! -s "$RESULT_DIR/handoff-report.json" ]]; then
            STATUS=report-missing
            echo "handoff report was not written" >"$RESULT_DIR/note.txt"
        elif ! json_balanced "$RESULT_DIR/handoff-report.json"; then
            STATUS=report-unparseable
            echo "handoff report has unbalanced JSON structure" >"$RESULT_DIR/note.txt"
        elif ! report_has_required_fields "$RESULT_DIR/handoff-report.json"; then
            STATUS=report-unparseable
            echo "handoff report is missing required fields" >"$RESULT_DIR/note.txt"
        else
            STATUS="$(report_status "$RESULT_DIR/handoff-report.json")"
            set +e
            DEVIATIONS="$(json_array_count "$RESULT_DIR/handoff-report.json" deviations)"
            DEVIATION_STATUS=$?
            BLOCKERS="$(json_array_count "$RESULT_DIR/handoff-report.json" blockers)"
            BLOCKER_STATUS=$?
            set -e
            if [[ ! "$STATUS" =~ ^(complete|partial|blocked)$ ||
                  "$DEVIATION_STATUS" -ne 0 || "$BLOCKER_STATUS" -ne 0 ]]; then
                STATUS=report-unparseable
                DEVIATIONS=0
                BLOCKERS=0
                echo "handoff report is missing required metric fields" >"$RESULT_DIR/note.txt"
            else
                set +e
                extract_deviations "$RESULT_DIR/handoff-report.json" >"$RESULT_DIR/deviations.txt"
                EXTRACT_STATUS=$?
                set -e
                if [[ "$EXTRACT_STATUS" -ne 0 ||
                      "$(wc -l <"$RESULT_DIR/deviations.txt" | tr -d ' ')" -ne "$DEVIATIONS" ]]; then
                    STATUS=report-unparseable
                    DEVIATIONS=0
                    BLOCKERS=0
                    : >"$RESULT_DIR/deviations.txt"
                    echo "handoff report deviations could not be read" >"$RESULT_DIR/note.txt"
                fi
            fi
        fi

        # A round is green only when the harness agrees, and the harness reads the tree. The
        # model's own status is one input among several and the least reliable of them: three
        # runs reported complete on a tree they had not touched.
        ROUNDS=null
        if [[ "$STATUS" == complete && "$CRITERIA_MET" -eq "$CRITERIA_TOTAL" &&
              "$SCOPE_VIOLATIONS" -eq 0 && "$BLOCKERS" -eq 0 &&
              "$REWRITES" -eq 0 && "$DID_NOTHING" -eq 0 ]]; then
            ROUNDS="$ATTEMPTS"
        elif [[ ! -f "$RESULT_DIR/note.txt" ]]; then
            echo "resume rounds are a manual follow-up" >"$RESULT_DIR/note.txt"
        fi

        # A report claiming success over an untouched tree is fabrication, and naming it as such
        # in the metrics keeps it out of the "complete" column where it would flatter the model.
        if [[ "$DID_NOTHING" -eq 1 && "$STATUS" == complete ]]; then
            STATUS=false-success
            echo "reported complete having changed nothing" >"$RESULT_DIR/note.txt"
        fi

        # Outcome taxonomy — derived from the tree, never from the report.
        #
        # `status` alone collapses outcomes that are nothing alike. Three runs today produced a
        # byte-perfect tree that satisfied every criterion and were recorded as
        # `report-unparseable`, identical to runs that changed nothing, because the client returned
        # no final message. On a cost-to-accepted-patch basis one of those needs a re-ask and the
        # other needs a human, so flattening them hides the number the project exists to measure.
        #
        #   accepted            every gate passed and the model reported it
        #   patch-ok-no-report  the tree is acceptable; the envelope is missing or malformed
        #   patch-damaged       the tree changed but a gate rejected it
        #   fabricated          claimed success over a tree it never touched
        #   no-op               changed nothing, and said so
        #   protocol-failed     never got far enough to produce a tree to judge
        TREE_OK=0
        if [[ "$DID_NOTHING" -eq 0 && "$CRITERIA_MET" -eq "$CRITERIA_TOTAL" &&
              "$SCOPE_VIOLATIONS" -eq 0 && "$REWRITES" -eq 0 ]]; then
            TREE_OK=1
        fi
        REPORT_OK=0
        [[ "$STATUS" =~ ^(complete|partial|blocked)$ ]] && REPORT_OK=1

        if [[ "$STATUS" == timeout || "$STATUS" == skipped ]]; then
            OUTCOME=protocol-failed
        elif [[ "$STATUS" == false-success ]]; then
            OUTCOME=fabricated
        elif [[ "$DID_NOTHING" -eq 1 ]]; then
            OUTCOME=no-op
        elif [[ "$TREE_OK" -eq 1 && "$REPORT_OK" -eq 1 ]]; then
            OUTCOME=accepted
        elif [[ "$TREE_OK" -eq 1 ]]; then
            OUTCOME=patch-ok-no-report
        else
            OUTCOME=patch-damaged
        fi

        # Produce the evidence bundle while the worktree still exists.
        #
        # This is what a reviewing model reads instead of re-running the work itself: every gate
        # with the command that produced it, its exit code, an excerpt and a digest of the full
        # output — and an explicit list of what was NOT checked. The point is to move verification
        # cost off the hosted model without asking it to trust a summary that could be invented.
        #
        # Known duplication: verify-round re-implements several gates that this script also
        # computes, and two implementations of "is this acceptable" will drift. Scoring stays here
        # for now so the existing results remain comparable; converging them is tracked in
        # docs/local-models.md §9.
        if [[ -x "$ACTIVE_WORKTREE/tools/verify-round" ]]; then
            "$ACTIVE_WORKTREE/tools/verify-round" \
                "$ACTIVE_WORKTREE" \
                "$ACTIVE_WORKTREE/.handoff/plans/$PLAN.md" \
                "$BASE_COMMIT" \
                "$RESULT_DIR/evidence" >"$RESULT_DIR/evidence.log" 2>&1 || true
        fi

        write_metrics "$RESULT_DIR" "$STATUS" "$CRITERIA_MET" "$SCOPE_VIOLATIONS" \
            "$DEVIATIONS" "$BLOCKERS" "$ROUNDS" "$ELAPSED" "$DRIVER_STATUS" \
            "$REWRITES" "$DID_NOTHING" "$LITTER" "$OUTCOME"

        # Kill the writers BEFORE deleting what they are writing to.
        #
        # This used to run after the removal, and a process that outlived it recreated the
        # directory: round 8 left `bench/.work/wide-lcgptosslfix-3/test_order.php` behind — an
        # invented verification script written after `git worktree remove` had already succeeded.
        # The next round with that provider would then refuse to start, because bench/run declines
        # to reuse an existing worktree path.
        #
        # Cline starts a hub daemon per working directory and it outlives the repetition, keeping
        # the model warm and generating into the same server log the next repetition's token
        # accounting reads. Left to accumulate, a fifteen-repetition round ends with fifteen.
        if [[ -n "$GHOST_SWEEP" ]]; then
            "$GHOST_SWEEP" --kill >>"$RESULT_DIR/worktree.log" 2>&1 || true
        fi

        remove_active_worktree "$RESULT_DIR" "$PLAN/$provider/$repetition"

        # Whatever git left, or a straggler recreated. Bounded to the worktree path this repetition
        # owns, so it cannot reach anything else even if the variable were somehow wrong.
        if [[ -n "$WORK_DIR" && -d "$WORK_DIR/$PLAN-$provider-$repetition" ]]; then
            echo "residue after worktree removal:" >>"$RESULT_DIR/worktree.log"
            find "$WORK_DIR/$PLAN-$provider-$repetition" -type f >>"$RESULT_DIR/worktree.log" 2>&1
            rm -rf -- "${WORK_DIR:?}/$PLAN-$provider-$repetition"
        fi
    done
done

echo "benchmark artifacts: ${RESULTS_DIR#"$REPO_ROOT"/}"
