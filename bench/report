#!/usr/bin/env bash
#
# bench/report — render preserved benchmark artifacts as per-run Markdown.
#
# The raw files remain authoritative. Rendering every attempt separately keeps variation visible;
# combining repetitions would hide the behaviour this protocol is meant to expose.

set -euo pipefail

BENCH_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$BENCH_HOME" rev-parse --show-toplevel)"
RESULTS_ROOT="$BENCH_HOME/results"

metric_value() {
    local file="$1" key="$2"
    awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

# Runs recorded before a metric existed have no line for it. Rendering an empty cell would read as
# "zero violations" on a run that was never checked, so those are marked "—" instead.
metric_or_dash() {
    local value
    value="$(metric_value "$1" "$2")"
    printf '%s' "${value:-—}"
}

# Diff size is the measurement the surgical plans exist to take: whether a contained change was
# made without regenerating everything around it. A criteria count cannot express that — two runs
# can both score 2/6 with one patching eight lines and the other replacing the file.
diff_bytes() {
    local run_dir="$1"
    [[ -f "$run_dir/tree.diff" ]] || { printf '—'; return; }
    wc -c <"$run_dir/tree.diff" | tr -d ' '
}

render_report() {
    echo "# Benchmark evidence"
    echo
    echo "Each row is one preserved run under the protocol in bench/METHODOLOGY.md. Raw values are"
    echo "shown individually, and a null rounds_to_green value means resume work requires manual review."

    if [[ ! -d "$RESULTS_ROOT" ]] ||
        ! find "$RESULTS_ROOT" -mindepth 4 -maxdepth 4 -type f -name metrics -print -quit |
            grep -q .; then
        echo
        echo "No run artifacts are available."
        return
    fi

    while IFS= read -r plan_dir; do
        PLAN="${plan_dir##*/}"
        RUN_COUNT="$(find "$plan_dir" -mindepth 3 -maxdepth 3 -type f -name metrics | wc -l | tr -d ' ')"
        [[ "$RUN_COUNT" -gt 0 ]] || continue

        echo
        echo "## $PLAN"
        echo
        if [[ "$RUN_COUNT" -eq 1 ]]; then
            echo "Sample: one run."
        else
            echo "Sample: $RUN_COUNT runs."
        fi
        echo
        echo "| Provider | Run | Outcome | Status | Criteria | Diff bytes | Rewrites | Empty | Litter | Scope violations | Deviations | Blockers | Rounds to green | Seconds | Exit |"
        echo "| --- | ---: | --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |"

        while IFS= read -r metrics; do
            RUN_DIR="${metrics%/metrics}"
            RELATIVE="${RUN_DIR#"$plan_dir"/}"
            PROVIDER="${RELATIVE%%/*}"
            REPETITION="${RELATIVE##*/}"
            STATUS="$(metric_value "$metrics" status)"
            OUTCOME="$(metric_or_dash "$metrics" outcome)"
            CRITERIA_TOTAL="$(metric_value "$metrics" criteria_total)"
            CRITERIA_MET="$(metric_value "$metrics" criteria_met)"
            SCOPE="$(metric_value "$metrics" scope_violations)"
            DEVIATIONS="$(metric_value "$metrics" deviations)"
            BLOCKERS="$(metric_value "$metrics" blockers)"
            ROUNDS="$(metric_value "$metrics" rounds_to_green)"
            SECONDS="$(metric_value "$metrics" wall_clock_seconds)"
            EXIT_CODE="$(metric_value "$metrics" exit_code)"
            REWRITES="$(metric_or_dash "$metrics" rewrite_violations)"
            EMPTY="$(metric_or_dash "$metrics" empty_diff)"
            LITTER="$(metric_or_dash "$metrics" litter)"
            DIFF_BYTES="$(diff_bytes "$RUN_DIR")"

            printf '| %s | %s | %s | %s | %s/%s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n' \
                "$PROVIDER" "$REPETITION" "$OUTCOME" "$STATUS" "$CRITERIA_MET" "$CRITERIA_TOTAL" \
                "$DIFF_BYTES" "$REWRITES" "$EMPTY" "$LITTER" \
                "$SCOPE" "$DEVIATIONS" "$BLOCKERS" "$ROUNDS" "$SECONDS" "$EXIT_CODE"
        done < <(find "$plan_dir" -mindepth 3 -maxdepth 3 -type f -name metrics | sort)

        while IFS= read -r metrics; do
            RUN_DIR="${metrics%/metrics}"
            RELATIVE="${RUN_DIR#"$plan_dir"/}"
            PROVIDER="${RELATIVE%%/*}"
            REPETITION="${RELATIVE##*/}"

            echo
            echo "### $PROVIDER / run $REPETITION"
            echo
            echo "Artifacts: ${RUN_DIR#"$REPO_ROOT"/}/"

            # Provenance, on its own line rather than as more columns.
            #
            # Which harness produced a result was not recorded until a clone drifted from the
            # working checkout and 25 of 61 runs exercised an already-fixed adapter bug without
            # anything noticing. Token counts are here for the same reason the summary charges
            # failures to successes: wall clock alone does not say what a patch cost.
            HARNESS="$(metric_value "$metrics" harness_commit)"
            if [[ -n "$HARNESS" ]]; then
                DIRTY=""
                [[ "$(metric_value "$metrics" harness_dirty)" != 1 ]] || DIRTY=" (uncommitted changes)"
                printf 'Harness: %s%s, feedback %s\n' \
                    "$HARNESS" "$DIRTY" "$(metric_or_dash "$metrics" feedback_detail)"
            fi
            if [[ "$(metric_value "$metrics" usage_unattributable)" == 0 ]]; then
                printf 'Tokens: %s generated, %s prompt, over %s model requests\n' \
                    "$(metric_or_dash "$metrics" generated_tokens)" \
                    "$(metric_or_dash "$metrics" prompt_tokens)" \
                    "$(metric_or_dash "$metrics" model_requests)"
            fi

            if [[ -s "$RUN_DIR/note.txt" ]]; then
                while IFS= read -r note; do
                    printf '> Note: %s\n' "$note"
                done <"$RUN_DIR/note.txt"
            fi

            if [[ -s "$RUN_DIR/deviations.txt" ]]; then
                while IFS= read -r deviation; do
                    printf '> Reported deviation: "%s"\n' "$deviation"
                done <"$RUN_DIR/deviations.txt"
            fi

            if [[ -s "$RUN_DIR/litter.txt" ]]; then
                echo
                echo "Files the agent invented that the plan never named:"
                while IFS= read -r junk; do
                    printf -- '- `%s`\n' "$junk"
                done <"$RUN_DIR/litter.txt"
            fi

            if [[ -s "$RUN_DIR/rewrite-violations.txt" ]]; then
                echo
                echo "Regenerated rather than patched:"
                while IFS= read -r violation; do
                    printf -- '- %s\n' "$violation"
                done <"$RUN_DIR/rewrite-violations.txt"
            fi

            if [[ -s "$RUN_DIR/empty-diff.txt" ]]; then
                while IFS= read -r line; do
                    printf '> %s\n' "$line"
                done <"$RUN_DIR/empty-diff.txt"
            fi

            if [[ -s "$RUN_DIR/scope-violations.txt" ]]; then
                echo
                echo "Files outside the plan's table:"
                while IFS= read -r path; do
                    printf -- '- `%s`\n' "$path"
                done <"$RUN_DIR/scope-violations.txt"
            fi
        done < <(find "$plan_dir" -mindepth 3 -maxdepth 3 -type f -name metrics | sort)
    done < <(find "$RESULTS_ROOT" -mindepth 1 -maxdepth 1 -type d | sort)
}

# Render before writing stdout so a short reader cannot interrupt the traversal and produce a
# misleading partial diagnostic. The final stream is a plain file read and is safe to truncate.
REPORT_FILE="$(mktemp)"
trap 'rm -f "$REPORT_FILE"' EXIT
render_report >"$REPORT_FILE"
cat "$REPORT_FILE"
