#!/usr/bin/env python3
"""site-audit-selftest — every gate, against a page built to trip it.

    bench/checks/site-audit-selftest

A gate nobody has watched fail is an assumption. The reference page passes all nine, which proves
only that they can say yes; each case below breaks exactly one thing and asserts that the matching
gate says no AND that the others still say yes. That second half is what catches a gate so broad it
fires on everything, which is how a check becomes noise and then gets switched off.

The mutations are drawn from what a model plausibly does, not from what is easy to detect:
an anchor off by one character, a heading level swapped, a stat label moved away from its figure.
"""

from __future__ import annotations

import pathlib
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
AUDIT = HERE / "site-audit"
REFERENCE = HERE / "site-cases" / "reference" / "index.html"
DARK_REFERENCE = HERE / "site-cases" / "dark-reference" / "index.html"

# Gates that apply to the light page. `darkscheme` is deliberately not here: the light reference
# has no dark block, so scoring it there would assert a failure as though it were the design.
GATES = ["headline", "sections", "anchors", "stats", "features", "testimonials",
         "alt", "meta", "selfcontained"]
DARK_GATES = ["darkscheme"]


def registered_gates() -> list[str]:
    """The gate names site-audit actually offers.

    Read from the tool rather than restated here. The first version of this file kept its own
    list, so adding a gate to site-audit gave it no coverage and said nothing -- the same shape as
    tools/selftest-all resolving only one directory and printing SKIP over a suite that existed.
    """
    import importlib.machinery
    import importlib.util
    spec = importlib.util.spec_from_loader("site_audit",
                                           importlib.machinery.SourceFileLoader("site_audit", str(AUDIT)))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return sorted(module.GATES)

# (name, gate that must fail, mutation as a (find, replace) pair)
CASES = [
    ("an anchor off by one character", "anchors",
     ('<a href="#features">Funcționalități</a>', '<a href="#feature">Funcționalități</a>')),

    ("a landmark id renamed", "sections",
     ('<section id="testimonials">', '<section id="reviews">')),

    ("two landmarks swapped", "sections",
     ('<section id="features">', '<section id="cta">')),

    ("the headline reworded", "headline",
     ("Transformă-ți Protecția Muncii în Era Digitală",
      "Transformă-ți Protecția Muncii în Era Digitala")),

    ("a second h1", "headline",
     ("<h2>Funcționalități</h2>", "<h1>Funcționalități</h1>")),

    ("a stat figure dropped", "stats",
     ('<div class="figure">80,000+</div>', '<div class="figure"></div>')),

    ("a feature card gutted to a stub", "features",
     ("<p>Bibliotecă completă cu modele pentru toate nevoile SSM, disponibile gratuit.</p>",
      "<p>TODO</p>")),

    ("two feature cards share a heading", "features",
     ("<h3>Semnare prin SMS</h3>", "<h3>Modele de Documente</h3>")),

    ("a testimonial loses its attribution", "testimonials",
     ("<cite>Andrei Ionescu, Administrator, Construct Plus SRL</cite>", "")),

    ("an image with no alt", "alt",
     ('<a class="wordmark" href="#hero">SSMatic</a>',
      '<a class="wordmark" href="#hero"><img src="logo.png"></a>')),

    ("an unlabelled inline svg", "alt",
     ('<a class="wordmark" href="#hero">SSMatic</a>',
      '<a class="wordmark" href="#hero"><svg viewBox="0 0 10 10"></svg></a>')),

    ("the wrong language", "meta",
     ('<html lang="ro">', '<html lang="en">')),

    ("a meta description trimmed too short", "meta",
     ("Platformă SSM pentru digitalizarea completă a proceselor de protecția muncii: "
      "generare automată de fișe și semnătură electronică.", "Platformă SSM.")),

    ("a CDN stylesheet", "selfcontained",
     ("<style>", '<link rel="stylesheet" href="https://cdn.example.com/x.css">\n<style>')),

    ("a remote image", "selfcontained",
     ('<a class="wordmark" href="#hero">SSMatic</a>',
      '<a class="wordmark" href="#hero"><img alt="SSMatic" src="//cdn.example.com/l.png"></a>')),
]


def score(path: pathlib.Path, gates: list[str] | None = None) -> dict[str, bool]:
    out = {}
    for gate in (gates or GATES):
        proc = subprocess.run([sys.executable, str(AUDIT), gate, str(path)],
                              capture_output=True, text=True)
        out[gate] = proc.returncode == 0
    return out


def main() -> int:
    if not REFERENCE.is_file():
        print(f"reference page missing: {REFERENCE}", file=sys.stderr)
        return 2
    source = REFERENCE.read_text()

    failures = 0
    # Every registered gate must be exercised somewhere. A gate with no case is an assumption
    # wearing a test's clothes, and the failure is silent -- which is the whole reason this check
    # reads the registry instead of trusting the list above.
    covered = set(GATES) | set(DARK_GATES)
    missing = [g for g in registered_gates() if g not in covered]
    if missing:
        print(f"FAIL  {len(missing)} registered gate(s) have no case here: {', '.join(missing)}")
        failures += 1

    with tempfile.TemporaryDirectory() as tmp:
        page = pathlib.Path(tmp) / "index.html"

        page.write_text(source)
        base = score(page)
        if not all(base.values()):
            print(f"FAIL  the reference page does not pass every gate: "
                  f"{[g for g, ok in base.items() if not ok]}")
            return 1
        print(f"pass  the reference page passes all {len(GATES)} gates")

        for name, expected_gate, (find, replace) in CASES:
            if find not in source:
                print(f"FAIL  {name}\n        the mutation's anchor text is not in the reference "
                      f"page, so this case tests nothing: {find[:60]!r}")
                failures += 1
                continue
            page.write_text(source.replace(find, replace, 1))
            got = score(page)
            broke = [gate for gate, ok in got.items() if not ok]
            if expected_gate not in broke:
                print(f"FAIL  {name}\n        expected `{expected_gate}` to fail; "
                      f"gates that failed: {broke or 'none'}")
                failures += 1
            elif len(broke) > 1:
                # Not automatically wrong -- one mutation can genuinely break two things -- but it
                # must be declared, or a gate that fires on everything looks like a gate that works.
                extra = [g for g in broke if g != expected_gate]
                print(f"pass  {name}  (also tripped {', '.join(extra)})")
            else:
                print(f"pass  {name}")

        # --- the dark scheme, against the page that has one -----------------------------------
        if not DARK_REFERENCE.is_file():
            print(f"FAIL  dark reference missing: {DARK_REFERENCE}")
            failures += 1
        else:
            dark_source = DARK_REFERENCE.read_text()
            page.write_text(dark_source)
            if not all(score(page, DARK_GATES).values()):
                print("FAIL  the dark reference does not pass the dark gates")
                failures += 1
            else:
                print("pass  the dark reference passes the dark gates")

            for name, find, replace in [
                ("a dark block that forgets one text colour",
                 "    .stat .label { color: #c9d1d9; }\n", ""),
                ("no dark block at all",
                 "@media (prefers-color-scheme: dark) {", "@media (min-width: 1px) {"),

            ]:
                if find not in dark_source:
                    print(f"FAIL  {name}\n        anchor text absent, so this case tests nothing")
                    failures += 1
                    continue
                page.write_text(dark_source.replace(find, replace, 1))
                if score(page, DARK_GATES)["darkscheme"]:
                    print(f"FAIL  {name}\n        darkscheme passed a page it should reject")
                    failures += 1
                else:
                    print(f"pass  {name}")

        # Standalone pages, because these edges cannot be reached by mutating the reference:
        # emptying its light sheet means deleting twenty-odd rules, not replacing one.
        for name, html, should_pass in [
            ("a light sheet that colours nothing",
             "<html><head><style>@media (prefers-color-scheme: dark)"
             "{body{color:#fff;background:#000}}</style></head><body><p>x</p></body></html>",
             False),
            # From the first live site-dark run: the gate reported six selectors missing from a
            # dark block that defined all six, because the light sheet was commented and the dark
            # block was not. A harness fault charged to the model.
            ("a commented light sheet against an uncommented dark block",
             "<html><head><style>/* Links */ a{color:#d9232d}"
             "/* Body */ body{color:#556270;background:#ffffff}"
             "@media (prefers-color-scheme: dark){a{color:#ff6b6b}"
             "body{color:#c9d1d9;background:#1e1e1e}}</style></head><body>"
             "<p>x</p><a href=\"#x\">y</a></body></html>",
             True),
            ("a dark block nested inside @supports",
             "<html><head><style>body{color:#556270;background:#ffffff}"
             "@media (prefers-color-scheme: dark){@supports (display:grid)"
             "{body{color:#c9d1d9;background:#1e1e1e}}}</style></head><body><p>x</p></body></html>",
             True),
        ]:
            page.write_text(html)
            got = score(page, DARK_GATES)["darkscheme"]
            if got != should_pass:
                print(f"FAIL  {name}\n        darkscheme "
                      f"{'passed' if got else 'rejected'} a page it should "
                      f"{'reject' if should_pass is False else 'accept'}")
                failures += 1
            else:
                print(f"pass  {name}")

    print()
    if failures:
        print(f"{failures} check(s) failed")
        return 1
    print(f"{len(CASES)} check(s) passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
