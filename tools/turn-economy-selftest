#!/usr/bin/env python3
"""turn-economy-selftest — the redundancy counters, against a log built to trip them.

    tools/turn-economy-selftest

tools/turn-economy shipped two defects in its first hour, and both produced a confident number
rather than an error:

  * `search`'s `path` argument names a directory to search under. Counting it as a file read made
    two searches of the same directory look like a repeated read, and put the re-read rate at
    24.6% of all calls with one run at 45%.
  * `run_commands` arguments were truncated in the log, so 15 of 28 were unreadable. The tool
    reported "0 repeated commands" over a denominator of 13 and printed it as 0.0% of 203 calls.

Both are the same shape: a rate whose denominator was not what the label said. So every case here
asserts a count AND the denominator it was counted over.
"""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
TOOL = HERE / "turn-economy"


def call(name: str, args: dict, ok: bool = True, query: str | None = None) -> str:
    """One tool call, in the shape tools/native-agent writes.

    `query` defaults to the JSON of `args`; pass a truncated string to model an old log.
    """
    output = {"query": json.dumps(args) if query is None else query,
              "result": "ok" if ok else "error: nope", "success": ok}
    event = {"type": "content_end", "contentType": "tool", "toolName": name,
             "toolCallId": "x", "output": output}
    # `args` is a sibling of `output`, not a member of it -- `output` is the tool's RESULT in
    # Cline's shape and these are its inputs. The first version of this fixture put it inside
    # `output`, matching what tools/turn-economy read but not what tools/native-agent writes, so
    # every case passed against a format nothing produces. Verified against a real provider.log.
    if query is None:
        event["args"] = args
    return json.dumps({"type": "agent_event", "event": event})


CASES = [
    ("a file read twice with no edit between is a re-read", [
        call("read_files", {"paths": ["a.php"]}),
        call("read_files", {"paths": ["a.php"]}),
    ], {"re_reads": 1, "readable_read": 2}),

    ("a file read again AFTER an edit is not a re-read", [
        call("read_files", {"paths": ["a.php"]}),
        call("write_file", {"path": "a.php"}),
        call("read_files", {"paths": ["a.php"]}),
    ], {"re_reads": 0, "readable_read": 2}),

    # The first defect. Two searches under one directory must not read as a repeated file read,
    # and two identical searches must be caught as repeated searches instead.
    ("two searches of one directory are not a re-read", [
        call("search", {"query": "convertTo", "path": "src"}),
        call("search", {"query": "rateFor", "path": "src"}),
    ], {"re_reads": 0, "readable_read": 0, "re_searches": 0, "readable_search": 2}),

    ("the same search twice is a repeat", [
        call("search", {"query": "convertTo", "path": "src"}),
        call("search", {"query": "convertTo", "path": "src"}),
    ], {"re_searches": 1, "readable_search": 2}),

    ("the same command twice is a re-run", [
        call("run_commands", {"commands": ["php -l a.php"]}),
        call("run_commands", {"commands": ["php -l a.php"]}),
    ], {"re_runs": 1, "readable_verify": 2}),

    # The second defect. An unreadable argument must leave the denominator, not the numerator:
    # one readable command call and one truncated one is 0/1, never 0/2.
    ("a truncated argument leaves the denominator", [
        call("run_commands", {"commands": ["php -l a.php"]}, query='{"commands": ["php -l a.p'),
        call("run_commands", {"commands": ["php -l b.php"]}),
    ], {"re_runs": 0, "readable_verify": 1, "unparseable": 1}),

    ("a failed edit is counted and does not reset the read memory", [
        call("read_files", {"paths": ["a.php"]}),
        call("replace_in_file", {"path": "a.php"}, ok=False),
        call("read_files", {"paths": ["a.php"]}),
    ], {"failed_edits": 1, "re_reads": 1}),

    ("phases split on the first and last successful edit", [
        call("read_files", {"paths": ["a.php"]}),
        call("search", {"query": "x"}),
        call("write_file", {"path": "a.php"}),
        call("write_file", {"path": "b.php"}),
        call("run_commands", {"commands": ["php -l a.php"]}),
    ], {"prologue": 2, "work": 2, "epilogue": 1}),
]


def main() -> int:
    if not TOOL.exists():
        print("turn-economy not found", file=sys.stderr)
        return 2

    failures = 0
    with tempfile.TemporaryDirectory() as tmp:
        for index, (name, lines, expected) in enumerate(CASES):
            run = pathlib.Path(tmp) / f"case{index}"
            run.mkdir()
            (run / "provider.log").write_text("\n".join(lines) + "\n")
            (run / "metrics").write_text("outcome=accepted\n")
            proc = subprocess.run([sys.executable, str(TOOL), "--json", str(run)],
                                  capture_output=True, text=True)
            if proc.returncode != 0:
                print(f"FAIL  {name}\n        exit {proc.returncode}: {proc.stderr[-200:]}")
                failures += 1
                continue
            got = json.loads(proc.stdout)[0]
            wrong = {k: (got.get(k), v) for k, v in expected.items() if got.get(k) != v}
            if wrong:
                print(f"FAIL  {name}")
                for key, (actual, want) in wrong.items():
                    print(f"        {key}: got {actual}, expected {want}")
                failures += 1
            else:
                print(f"pass  {name}")

    print()
    if failures:
        print(f"{failures} check(s) failed")
        return 1
    print(f"{len(CASES)} check(s) passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
