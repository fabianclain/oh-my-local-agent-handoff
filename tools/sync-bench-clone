#!/usr/bin/env bash
#
# sync-bench-clone — copy the working harness into the clone the benchmarks run from.
#
#   tools/sync-bench-clone <clone-path>
#
# Benchmarks run from a clone rather than the working checkout, for two reasons. Each attempt runs
# in a `git worktree` created from HEAD, so the harness a run uses is the *committed* one — and the
# working checkout must stay uncommitted for review. The clone is where harness changes can be
# committed without touching the branch under review.
#
# Refuses while a benchmark is running. bash reads a script incrementally as it executes, so
# overwriting bench/run underneath a live round can make it resume in the middle of a statement it
# never started.

set -euo pipefail

CLONE="${1:?usage: sync-bench-clone <clone-path>}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE="$(git -C "$HERE" rev-parse --show-toplevel)"

[[ -d "$CLONE/.git" ]] || { echo "not a git repository: $CLONE" >&2; exit 1; }

# The GPU lock, which is the one bench/run and bin/handoff both take. It was
# agent-handoff-bench.lock until the two were unified, and this line was not moved with them -- so
# for a day this refusal checked a file nobody locked and therefore always allowed the sync. A
# guard that cannot fail is worse than no guard; tools/selftest-all now asserts these agree.
if ! flock -n "${TMPDIR:-/tmp}/agent-handoff-gpu.lock" true 2>/dev/null; then
    echo "a benchmark is running; syncing now could corrupt it mid-round" >&2
    exit 1
fi

# Results, archives and worktrees belong to the clone and must survive. Everything else comes from
# source.
#
# bench/archive/ was missing from this list, and `--delete` means missing is fatal rather than
# merely incomplete. On 2026-08-11 a wave of results was moved to bench/archive/ to preserve it,
# the queue's own sync-clone job ran eleven minutes later, and the archive was deleted — after
# bench/run had just been changed to archive rather than delete on --force, specifically so that
# baselines would stop being destroyed. One tool was made careful and the other still swept up
# behind it.
rsync -a --delete \
    --exclude '.git/' \
    --exclude 'bench/results/' \
    --exclude 'bench/archive/' \
    --exclude 'bench/.work/' \
    --exclude '.handoff/runs/' \
    "$SOURCE"/ "$CLONE"/

cd "$CLONE"
if git diff --quiet && git diff --cached --quiet && [[ -z "$(git status --porcelain)" ]]; then
    echo "clone already matches the working harness"
    exit 0
fi

git add -A
git -c user.email=bench@example.invalid -c user.name=bench \
    commit --quiet -m "harness under test: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "clone synced and committed at $(git rev-parse --short HEAD)"
