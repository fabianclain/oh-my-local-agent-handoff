#!/usr/bin/env bash
#
# verify-round — decide whether a round is acceptable, from the tree, and prove it.
#
#   tools/verify-round <worktree> <plan.md> <base-commit> [out-dir]
#
# The implementer's report is not evidence. Three runs in this project reported `status: complete`
# over a tree they had never touched, one with invented file paths; another claimed a migration ran
# when the file was a single line of literal \n characters. So nothing here reads the report. Every
# claim below is produced by running a command and recording what it actually returned.
#
# What it exists to prevent, in order of how badly each has burned us:
#
#   1. fabricated success  — the report says done, the tree says otherwise
#   2. plausible-but-wrong — code that parses and computes the wrong number
#   3. collateral damage   — a correct change that quietly breaks an untouched region
#   4. littering           — files the plan never named, including ones cleaned up afterwards
#   5. silent non-coverage — a check that was never run being read as a check that passed
#
# The last one is why every gate reports `skipped` explicitly rather than being omitted. A verifier
# that quietly runs fewer checks than you think is worse than no verifier, because it converts
# absence of evidence into apparent evidence of absence.
#
# Output: <out-dir>/evidence.json (machine) and <out-dir>/evidence.md (for a reviewing model).
# Exit status is 0 only when every executed gate passed and none were inconclusive.

set -uo pipefail

WORKTREE="${1:?usage: verify-round <worktree> <plan.md> <base-commit> [out-dir]}"
PLAN_FILE="${2:?plan file required}"
BASE_COMMIT="${3:?base commit required}"
OUT_DIR="${4:-$WORKTREE/.handoff/evidence}"
# Optional git tree object captured before the run. Without it an untracked file has no baseline
# to compare against, and the read-only gate can only say "it exists now", which is not the
# question. A reviewer-written test is usually untracked, and reporting it as modified renders as
# "the model tampered with its judge" — which it had not.
RUN_START_TREE="${5:-}"

# The verifier must not appear in its own results.
#
# Writing evidence into the worktree makes those files show up as changed, so the scope gate
# reports them as invented and the plan's own "exactly N files changed" command counts them. The
# first run of this tool rejected a correct solution for exactly that reason.
#
# .handoff is safe because plans already exclude it from their file counts; anywhere else inside
# the worktree is not, and is refused rather than silently skewing the result.
#
# Checked before anything is created. An earlier version made the directory first and refused
# afterwards, so the rejected run left an evidence file behind that the *next* run then reported
# as an invented file. A guard that has already caused the side effect it guards against is not
# a guard.
WORKTREE_ABS="$(cd "$WORKTREE" && pwd)"
OUT_ABS="$(cd "$(dirname "$OUT_DIR")" && pwd)/$(basename "$OUT_DIR")"
OUT_REL=""
case "$OUT_ABS/" in
"$WORKTREE_ABS/"*)
    OUT_REL="${OUT_ABS#"$WORKTREE_ABS"/}"
    case "$OUT_REL" in
    .handoff/*) ;;
    *)
        echo "refusing to write evidence to '$OUT_REL' inside the worktree." >&2
        echo "It would be counted as a change by the very gates it is meant to report." >&2
        echo "Use a path outside the worktree, or under .handoff/." >&2
        exit 2
        ;;
    esac
    ;;
esac

mkdir -p "$OUT_DIR"
EVIDENCE="$OUT_DIR/evidence.jsonl"
: >"$EVIDENCE"

# Record one gate. Output is captured in full to disk and excerpted here: a reviewer needs enough
# to judge without being handed a megabyte of test log, and the full text stays on disk for when
# the excerpt is not enough.
record() {
    local gate="$1" status="$2" detail="$3" command="${4:-}" output_file="${5:-}"
    python3 - "$gate" "$status" "$detail" "$command" "$output_file" "$EVIDENCE" <<'PY'
import hashlib, json, sys
gate, status, detail, command, output_file, evidence = sys.argv[1:7]
excerpt = digest = None
if output_file:
    try:
        raw = open(output_file, "rb").read()
        digest = "sha256:" + hashlib.sha256(raw).hexdigest()[:16]
        text = raw.decode("utf-8", "replace").strip()
        excerpt = text if len(text) <= 600 else text[:300] + "\n…\n" + text[-300:]
    except Exception:
        pass
with open(evidence, "a") as handle:
    handle.write(json.dumps({
        "gate": gate, "status": status, "detail": detail,
        "command": command or None, "output_excerpt": excerpt, "output_sha256": digest,
    }) + "\n")
PY
}

cd "$WORKTREE" || { echo "worktree not found: $WORKTREE" >&2; exit 2; }

# --- what changed, including anything created and then removed ------------------------------
CHANGED="$OUT_DIR/changed-files.txt"
# Harness-owned paths only. The driver stages the plan into .handoff/plans and writes its own
# bookkeeping under .handoff/runs, so counting those as the model's work blames it for the
# harness's footprint — which is how this project has misjudged models repeatedly.
#
# Deliberately NOT excluding .handoff wholesale: a model once wrote three verification scripts
# straight into .handoff/, and that is real littering that must still be caught.
EXCLUDES=(
    ':(exclude).handoff/runs/**'
    ':(exclude).handoff/evidence/**'
    ':(exclude).handoff/plans/**'
    # Harness territory, not the implementer's work. The driver reads it and the setup guide tells
    # the user to write it; a plan has no reason to name it.
    ':(exclude).handoff/config.sh'
    # The run journal — the harness's own records of previous rounds. Counting these as the
    # implementer's work fails every verification after the first, which is exactly what happened
    # the first time the journal was wired in.
    ':(exclude).handoff/journal/**'
    # The sanctioned scratch directory. Two of seven rounds in one real feature left scratch files
    # behind, in rounds whose prose explicitly forbade them, and both were the model wanting to
    # inspect a value with no legitimate way to do it. One of those scripts booted the whole
    # application against the live database, which is also the most plausible cause of the database
    # corruption that session. Prose has now failed at this twice; a permitted place to work is
    # more likely to be used than a prohibition is to be obeyed, and it keeps the mess somewhere
    # the round is not judged on and `handoff init` already ignores.
    ':(exclude).handoff/scratch/**'
    # Not the implementer's work, and blaming it for these is a false rejection. The first
    # end-to-end run of `handoff do` in a fresh project was rejected for three "invented" files
    # that were the agent framework's own state directory. bench/run had excluded these for
    # months; verify-round had not, and the two disagreeing is exactly the drift that keeps
    # costing this project findings.
    ':(exclude).omc/**'
    ':(exclude).claude/**'
    ':(exclude)node_modules/**'
    ':(exclude)vendor/**'
    ':(exclude)storage/logs/**'
    ':(exclude)storage/framework/**'
)
[[ -z "$OUT_REL" ]] || EXCLUDES+=(":(exclude)$OUT_REL/**")

# Also exclude any *other* verifier output already in the tree.
#
# The excludes above cover this run's out-dir and the two standard locations. A bundle left by an
# earlier run at a different path is not covered, and the scope gate then reports it as a file the
# model invented — a verifier failing a round because it had run before. The standard callers
# (`handoff verify`, `bench/run`) write under .handoff/runs, so this only bites a custom out-dir,
# which is exactly the case a person debugging by hand will hit.
#
# Detected by the marker file rather than by name, so it holds whatever the directory is called.
while IFS= read -r marker; do
    [[ -n "$marker" ]] || continue
    EXCLUDES+=(":(exclude)$(dirname "${marker#./}")/**")
done < <(cd "$WORKTREE" && find .handoff -name evidence.jsonl -maxdepth 4 2>/dev/null)
{
# -c core.quotePath=false, on every command whose OUTPUT is a path.
#
# git quotes non-ASCII bytes as octal escapes and wraps the path in double quotes, so a file named
# ⚡rankings.blade.php comes back as "resources/views/pages/\342\232\241rankings.blade.php" and
# matches nothing in the plan's Files-to-touch list. Reported from real use: every Livewire page in
# that project is named ⚡*.blade.php, so any UI plan had its own new view reported as invented.
#
# This does not make the output fully safe — a path containing a space or a newline is still
# quoted — but those cannot be expressed in the plan's table either, so they are a separate
# problem. Non-ASCII filenames are ordinary and were silently broken.
    git -c core.quotePath=false diff --name-only "$BASE_COMMIT" -- . "${EXCLUDES[@]}"
    git -c core.quotePath=false ls-files --others --exclude-standard -- . "${EXCLUDES[@]}"
} 2>/dev/null | sort -u >"$CHANGED"

# Files that were already untracked when the run started are not the model's work — unless the
# model CHANGED them.
#
# `git ls-files --others` above lists every untracked path in the tree with no idea who created it,
# so anything a person left lying about was reported as invented and counted toward patch-damaged.
# Six unrelated files in one real round did exactly that. bin/handoff records the baseline before
# the provider runs; without it this is a no-op, which is correct for bench/run, whose worktrees are
# cut fresh from a commit and have nothing untracked to begin with.
#
# Presence, though, is the wrong question — and answering it cost a round in the other direction.
# The first version subtracted a pre-existing untracked path unconditionally, so a file that was
# untracked before and after read as unchanged however much it was edited. That is the ordinary
# state mid-sequence: the plan creates a view in round 1, round 1b edits it, and nothing has been
# committed in between because the procedure says to review before committing. The round that
# rewrote that file was reported as "the working tree is unchanged; nothing was implemented" — and
# the advice for that signature is to re-run the plan rather than change it, which would have thrown
# away correct work. Two pieces of the harness's own guidance collided.
#
# So the subtraction is by CONTENT, against the run-start snapshot bin/handoff already captures for
# the read-only gate. Same file, same bytes: not this run's doing. Different bytes: the model's
# work, whoever created it. With no snapshot there is nothing to compare against, and the forgiving
# answer is kept — a false accusation is the worse error, and it is the one that was reported.
PREEXISTING_EDITED="$OUT_DIR/preexisting-edited.txt"
: >"$PREEXISTING_EDITED"
if [[ -n "${HANDOFF_UNTRACKED_BEFORE:-}" && -s "${HANDOFF_UNTRACKED_BEFORE:-}" ]]; then
    PREEXISTING="$(mktemp)"
    sort -u "$HANDOFF_UNTRACKED_BEFORE" >"$PREEXISTING"
    KEPT="$(mktemp)"; : >"$KEPT"
    IGNORED=0
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if ! grep -Fqx -- "$file" "$PREEXISTING"; then
            printf '%s\n' "$file" >>"$KEPT"
            continue
        fi
        BASELINE=""
        if [[ -n "$RUN_START_TREE" ]] && git cat-file -e "$RUN_START_TREE:$file" 2>/dev/null; then
            BASELINE="$(git rev-parse "$RUN_START_TREE:$file")"
        fi
        if [[ -z "$BASELINE" ]]; then
            # Untracked before, and no snapshot to compare against. Nothing here can tell an edit
            # from a file that was simply lying about, so keep the answer that does not accuse.
            IGNORED=$(( IGNORED + 1 ))
            continue
        fi
        if [[ -f "$WORKTREE/$file" && "$(git hash-object -- "$WORKTREE/$file")" == "$BASELINE" ]]; then
            IGNORED=$(( IGNORED + 1 ))
            continue
        fi
        printf '%s\n' "$file" >>"$KEPT"
        printf '%s\n' "$file" >>"$PREEXISTING_EDITED"
    done <"$CHANGED"
    mv "$KEPT" "$CHANGED"
    rm -f "$PREEXISTING"
    (( IGNORED == 0 )) || echo "note: $IGNORED file(s) were already untracked before this run and came back unchanged; they are not counted against it" >&2
    EDITED_COUNT="$(grep -c . "$PREEXISTING_EDITED" 2>/dev/null || echo 0)"
    (( EDITED_COUNT == 0 )) || echo "note: $EDITED_COUNT untracked file(s) that existed before this run were modified by it, and ARE counted" >&2
fi

if [[ ! -s "$CHANGED" ]]; then
    record "tree-changed" "fail" "the working tree is unchanged; nothing was implemented"
else
    record "tree-changed" "pass" "$(wc -l <"$CHANGED" | tr -d ' ') file(s) changed"
fi

# --- syntax ---------------------------------------------------------------------------------
if command -v php >/dev/null 2>&1; then
    SYNTAX_OUT="$OUT_DIR/syntax.log"; : >"$SYNTAX_OUT"; SYNTAX_BAD=0
    while IFS= read -r file; do
        [[ "$file" == *.php && -f "$file" ]] || continue
        php -l "$file" >>"$SYNTAX_OUT" 2>&1 || SYNTAX_BAD=$(( SYNTAX_BAD + 1 ))
    done <"$CHANGED"
    if [[ "$SYNTAX_BAD" -gt 0 ]]; then
        record "syntax" "fail" "$SYNTAX_BAD changed PHP file(s) do not parse" "php -l" "$SYNTAX_OUT"
    else
        record "syntax" "pass" "every changed PHP file parses" "php -l" "$SYNTAX_OUT"
    fi
else
    record "syntax" "skipped" "php not on PATH"
fi

# --- the plan's own acceptance commands -------------------------------------------------------
VERIFY_CMDS="$OUT_DIR/commands.txt"
awk '
    /^## Verification([[:space:]]+commands)?[[:space:]]*$/ { in_section=1; next }
    in_section && /^```/ { if (in_block) exit; in_block=1; next }
    in_block && NF { print }
' "$PLAN_FILE" >"$VERIFY_CMDS"

if [[ -s "$VERIFY_CMDS" ]]; then
    IDX=0; PASSED=0; TOTAL=0
    while IFS= read -r command; do
        IDX=$(( IDX + 1 )); TOTAL=$(( TOTAL + 1 ))
        OUT="$OUT_DIR/acceptance-$IDX.log"
        # Colour OFF for everything an acceptance command runs.
        #
        # A criterion of the shape `artisan test | grep -qE 'Tests:[^0-9]*77 passed'` could never
        # pass over ANY tree, because artisan colours its output and the escape sequences between
        # `Tests:` and the number CONTAIN DIGITS:
        #
        #     ^[[90mTests:^[[39m    ^[[32;1m77 passed^[[39;22m
        #
        # so `[^0-9]*` cannot span them. The tree was perfect and the criterion was unsatisfiable,
        # which is indistinguishable from a broken implementation until someone reads the raw log.
        # Reported from real use, and it cost a round.
        #
        # NO_COLOR is the cross-tool convention and Symfony Console — so every artisan command —
        # honours it, as do ripgrep, pytest, cargo, npm and most modern CLIs. TERM=dumb catches
        # the ones that probe the terminal instead. This cannot fix a plan that greps for escape
        # codes deliberately, but it removes the trap from the default case.
        NO_COLOR=1 TERM=dumb CLICOLOR=0 CLICOLOR_FORCE=0 \
            timeout 120 bash -o pipefail -c "$command" >"$OUT" 2>&1
        if [[ $? -eq 0 ]]; then
            PASSED=$(( PASSED + 1 ))
            record "acceptance-$IDX" "pass" "exit 0" "$command" "$OUT"
        else
            record "acceptance-$IDX" "fail" "non-zero exit" "$command" "$OUT"
        fi
    done <"$VERIFY_CMDS"
    record "acceptance" "$([[ "$PASSED" -eq "$TOTAL" ]] && echo pass || echo fail)" \
        "$PASSED of $TOTAL acceptance commands passed"
else
    record "acceptance" "skipped" "the plan declares no verification commands"
fi

# --- scope and litter -------------------------------------------------------------------------
ALLOWED="$OUT_DIR/allowed.txt"
awk '
    /^## Files to touch[[:space:]]*$/ { in_section=1; next }
    in_section && /^## / { exit }
    in_section && /^\|/ {
        split($0, cells, "|"); path=cells[2]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", path); gsub(/`/, "", path)
        if (path != "Path" && path !~ /^-+$/ && path != "") print path
    }
' "$PLAN_FILE" >"$ALLOWED"

# Files the plan names as present-but-off-limits.
#
# `## Files to touch` is overloaded: it means both "may change" and "should change", and there was
# no way to say "this file is relevant and must not be edited". Reported from real use — a reviewer
# who writes the tests before the run had to list them as touchable purely to stop the scope gate
# calling them invented, which then licensed the implementer to edit the very tests judging it.
#
# A file listed here may exist and be read, and MUST come back byte-identical.
PROTECTED="$OUT_DIR/protected.txt"
awk '
    /^## Files to read, not modify[[:space:]]*$/ { in_section=1; next }
    in_section && /^## / { exit }
    in_section && /^\|/ {
        split($0, cells, "|"); path=cells[2]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", path); gsub(/`/, "", path)
        if (path != "Path" && path !~ /^-+$/ && path != "") print path
    }
    in_section && /^- / {
        path=$0; sub(/^- +/, "", path); gsub(/`/, "", path)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", path)
        if (path != "") print path
    }
' "$PLAN_FILE" >"$PROTECTED"

if [[ -s "$PROTECTED" ]]; then
    PROT_OUT="$OUT_DIR/protected.log"; : >"$PROT_OUT"; TOUCHED_PROTECTED=0
    UNBASELINED=0
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        # Content, not presence. "Appears in the changed list" is true of every untracked file,
        # so the first version of this gate failed every reviewer-written test on sight.
        BASELINE=""
        if [[ -n "$RUN_START_TREE" ]] &&
           git cat-file -e "$RUN_START_TREE:$file" 2>/dev/null; then
            BASELINE="$(git rev-parse "$RUN_START_TREE:$file")"
        elif git cat-file -e "$BASE_COMMIT:$file" 2>/dev/null; then
            BASELINE="$(git rev-parse "$BASE_COMMIT:$file")"
        fi

        if [[ -z "$BASELINE" ]]; then
            # Untracked at the base and no snapshot: nothing to compare against. Saying "unchanged"
            # would be a claim the evidence does not support.
            echo "no baseline to compare against: $file" >>"$PROT_OUT"
            UNBASELINED=$(( UNBASELINED + 1 ))
            continue
        fi
        if [[ ! -f "$WORKTREE/$file" ]]; then
            echo "deleted, but the plan marked it read-only: $file" >>"$PROT_OUT"
            TOUCHED_PROTECTED=$(( TOUCHED_PROTECTED + 1 ))
            continue
        fi
        CURRENT="$(git hash-object -- "$WORKTREE/$file")"
        if [[ "$CURRENT" != "$BASELINE" ]]; then
            echo "changed, but the plan marked it read-only: $file" >>"$PROT_OUT"
            TOUCHED_PROTECTED=$(( TOUCHED_PROTECTED + 1 ))
        fi
    done <"$PROTECTED"
    PROT_TOTAL="$(grep -c . "$PROTECTED")"
    if [[ "$TOUCHED_PROTECTED" -gt 0 ]]; then
        record "read-only" "fail" \
            "$TOUCHED_PROTECTED file(s) the plan marked read-only were modified" "" "$PROT_OUT"
    elif [[ "$UNBASELINED" -gt 0 ]]; then
        record "read-only" "skipped" \
            "$UNBASELINED of $PROT_TOTAL read-only file(s) had no baseline to compare against" \
            "" "$PROT_OUT"
    else
        record "read-only" "pass" "$PROT_TOTAL file(s) marked read-only came back untouched"
    fi
fi

if [[ -s "$ALLOWED" ]]; then
    SCOPE_OUT="$OUT_DIR/scope.log"; : >"$SCOPE_OUT"; OUT_OF_SCOPE=0; LITTER=0
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        grep -Fqx -- "$file" "$ALLOWED" && continue
        # Named read-only: not invented, and already judged by the read-only gate above.
        grep -Fqx -- "$file" "$PROTECTED" 2>/dev/null && continue
        OUT_OF_SCOPE=$(( OUT_OF_SCOPE + 1 ))
        if git cat-file -e "$BASE_COMMIT:$file" 2>/dev/null; then
            echo "modified out of scope: $file" >>"$SCOPE_OUT"
        elif grep -Fqx -- "$file" "$PREEXISTING_EDITED" 2>/dev/null; then
            # Existed before the run, untracked, and came back with different bytes. Out of scope,
            # but not invented: something else created it, and calling it litter names the wrong
            # act — the reviewer would go looking for a file to delete rather than a diff to read.
            echo "modified out of scope (was untracked before this run): $file" >>"$SCOPE_OUT"
        else
            LITTER=$(( LITTER + 1 ))
            echo "invented: $file" >>"$SCOPE_OUT"
        fi
    done <"$CHANGED"
    if [[ "$OUT_OF_SCOPE" -gt 0 ]]; then
        record "scope" "fail" "$OUT_OF_SCOPE file(s) outside the plan, $LITTER of them invented" \
            "" "$SCOPE_OUT"
    else
        record "scope" "pass" "every changed file is named by the plan"
    fi
else
    record "scope" "skipped" "the plan declares no Files to touch table"
fi

# --- regeneration rather than patching ---------------------------------------------------------
REWRITE_OUT="$OUT_DIR/rewrite.log"; : >"$REWRITE_OUT"; REWRITES=0
while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    git cat-file -e "$BASE_COMMIT:$file" 2>/dev/null || continue
    BEFORE=$(git show "$BASE_COMMIT:$file" 2>/dev/null | wc -l)
    [[ "$BEFORE" -gt 0 ]] || continue
    [[ -f "$file" ]] && AFTER=$(wc -l <"$file") || AFTER=0
    REMOVED=$(git diff --numstat "$BASE_COMMIT" -- "$file" | awk '{ print $2 + 0 }')
    if (( AFTER * 2 < BEFORE )) || (( ${REMOVED:-0} >= BEFORE )); then
        echo "$file: $BEFORE lines -> $AFTER, ${REMOVED:-0} removed" >>"$REWRITE_OUT"
        REWRITES=$(( REWRITES + 1 ))
    fi
done <"$CHANGED"
if [[ "$REWRITES" -gt 0 ]]; then
    record "patch-only" "fail" "$REWRITES file(s) regenerated rather than patched" "" "$REWRITE_OUT"
else
    record "patch-only" "pass" "existing files were patched, not regenerated"
fi

# --- project static analysis, only when the project already has it -----------------------------
# Never installed on the fly. A verifier that changes the project to verify it is not a verifier.
if [[ -x vendor/bin/pint ]]; then
    PINT_OUT="$OUT_DIR/pint.log"
    vendor/bin/pint --test >"$PINT_OUT" 2>&1 &&
        record "style" "pass" "pint reports no style violations" "vendor/bin/pint --test" "$PINT_OUT" ||
        record "style" "fail" "pint reports style violations" "vendor/bin/pint --test" "$PINT_OUT"
else
    record "style" "skipped" "vendor/bin/pint not present in this tree"
fi

# phpstan needs to be told what to analyse. Without a phpstan.neon (or a `paths:` section in one)
# it exits non-zero saying "At least one path must be specified to analyse" — on every round, in
# every project that has the binary through a dependency but has never configured it.
#
# That is not a finding about the model's work. Reported from real use: three rounds in a row all
# carried the same advisory failure for a configuration reason, and an advisory that always fails
# is worse than one that does not run, because it teaches you to skip the whole section — which is
# where the real findings are.
# Each candidate tested on its own. `ls a b c` returns non-zero when ANY operand is missing, so
# `! ls phpstan.neon phpstan.neon.dist phpstan.dist.neon` was true even when one of them existed —
# which skipped the gate in exactly the projects that had configured it. A guard that silently
# disables the check it guards is worse than the noise it was written to remove.
STAN_CONFIGURED=0
for candidate in phpstan.neon phpstan.neon.dist phpstan.dist.neon; do
    [[ -f "$candidate" ]] && STAN_CONFIGURED=1
done
if [[ -x vendor/bin/phpstan ]] && (( ! STAN_CONFIGURED )); then
    record "static-analysis" "skipped" \
        "vendor/bin/phpstan is present but this project has no phpstan.neon — nothing to analyse"
elif [[ -x vendor/bin/phpstan ]]; then
    STAN_OUT="$OUT_DIR/phpstan.log"
    vendor/bin/phpstan analyse --no-progress >"$STAN_OUT" 2>&1 &&
        record "static-analysis" "pass" "phpstan clean" "vendor/bin/phpstan analyse" "$STAN_OUT" ||
        record "static-analysis" "fail" "phpstan reported problems" "vendor/bin/phpstan analyse" "$STAN_OUT"
else
    record "static-analysis" "skipped" "vendor/bin/phpstan not present in this tree"
fi

# --- the project's existing suite, to catch damage the plan never thought to check --------------
if [[ -x vendor/bin/pest ]]; then
    TEST_OUT="$OUT_DIR/tests.log"
    timeout 900 vendor/bin/pest --compact >"$TEST_OUT" 2>&1 &&
        record "test-suite" "pass" "existing suite green" "vendor/bin/pest --compact" "$TEST_OUT" ||
        record "test-suite" "fail" "existing suite has failures" "vendor/bin/pest --compact" "$TEST_OUT"
else
    record "test-suite" "skipped" "no vendor/bin/pest in this tree"
fi

# --- render -------------------------------------------------------------------------------------
python3 - "$EVIDENCE" "$OUT_DIR" <<'PY'
import json, os, sys
evidence_path, out_dir = sys.argv[1], sys.argv[2]
rows = [json.loads(line) for line in open(evidence_path) if line.strip()]

# The previous round's bundle, read before this one overwrites it.
#
# A round is not judged only against the plan; it is also judged against the round before it. One
# real feature went 9 of 12 acceptance commands, then a resume of the same plan went 3 of 14 by
# corrupting the file it had nearly finished. Both bundles were correct and neither said the second
# was worse — the reviewer had to hold the earlier number in their head to notice, and nearly did
# not. A repair attempt that scores worse than the attempt it repairs is the clearest available
# signal to stop resuming and take the work over, so it belongs in the header, not in the reader.
previous = None
try:
    with open(f"{out_dir}/evidence.json") as fh:
        prior = json.load(fh)
    if prior.get("acceptance_total"):
        previous = {"passed": prior["acceptance_passed"], "total": prior["acceptance_total"],
                    "verdict": prior.get("verdict")}
except (OSError, ValueError, KeyError):
    previous = None

# What may reject a round, and what may only report.
#
# The verdict comes from the plan's own acceptance commands, plus scope. Everything else is
# advisory: it appears in the evidence, in full, and does not flip the verdict.
#
# That split is measured, not chosen. Across 68 preserved evidence bundles, the harness's own
# opinions caught exactly one thing the plan's commands had not already caught, and it was scope.
# `syntax` fired 3 times and `patch-only` twice, never once alone — the plans express both as
# acceptance commands, so the harness was re-deciding what the plan had already decided.
# `tree-changed` never fired at all.
#
# The reason to care is division of labour. A hosted model writes the plan and reviews the result;
# it is the thing that should decide what "verified" means for a given change. A verifier that
# accumulates its own opinions competes with that judgement, drifts from the scoring in bench/run,
# and grows defects of its own — and in this project nearly every confident wrong conclusion came
# from harness behaviour nobody had measured.
#
# Advisory findings are not demoted to noise. They are what a reviewer reads to decide whether an
# accepted patch is one they actually want.
def is_advisory(row):
    gate = row["gate"]
    return not (gate == "acceptance" or gate.startswith("acceptance-")
                or gate == "scope" or gate == "read-only")

for row in rows:
    row["advisory"] = is_advisory(row)

failed = [r for r in rows if r["status"] == "fail" and not r["advisory"]]
advisory_failed = [r for r in rows if r["status"] == "fail" and r["advisory"]]
skipped = [r for r in rows if r["status"] == "skipped"]
passed = [r for r in rows if r["status"] == "pass"]

verdict = "REJECT" if failed else "ACCEPT"

# The plan's own criteria, scored separately from the gate count. This is the number a reviewer
# actually compares between rounds — the gate count moves when a project gains a linter.
acceptance = [r for r in rows if r["gate"].startswith("acceptance-")]
acc_total = len(acceptance)
acc_passed = len([r for r in acceptance if r["status"] == "pass"])

regressed = False
if previous and acc_total and previous["total"]:
    regressed = (acc_passed / acc_total) < (previous["passed"] / previous["total"])

json.dump({"verdict": verdict, "passed": len(passed), "failed": len(failed),
           "advisory_failed": len(advisory_failed),
           "skipped": len(skipped),
           "acceptance_passed": acc_passed, "acceptance_total": acc_total,
           "previous": previous, "regressed": regressed, "gates": rows},
          open(f"{out_dir}/evidence.json", "w"), indent=2)

# One line per round, kept across rounds, so the trajectory survives the next overwrite.
if acc_total:
    with open(f"{out_dir}/history.jsonl", "a") as fh:
        fh.write(json.dumps({"verdict": verdict, "acceptance_passed": acc_passed,
                             "acceptance_total": acc_total, "regressed": regressed}) + "\n")

headline = verdict
if verdict == "ACCEPT" and advisory_failed:
    headline = "ACCEPT — with advisory findings"
if regressed:
    headline = f"{verdict} — REGRESSED"

lines = [f"# Verification evidence — {headline}", "",
         f"{len(passed)} passed, {len(failed)} failed, "
         f"{len(advisory_failed)} advisory, {len(skipped)} not run.", ""]

if acc_total:
    lines += [f"Acceptance criteria: **{acc_passed} of {acc_total}**"
              + (f", against {previous['passed']} of {previous['total']} last round." if previous
                 else "."), ""]
if regressed:
    lines += ["> **This round scored worse than the one before it.** A repair that loses ground is",
              "> usually damaging the tree rather than fixing it — the commonest cause here is a",
              "> partial edit that truncates a file the previous round had nearly finished.",
              "> Stop resuming. Read the diff, keep whatever is genuinely complete, and write a",
              "> narrow follow-up for the remaining delta, or take the round over by hand.", ""]

lines += [
         "Produced by running commands against the working tree. The implementer's own report was",
         "not consulted and is not evidence.", "",
         "The verdict is the plan's acceptance commands plus scope. Advisory findings are reported",
         "in full and do not decide it — judging those is the reviewer's job, not the harness's.", ""]

if failed:
    lines += ["## Failed", ""]
    for row in failed:
        lines.append(f"- **{row['gate']}** — {row['detail']}")
        if row.get("command"):
            lines.append(f"  - `{row['command']}`")
        if row.get("output_excerpt"):
            lines += ["  ```", *(f"  {l}" for l in row["output_excerpt"].splitlines()[:12]), "  ```"]
    lines.append("")

lines += ["## Passed", ""]
for row in passed:
    proof = f" (`{row['output_sha256']}`)" if row.get("output_sha256") else ""
    lines.append(f"- {row['gate']} — {row['detail']}{proof}")

if advisory_failed:
    lines += ["", "## Advisory — reported, not part of the verdict", "",
              "The plan's checks passed. These did not, and are worth a look before you take the",
              "patch.", ""]
    for row in advisory_failed:
        lines.append(f"- **{row['gate']}** — {row['detail']}")
        if row.get("command"):
            lines.append(f"  - `{row['command']}`")
        if row.get("output_excerpt"):
            lines += ["  ```", *(f"  {l}" for l in row["output_excerpt"].splitlines()[:12]), "  ```"]

if skipped:
    lines += ["", "## Not checked", "",
              "These gates did not run. Absence of a failure here is not evidence of correctness.", ""]
    for row in skipped:
        lines.append(f"- {row['gate']} — {row['detail']}")

open(f"{out_dir}/evidence.md", "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
sys.exit(1 if failed else 0)
