#!/usr/bin/env bash
#
# llamacpp-serve — start, stop or inspect a llama-server for one registered model.
#
#   tools/llamacpp-serve start <model> [context]
#   tools/llamacpp-serve stop
#   tools/llamacpp-serve status
#
# Why this exists rather than just using ollama: ollama's harmony path corrupts gpt-oss tool calls.
# Measured on the same weights, same tool schema and same conversation —
#
#   ollama      2/5 tool calls malformed, HTTP 500 "error parsing tool call"
#   llama.cpp   8/8 valid, and ~74 tok/s against ollama's ~61
#
# End to end through Cline: 4/4 correct edits via llama.cpp, 1/3 via ollama. See
# docs/ollama-issue-draft.md.
#
# One model at a time, deliberately. A 16 GB card cannot hold gpt-oss and gemma together, and two
# resident models would evict each other mid-run — the same contention the bench lock exists to
# prevent. `start` stops whatever was running first.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLAMA_SERVER="${LLAMA_SERVER:-$HOME/.local/opt/llamacpp/llama-b10331/llama-server}"
PORT="${LLAMACPP_PORT:-8071}"

# Where the server listens, and where clients look for it. Separate variables because they answer
# different questions and conflating them is how a model server ends up on the open internet.
#
#   LLAMACPP_BIND   the interface the server binds. Defaults to loopback. To reach the model from
#                   another machine over Tailscale, bind the Tailscale address specifically:
#                       LLAMACPP_BIND="$(tailscale ip -4)" tools/llamacpp-serve start gpt-oss-20b
#                   Never 0.0.0.0. llama-server has no authentication, so binding every interface
#                   publishes an unauthenticated model to whatever network the machine is on.
#
#   LLAMACPP_HOST   the address a client uses. On the GPU machine that is loopback; from a laptop
#                   or an SSH server it is the GPU machine's Tailscale name or address.
BIND="${LLAMACPP_BIND:-127.0.0.1}"
HOST="${LLAMACPP_HOST:-127.0.0.1}"
# Extra server flags, unquoted on purpose so a caller can pass several.
#
# Sampling lives here rather than in the client: Cline exposes no temperature, top-p or seed, so
# the serving default is the only place it can be set. That default is llama.cpp's — temperature
# 0.8, top_p 0.95, top_k 40, random seed — which is a creative-writing profile being used for a
# task whose signatures are dictated and whose acceptance is mechanical. Whatever it is worth, it
# had never been varied, and it is a plausible source of the run-to-run spread that has made every
# comparison here hard to resolve.
#
#   LLAMACPP_EXTRA_ARGS="--temp 0 --top-p 1 --top-k 0 --seed 42" tools/llamacpp-serve start ...
LLAMACPP_EXTRA_ARGS="${LLAMACPP_EXTRA_ARGS:-}"
STATE_DIR="${LLAMACPP_STATE:-$HOME/.cache/agent-handoff}"
LOG="$STATE_DIR/llamacpp.log"
SERVING="$STATE_DIR/llamacpp.model"

# Registered models. Only GGUFs that llama.cpp can actually load belong here: ollama's own
# gpt-oss blob declares architecture `gptoss` and llama.cpp rejects it outright, so the weights
# must come from Hugging Face rather than from ollama's blob store.
model_path() {
    case "$1" in
    gpt-oss-20b) echo "${GPTOSS_GGUF:-$HOME/.cache/agent-handoff/models/gpt-oss-20b-MXFP4.gguf}" ;;
    # LFM2.5-8B-A1B, hybrid convolution + attention MoE: 8.3B total, ~1.5B active per token.
    # Q8_0 from LiquidAI's own repo, NOT ollama's blob and NOT a low quant, for two separate
    # reasons this project has already paid for.
    #
    #   the blob     ollama keeps the chat template in a layer OUTSIDE the GGUF, so pointing
    #                llama.cpp at an ollama blob tests a template-stripped model and tells you
    #                nothing. `ollama pull lfm2.5:8b` is fine for ollama and useless here.
    #   the quant    the gpt-oss Coding-Distill at Q3_K_M fabricated two successes with invented
    #                file paths and was nearly recorded as an architecture verdict. Q8_0 costs
    #                4 GB more and removes quantisation from the list of things a bad result
    #                could mean.
    #
    # `ollama show` lists capabilities completion/tools/thinking. That claim is about the template,
    # not about what the model emits -- every Qwen tried here also declared tools and emitted them
    # as TEXT. tools/engine-conformance is the gate, and it runs before any round.
    lfm2.5-8b) echo "${LFM_GGUF:-$HOME/.cache/agent-handoff/models/LFM2.5-8B-A1B-Q8_0.gguf}" ;;
    # gemma-4-12B-agentic-fable5-composer2.5-v2-3.5x-tau2, Q8_0, pulled with
    # `ollama pull hf.co/yuxinlu1/...`. Pointed at ollama's blob because an hf.co pull stores the
    # publisher's GGUF unmodified, unlike ollama's own builds.
    #
    # THE THING TO CHECK FIRST is the tool-call format, not the benchmark. A sibling build --
    # `gemma-4-12B-coder-fable5` -- is one of four models this project rejected for emitting
    # correct tool calls as TEXT rather than as tool_calls, while `gemma4:12b-128k` from the ollama
    # library emits them natively. Same architecture, same family, opposite answers: the format is
    # decided by whichever template that specific package ships and is not predictable from the
    # model card.
    #
    # And ollama declares stop tokens for this model -- <|turn>, <turn|>, <|turn>user -- in its
    # Modelfile layer, which is OUTSIDE the GGUF. llama.cpp does not see that layer, so if the
    # GGUF carries no template of its own this is a template-stripped model and any result is
    # about the packaging rather than the weights.
    gemma4-agentic-12b) echo "${GEMMA4_AGENTIC_GGUF:-/usr/share/ollama/.ollama/models/blobs/sha256-2c20a496baf3e9a3ead59d37c7afe228a863662d58155f360d44eb8b2465cb7f}" ;;
    # Qwen3.5-9B-Claude-Code, Q8_0, `ollama pull hf.co/empero-ai/...`. Pointed at ollama's blob
    # because an hf.co pull stores the publisher's GGUF unmodified.
    #
    # 8.9 GB of weights leaves ~5.5 GB for KV on this card -- the thing gemma4-agentic at 12.67 GB
    # did not have, where two rounds of three overflowed a 16384 window and were scored as model
    # failures until bench/compare flagged them as configuration results.
    #
    # THE GATE IS THE TOOL-CALL FORMAT, and this card advertises the exact shape that has failed
    # here four times: "calls tools with XML-style <tool_call> blocks". qwen2.5-coder,
    # Qwen3-Coder-30B-A3B, JanusCoder-14B and gemma-4-12B-coder-fable5 were all rejected for
    # emitting correct calls as TEXT rather than as tool_calls -- and one of them was recorded
    # twice as fabricating a blocker when it was telling the truth, because the client never ran
    # the call it made. Whether llama.cpp's --jinja parser promotes this build's format into
    # tool_calls is a property of THIS package, and is probed before any round.
    qwen35-cc-9b) echo "${QWEN35_CC_GGUF:-/usr/share/ollama/.ollama/models/blobs/sha256-9871f5750cd1ebf1e5deb180cf44c9f672a8fd0b3ef375b746e7ec584b049010}" ;;
    # ornith 9B, `ollama pull ornith:9b`. Pointed straight at ollama's blob, which is
    # world-readable and carries the GGUF magic, so no copy is needed.
    #
    # ollama reports family `qwen35`, 9.0B, Q4_K_M, capabilities completion/tools/thinking. The
    # family is the thing to check before anything else: every Qwen tried here emits correct tool
    # calls AS TEXT rather than as tool_calls, which took a shim and three bug fixes to drive at
    # all. tools/engine-conformance answers that in about a minute and is the gate this must pass
    # before a single benchmark round is spent on it.
    ornith-9b) echo "${ORNITH_GGUF:-/usr/share/ollama/.ollama/models/blobs/sha256-af63361d2ac3ba2cb454f440842e345b926a50fe89cbdbe6a55160f32fc28e93}" ;;
    # Muse Glimmer 30B, pulled with `ollama pull hf.co/bartowski/Muse-Glimmer-30B-GGUF:IQ3_M`.
    #
    # Pointed straight at ollama's blob because that is where the file is; ollama is not running
    # it. This is safe in a way the gpt-oss case was not — ollama's OWN gpt-oss build declares
    # architecture `gptoss` and llama.cpp refuses it, but an `hf.co/...` pull stores the publisher's
    # GGUF unmodified.
    #
    # The manifest also carries a 3.58 GiB `image.projector` layer, which is multimodal and
    # irrelevant here. Only the 12.21 GiB `image.model` layer is loaded, which is what makes this
    # fit: 12.21 GiB of weights on a 15.9 GiB card, against ollama's headline figure of 16 GB for
    # the two layers together.
    #
    # REQUIRES b10357 or newer. Muse Glimmer support landed in #26841, so the pinned b10331 cannot
    # load it at all — set LLAMA_SERVER to a newer build.
    muse-glimmer-30b)
        echo "${MUSE_GGUF:-/usr/share/ollama/.ollama/models/blobs/sha256-bc867ee4fc139be474cc4e6c1794ac584507ec510bcfdefe9772a61779181b6f}" ;;
    muse-glimmer-30b-xs)
        echo "${MUSE_XS_GGUF:-/usr/share/ollama/.ollama/models/blobs/sha256-35b02cd38f9b34ec6f8caa0f7e0b78ba6f58c876276bfeceebef84fb2d460b87}" ;;
    *)           echo "" ;;
    esac
}

usage() { echo "usage: llamacpp-serve {start <model> [context]|foreground <model> [context]|rotate-log|stop|status|calibrate <model>|residency <log> [rss-kb]}" >&2; }

# When a systemd unit owns the server, go through it rather than around it.
#
# The unit was added after a reboot took the server with it, and it introduced a supervisor this
# script knew nothing about. Three ways that bites, all silent:
#
#   * `stop` kills the process, systemd's Restart=on-failure brings it straight back, and the next
#     `start` finds the port held by a server it did not launch.
#   * `calibrate` walks candidate context sizes by restarting the server for each one. Against a
#     supervisor that restarts it too, it measures whichever server won the race.
#   * the unit's context was hardcoded, so it served 32768 while every document said 98304 — the
#     condition that voided round 15's first run.
#
# So the context lives in one file, this script writes it, and the unit reads it.
UNIT="${LLAMACPP_UNIT:-monolith-llama.service}"
CONTEXT_FILE="$STATE_DIR/llamacpp.context"

unit_present() {
    [[ "${LLAMACPP_IGNORE_UNIT:-0}" == 1 ]] && return 1
    command -v systemctl >/dev/null 2>&1 || return 1
    systemctl --user cat "$UNIT" >/dev/null 2>&1
}

unit_active() { unit_present && systemctl --user is-active --quiet "$UNIT"; }

# How much context actually fits, measured rather than chosen.
#
# The queue in docs/BENCHMARK-QUEUE.md proposed 96k as a benchmark arm. That is the wrong shape of
# question: whether 96k fits is a property of this card and these weights, and it is answered in
# four minutes by trying it, not in ninety by benchmarking it.
#
# It matters because both errors are expensive and they look nothing alike. Too little context and
# real rounds die with "exceeds the available context size" — three of three surviving real runs
# hit that at 32k. Too much and the KV cache spills to host RAM, which does not fail: the server
# answers, slowly, until it fills swap and is OOM-killed along with whatever terminal started it.
#
# Ascending from a known-good size and stopping at the first failure, rather than descending from
# an optimistic one, because every failed attempt costs a load and an unload, and descending pays
# that cost for the sizes that were never going to work.
#
# The margin is the point. A context that fits with nothing to spare fits until the desktop opens
# a browser tab, so a candidate is only accepted if it leaves MARGIN_MIB of the card free.
CALIBRATE_MARGIN_MIB="${CALIBRATE_MARGIN_MIB:-900}"
CALIBRATE_STEPS="${CALIBRATE_STEPS:-32768 49152 65536 98304 131072}"

# Keep the previous session's log instead of overwriting it.
#
# Per-session isolation is right — a parse-failure rate pooled across every session since the last
# reboot is not a rate for anything. Achieving it by truncation was not: this log IS the
# measurement. tools/peg-audit counts against it, bench/summary brackets token usage by byte offset
# into it, and doctor reads it for residency. A restart destroyed 695 KB of real-use data here,
# including the only record of a header-transposition pattern that had just been read off it.
#
# Rotating gives both: the new session starts clean, and the last KEEP sessions survive a restart.
LOG_KEEP="${LLAMACPP_LOG_KEEP:-10}"

cmd_rotate_log() {
    mkdir -p "$STATE_DIR"
    if [[ -s "$LOG" ]]; then
        mv "$LOG" "$LOG.$(date +%Y%m%dT%H%M%S)" 2>/dev/null || return 0
    fi
    # Oldest first, drop everything past the keep count. `ls -1` over a timestamped suffix sorts
    # chronologically because the stamp is fixed-width and zero-padded.
    local old
    while read -r old; do
        [[ -z "$old" ]] || rm -f "$old"
    done < <(ls -1 "$LOG".* 2>/dev/null | head -n "-$LOG_KEEP")
}

# The entry point a supervisor uses: no daemonising, no health poll, just exec the server.
#
# It exists so the systemd unit does not have to restate the model path, the context, the KV type
# and the ollama eviction. That restatement is what produced a unit serving 32768 while every
# document said 98304 — and systemd's own `$VAR` expansion in Exec lines makes inlining the shell
# for it a trap, since `$ctx` is substituted by systemd before bash ever sees it.
cmd_foreground() {
    local model="$1" context="${2:-}"
    local gguf; gguf="$(model_path "$model")"
    [[ -n "$gguf" ]] || { echo "unknown model: $model" >&2; return 64; }
    [[ -f "$gguf" ]] || { echo "GGUF not found: $gguf" >&2; return 1; }
    [[ -x "$LLAMA_SERVER" ]] || { echo "llama-server not found: $LLAMA_SERVER" >&2; return 1; }

    mkdir -p "$STATE_DIR"
    if [[ -z "$context" ]]; then
        context="$(cat "$CONTEXT_FILE" 2>/dev/null)"
    fi
    # The documented default for a 16 GB card that also drives a desktop. Reached only when the
    # calibrated value is missing or unreadable; a wrong-but-plausible number here is how the 32768
    # regression stayed invisible, so an unusable value must not silently become a small one.
    [[ "$context" =~ ^[0-9]+$ ]] || context=98304

    local loaded
    while read -r loaded; do
        [[ -z "$loaded" ]] || ollama stop "$loaded" >/dev/null 2>&1
    done < <(ollama ps 2>/dev/null | awk 'NR>1 {print $1}')

    printf '%s\n' "$model" >"$SERVING"
    exec "$LLAMA_SERVER" -m "$gguf" --jinja -c "$context" -ngl 999 \
        --host "$BIND" --port "$PORT" -ctk q8_0 -ctv q8_0 \
        ${LLAMACPP_EXTRA_ARGS:-}
}

cmd_calibrate() {
    local model="$1"
    local best="" candidate free
    mkdir -p "$STATE_DIR"

    echo "calibrating $model — the largest context that stays fully GPU-resident"
    echo "margin: ${CALIBRATE_MARGIN_MIB} MiB must remain free"
    echo

    for candidate in $CALIBRATE_STEPS; do
        printf '%7s  ' "$candidate"
        if ! cmd_start "$model" "$candidate" >/dev/null 2>&1; then
            echo "server did not come up — stopping here"
            break
        fi

        local pid rss=""
        pid="$(pgrep -f "$LLAMA_SERVER" 2>/dev/null | head -1)"
        [[ -z "$pid" ]] || rss="$(awk '/^VmRSS:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
        if ! cmd_residency "$LOG" "$rss" >/dev/null 2>&1; then
            echo "spilled out of VRAM — stopping here"
            break
        fi

        free="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc '0-9')"
        if [[ -n "$free" ]] && (( free < CALIBRATE_MARGIN_MIB )); then
            echo "resident, but only ${free} MiB free — too tight, stopping here"
            break
        fi

        # Resident is necessary and not sufficient: a server can hold the weights and still fail
        # to generate. One real completion, or the size does not count as working.
        if ! curl -fsS --max-time 60 "http://$HOST:$PORT/v1/chat/completions" \
            -H 'Content-Type: application/json' \
            -d '{"messages":[{"role":"user","content":"Reply with the single word: ok"}],"max_tokens":8}' \
            >/dev/null 2>&1; then
            echo "resident but would not generate — stopping here"
            break
        fi

        echo "ok (${free:-?} MiB free)"
        best="$candidate"
    done

    echo
    if [[ -z "$best" ]]; then
        echo "nothing in the candidate list fits. Lower CALIBRATE_STEPS, or use a smaller KV type:"
        echo "  the server runs -ctk q8_0 -ctv q8_0; q4_0 roughly halves the KV cache."
        return 1
    fi

    printf '%s\n' "$best" >"$STATE_DIR/llamacpp.context"
    cmd_start "$model" "$best" || return 1
    echo
    echo "calibrated: $best tokens. Recorded in $STATE_DIR/llamacpp.context and now serving."
    if (( best <= 32768 )); then
        echo
        echo "That is the floor, not a comfortable size. Real rounds here have exceeded 32k and"
        echo "failed as 'exceeds the available context size', which reads as a model failure and is"
        echo "not one. Keep steps to one or two files."
    fi
    return 0
}

# Did the model actually land on the GPU?
#
# A partial offload is silently successful: the server answers /health, serves tokens, and passes
# every probe. It only announces itself later, as swap thrashing. On a machine whose GPU also
# drives a desktop, 64k context did not fit — the server fell back to host RAM, took 8.9 GB of RSS
# against 0.80 GB when resident, filled 7 of 8 GB of swap, and was OOM-killed inside the terminal's
# cgroup, which killed the terminal and the run with it. Load average hit 128; that was processes
# blocked on page-in, not CPU.
#
# Three independent signals, because each can be absent depending on build and log verbosity:
# the layer-offload line, KV cache buffers allocated on the CPU, and host RSS. RSS is the blunt
# one and the hardest to misread — a fully resident 20B model holds well under a gigabyte here.
#
# Separated from `start` and taking its inputs as arguments so it can be tested against captured
# logs instead of requiring a GPU.
cmd_residency() {
    local log="$1" rss_kb="${2:-}" problems=0
    [[ -f "$log" ]] || { echo "no log at $log" >&2; return 2; }

    local layers
    layers="$(grep -oE 'offloaded [0-9]+/[0-9]+ layers' "$log" | tail -1)"
    if [[ -n "$layers" ]]; then
        local on total
        on="$(sed -E 's|offloaded ([0-9]+)/([0-9]+) layers|\1|' <<<"$layers")"
        total="$(sed -E 's|offloaded ([0-9]+)/([0-9]+) layers|\2|' <<<"$layers")"
        if [[ "$on" != "$total" ]]; then
            echo "  WARNING: only $on of $total layers are on the GPU."
            problems=$(( problems + 1 ))
        fi
    fi

    # A KV buffer on the CPU means the context did not fit even though the weights did. This is
    # what a too-large `-c` produces, and it is the failure the context table above documents.
    local kv
    kv="$(grep -iE 'CPU[ _]KV buffer size *= *[0-9.]+' "$log" | tail -1)"
    if [[ -n "$kv" ]] && ! grep -qiE 'CPU[ _]KV buffer size *= *0[. ]' <<<"$kv"; then
        echo "  WARNING: part of the KV cache is in host RAM — ${kv#*: }"
        echo "           Lower the context: the KV cache, not the weights, is what overflows first."
        problems=$(( problems + 1 ))
    fi

    if [[ -n "$rss_kb" ]] && [[ "$rss_kb" =~ ^[0-9]+$ ]] && (( rss_kb > 2000000 )); then
        printf '  WARNING: llama-server holds %.1f GB of host RAM. A GPU-resident model holds well\n' \
            "$(awk -v k="$rss_kb" 'BEGIN{print k/1048576}')"
        echo "           under 1 GB here, so the model is at least partly in host memory."
        problems=$(( problems + 1 ))
    fi

    if (( problems > 0 )); then
        echo "  The server will still answer, slowly, and may take the machine down under swap."
        echo "  Restart with a smaller context: tools/llamacpp-serve start <model> 32768"
        return 1
    fi
    return 0
}

cmd_status() {
    if curl -fsS --max-time 3 "http://$HOST:$PORT/health" >/dev/null 2>&1; then
        echo "llama-server: up on :$PORT serving $(cat "$SERVING" 2>/dev/null || echo unknown)"
        return 0
    fi
    echo "llama-server: down"
    return 1
}

cmd_stop() {
    # Matched on the executable NAME, not on $LLAMA_SERVER's path.
    #
    # Path matching had a hole that produced a silently wrong measurement: point LLAMA_SERVER at a
    # different build, and `stop` no longer recognises the server that is already running. The old
    # one survives, the new one cannot bind the port and dies with "exiting due to HTTP server
    # error", and the health check below is satisfied BY THE OLD SERVER. Start then reports success
    # while serving the previous build and the previous model.
    #
    # `pgrep -x` matches the process name exactly, so it finds every llama-server whatever build it
    # came from, and — unlike `pgrep -f llama-server` — cannot match the shell command line that is
    # running this script. That mistake has killed a shell here before.
    # Ask the supervisor, or it will simply start it again. Restart=on-failure treats a killed
    # process as a failure, so the pgrep path below would fight it rather than stop it.
    if unit_active; then
        systemctl --user stop "$UNIT" 2>/dev/null
        rm -f "$SERVING"
        echo "llama-server stopped (via $UNIT)"
        return 0
    fi

    local killed=0 pid
    for pid in $(pgrep -x "llama-server" 2>/dev/null); do
        [[ "$pid" == "$$" ]] && continue
        kill "$pid" 2>/dev/null && killed=1
    done
    [[ "$killed" -eq 0 ]] || sleep 3
    for pid in $(pgrep -x "llama-server" 2>/dev/null); do
        [[ "$pid" == "$$" ]] && continue
        kill -9 "$pid" 2>/dev/null
    done
    rm -f "$SERVING"
    echo "llama-server stopped"
}

cmd_start() {
    local model="$1" context="${2:-65536}"
    local gguf; gguf="$(model_path "$model")"
    [[ -n "$gguf" ]] || { echo "unknown model: $model" >&2; return 64; }
    [[ -f "$gguf" ]] || { echo "GGUF not found: $gguf" >&2; return 1; }
    [[ -x "$LLAMA_SERVER" ]] || { echo "llama-server not found: $LLAMA_SERVER" >&2; return 1; }

    mkdir -p "$STATE_DIR"

    # The context this run is asking for, recorded before anything starts. The unit reads it, and
    # `status` reports against it, so there is one statement of what is being served.
    printf '%s\n' "$context" >"$CONTEXT_FILE"

    if unit_present; then
        # systemd owns the process. Restarting through it evicts ollama via ExecStartPre and
        # re-reads the context file, and -- unlike killing it -- does not trip Restart=on-failure.
        printf '%s\n' "$model" >"$SERVING"
        if ! systemctl --user restart "$UNIT" 2>&1; then
            echo "systemctl --user restart $UNIT failed" >&2
            return 1
        fi
    else
        cmd_stop >/dev/null 2>&1
        cmd_rotate_log

        # Free the GPU first. With one card, an ollama model still resident would either evict this
        # one or push it into a partial CPU offload, which is a throughput cost measured elsewhere
        # in this project and not something to incur by accident.
        local loaded
        while read -r loaded; do
            [[ -z "$loaded" ]] || ollama stop "$loaded" >/dev/null 2>&1
        done < <(ollama ps 2>/dev/null | awk 'NR>1 {print $1}')

        nohup "$LLAMA_SERVER" -m "$gguf" --jinja -c "$context" -ngl 999 \
            --host "$BIND" --port "$PORT" -ctk q8_0 -ctv q8_0 \
            ${LLAMACPP_EXTRA_ARGS:-} >>"$LOG" 2>&1 &
    fi

    local i
    for i in $(seq 1 100); do
        if curl -fsS --max-time 2 "http://$HOST:$PORT/health" >/dev/null 2>&1; then
            # A health check answers the question "is something listening", which is not the
            # question. Confirm the port is serving the GGUF that was asked for, or a stale server
            # will pass for a new one — see the note in cmd_stop.
            local serving_path
            serving_path="$(curl -fsS --max-time 5 "http://$HOST:$PORT/props" 2>/dev/null |
                python3 -c 'import json,sys; print(json.load(sys.stdin).get("model_path",""))' 2>/dev/null)"
            if [[ "$serving_path" != "$gguf" ]]; then
                echo "port $PORT is answering, but with the wrong model." >&2
                echo "  asked for: $gguf" >&2
                echo "  serving:   ${serving_path:-<unknown>}" >&2
                echo "A previous llama-server is still holding the port. Run 'llamacpp-serve stop'." >&2
                return 1
            fi
            printf '%s\n' "$model" >"$SERVING"
            echo "llama-server: up on :$PORT serving $model at ${context} context"
            nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader 2>/dev/null |
                sed 's/^/  GPU: /'
            local pid rss=""
            pid="$(pgrep -f "$LLAMA_SERVER" 2>/dev/null | head -1)"
            [[ -z "$pid" ]] || rss="$(awk '/^VmRSS:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
            cmd_residency "$LOG" "$rss" || true
            return 0
        fi
        pgrep -f "$LLAMA_SERVER" >/dev/null 2>&1 || break
        sleep 3
    done
    echo "llama-server failed to become healthy; last log lines:" >&2
    tail -5 "$LOG" >&2
    return 1
}

case "${1:-}" in
start)  shift; [[ $# -ge 1 ]] || { usage; exit 64; }; cmd_start "$@" ;;
stop)   cmd_stop ;;
status) cmd_status ;;
# Exposed as a subcommand so the check can be run against a log after the fact — and so it can be
# tested without a GPU, which is the only way it would ever have been tested at all.
calibrate) shift; [[ $# -ge 1 ]] || { usage; exit 64; }; cmd_calibrate "$@" ;;
foreground) shift; [[ $# -ge 1 ]] || { usage; exit 64; }; cmd_foreground "$@" ;;
rotate-log) shift; cmd_rotate_log "$@" ;;
residency) shift; [[ $# -ge 1 ]] || { usage; exit 64; }; cmd_residency "$@" ;;
*)      usage; exit 64 ;;
esac
