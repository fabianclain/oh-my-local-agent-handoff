#!/usr/bin/env bash
#
# verifier-selftest — the verifier and the driver, against the failures they exist for.
#
#   tools/verifier-selftest
#
# tools/harness-selftest covers bench/run. This covers tools/verify-round and bin/handoff, which
# are what real use touches. Every case below is a bug that reached a user, not a hypothetical.
#
#   1. non-ASCII paths      git quotes ⚡ as \342\232\241, so a legitimately created Livewire view
#                           was reported as invented. Every UI plan in that project failed on its
#                           own new file.
#   2. read-only, tracked   a file the plan marks read-only must fail the round if modified —
#                           this is what stops a model editing the tests that judge it.
#   3. read-only, untracked a reviewer-written test is usually uncommitted. Asking "does it appear
#                           in the changed list" is true of every untracked file, so the first
#                           version failed every such test on sight.
#   4. read-only, no base   with nothing to compare against, the gate must report `skipped`. A
#                           pass it cannot support is worse than an absent check.
#   5. verdict vs advisory  the verdict is the plan's commands plus scope and read-only. Everything
#                           else reports without a vote, because across 68 bundles the harness's
#                           own opinions caught one thing the plan had not.
#   6. exit status          the gates decide in BOTH directions. A provider that fails over a tree
#                           the gates accept is a success: a third of runs produce a correct patch
#                           with no report, and rejecting those would teach a script to bin them.
#   7. init is safe         `handoff init` must never ignore a path the project tracks. It added
#                           .claude/ to a repo tracking 48 plans under .claude/plans.
#   8. resume verifies      it did not, and exited 0 regardless, so a resumed round the gates would
#                           have rejected looked like a pass.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
V="$HERE/verify-round"
SANDBOX="$(mktemp -d)"
FAILURES=0
# The lock cases plant locks by hand, and a planted lock has no owning process to release it.
# Sandbox paths are unique, so without this the lock root grows by one directory per suite run.
trap 'rm -rf "$SANDBOX" "${XDG_RUNTIME_DIR:-/tmp}"/agent-handoff-locks/%tmp%*' EXIT

pass() { echo "    PASS: $1"; }
fail() { echo "    FAIL: $1"; FAILURES=$(( FAILURES + 1 )); }

# A throwaway project with one source file and one reviewer-written test.
new_project() {
    local root="$SANDBOX/$1"; shift
    mkdir -p "$root/src" "$root/tests" "$root/.handoff/plans"
    ( cd "$root" && git init --quiet . && git config user.email a@b.c && git config user.name t
      printf '<?php\nclass S\n{\n    public function v(): int\n    {\n        return 1;\n    }\n}\n' > src/S.php
      git add -A && git commit --quiet -m init ) >/dev/null
    echo "$root"
}

snapshot() {  # the tree object bin/handoff records before a run
    ( cd "$1" && idx="$(mktemp)" && rm -f "$idx" &&
      GIT_INDEX_FILE="$idx" git add -A >/dev/null &&
      GIT_INDEX_FILE="$idx" git write-tree && rm -f "$idx" )
}

verdict_of() { python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['verdict'])" "$1"; }
gate_status() {
    python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
print(next((g['status'] for g in d['gates'] if g['gate']==sys.argv[2]), 'absent'))" "$1" "$2"
}

echo "==> 1/14 a non-ASCII filename the plan names is not 'invented'"
R="$(new_project ascii)"
mkdir -p "$R/resources/views/pages"
printf '<div>x</div>\n' > "$R/resources/views/pages/⚡rankings.blade.php"
cat > "$R/.handoff/plans/p.md" <<'PLAN'
# add the view
## Files to touch
| Path | Action |
| --- | --- |
| `resources/views/pages/⚡rankings.blade.php` | create |
## Acceptance criteria
- [ ] the view exists
## Verification
```bash
test -f 'resources/views/pages/⚡rankings.blade.php'
```
## Out of scope
Anything else.
PLAN
"$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" >/dev/null 2>&1
if [[ "$(verdict_of "$R/.handoff/e/evidence.json")" == ACCEPT ]]; then
    pass "⚡ path matched the plan"
else
    fail "a ⚡ path the plan names was rejected — core.quotePath regression"
fi

echo "==> 2/14 editing a tracked read-only file fails the round"
R="$(new_project ro_tracked)"
printf '<?php require "src/S.php"; exit((new S)->v()===7?0:1);\n' > "$R/tests/t.php"
( cd "$R" && git add -A && git commit --quiet -m tests )
cat > "$R/.handoff/plans/p.md" <<'PLAN'
# make v return 7
## Files to touch
| Path | Action |
| --- | --- |
| `src/S.php` | modify |
## Files to read, not modify
| Path | Why |
| --- | --- |
| `tests/t.php` | reviewer-written |
## Acceptance criteria
- [ ] the test passes
## Verification
```bash
php tests/t.php
```
## Out of scope
Anything else.
PLAN
sed -i 's/return 1;/return 7;/' "$R/src/S.php"
sed -i 's/===7/===1/' "$R/tests/t.php"
"$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" >/dev/null 2>&1
if [[ "$(gate_status "$R/.handoff/e/evidence.json" read-only)" == fail ]]; then
    pass "a modified read-only file rejected the round"
else
    fail "the model could edit the test that judges it"
fi

echo "==> 3/14 an UNTRACKED read-only file left alone passes"
R="$(new_project ro_untracked)"
printf '<?php require "src/S.php"; exit((new S)->v()===7?0:1);\n' > "$R/tests/t.php"
cp "$SANDBOX/ro_tracked/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
SNAP="$(snapshot "$R")"
sed -i 's/return 1;/return 7;/' "$R/src/S.php"
"$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" "$SNAP" >/dev/null 2>&1
if [[ "$(gate_status "$R/.handoff/e/evidence.json" read-only)" == pass ]]; then
    pass "an untouched uncommitted test did not read as tampering"
else
    fail "an untracked read-only file was reported modified when it was not"
fi

echo "==> 4/14 with no baseline the gate says skipped, not pass"
R="$(new_project ro_nobase)"
printf '<?php exit(0);\n' > "$R/tests/t.php"
cp "$SANDBOX/ro_tracked/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
sed -i 's/return 1;/return 7;/' "$R/src/S.php"
"$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" >/dev/null 2>&1
if [[ "$(gate_status "$R/.handoff/e/evidence.json" read-only)" == skipped ]]; then
    pass "no baseline reported as skipped rather than claimed as clean"
else
    fail "claimed a read-only verdict it had no baseline for"
fi

echo "==> 5/14 a regenerated file advises, and does not reject"
R="$(new_project advisory)"
cat > "$R/.handoff/plans/p.md" <<'PLAN'
# make v return 7
## Files to touch
| Path | Action |
| --- | --- |
| `src/S.php` | modify |
## Acceptance criteria
- [ ] v returns 7
## Verification
```bash
php -r 'require "src/S.php"; exit((new S)->v()===7?0:1);'
```
## Out of scope
Anything else.
PLAN
printf '<?php\nclass S { public function v(): int { return 7; } }\n' > "$R/src/S.php"
"$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" >/dev/null 2>&1
V_JSON="$R/.handoff/e/evidence.json"
if [[ "$(verdict_of "$V_JSON")" == ACCEPT &&
      "$(python3 -c "import json;print(json.load(open('$V_JSON'))['advisory_failed'])")" -ge 1 ]]; then
    pass "patch-only reported without a vote"
else
    fail "the advisory split regressed — verdict $(verdict_of "$V_JSON")"
fi

echo "==> 6/14 handoff exit status follows the gates in both directions"
export PATH="$REPO/bin:$PATH"
R="$(new_project exitstatus)"
cp "$SANDBOX/advisory/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
( cd "$R" && printf '.handoff/runs/\n' >> .gitignore && git add -A && git commit --quiet -m ig )
( cd "$R" && STUB_PATCH="sed -i 's/return 1;/return 7;/' src/S.php" STUB_REPORT='garbage not json' \
    HANDOFF_PROVIDER=stub handoff do p >/dev/null 2>&1 ); GOOD=$?
( cd "$R" && git checkout --quiet -- src/S.php
  STUB_PATCH="sed -i 's/return 1;/return 4;/' src/S.php" \
  STUB_REPORT='{"status":"complete","summary":"s","files_changed":[],"tests_run":[],"deviations":[],"blockers":[],"follow_ups":[]}' \
    HANDOFF_PROVIDER=stub handoff do p >/dev/null 2>&1 ); BAD=$?
if [[ "$GOOD" -eq 0 && "$BAD" -ne 0 ]]; then
    pass "good tree + unusable report = 0; bad tree + perfect report = non-zero"
else
    fail "exit status wrong: good tree gave $GOOD, bad tree gave $BAD"
fi

echo "==> 7/14 init never ignores a path the project tracks"
R="$(new_project inits)"
mkdir -p "$R/.claude/plans" && echo "# a tracked plan" > "$R/.claude/plans/x.md"
( cd "$R" && git add -A && git commit --quiet -m plans )
( cd "$R" && handoff init >/dev/null 2>&1 )
if grep -qxF '.claude/' "$R/.gitignore" 2>/dev/null; then
    fail "ignored .claude/ in a project that tracks plans there"
elif grep -qxF '.handoff/runs/' "$R/.gitignore" 2>/dev/null; then
    pass "added the safe entry, left the tracked path alone"
else
    fail "init added nothing at all"
fi

echo "==> 8/14 resume verifies instead of exiting 0 blindly"
if grep -qE '"\$MODE" == "do" \|\| "\$MODE" == "resume"' "$REPO/bin/handoff"; then
    pass "resume runs the gates"
else
    fail "resume no longer verifies — a rejected resume would look like a pass"
fi

# 9, 10 and 11 are the same subtraction seen from three sides. The rule is that a pre-existing
# untracked file is excused by its CONTENT, not by its name being on a list — and both directions
# have now been wrong in real use, in the same week.
untracked_project() {  # a project whose only interesting file is untracked, plus the baseline
    local root; root="$(new_project "$1")"
    printf 'one\ntwo\n' > "$root/notes.md"
    cat > "$root/.handoff/plans/p.md" <<PLAN
# edit the note
## Files to touch
| Path | Action |
| --- | --- |
| \`${2:-notes.md}\` | modify |
## Acceptance criteria
- [ ] the note mentions three
## Verification
\`\`\`bash
grep -q three notes.md
\`\`\`
## Out of scope
Anything else.
PLAN
    ( cd "$root" && git -c core.quotePath=false ls-files --others --exclude-standard \
        >"$root/.handoff/untracked-before" )
    echo "$root"
}

echo "==> 9/14 editing a file that was untracked before the run counts as a change"
R="$(untracked_project untracked_edited)"
SNAP="$(snapshot "$R")"
printf 'one\ntwo\nthree\n' > "$R/notes.md"
HANDOFF_UNTRACKED_BEFORE="$R/.handoff/untracked-before" \
    "$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" "$SNAP" >/dev/null 2>&1
if [[ "$(gate_status "$R/.handoff/e/evidence.json" tree-changed)" == pass ]]; then
    pass "an edited untracked file was not reported as an untouched tree"
else
    # This is the round that gets thrown away. "The working tree is unchanged; nothing was
    # implemented" is the one signature whose documented remedy is to re-run rather than re-specify.
    fail "an edited untracked file read as 'nothing was implemented' — correct work would be redone"
fi

echo "==> 10/14 a pre-existing untracked file left alone is still not counted"
R="$(untracked_project untracked_untouched)"
SNAP="$(snapshot "$R")"
HANDOFF_UNTRACKED_BEFORE="$R/.handoff/untracked-before" \
    "$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" "$SNAP" >/dev/null 2>&1
if [[ "$(gate_status "$R/.handoff/e/evidence.json" tree-changed)" == fail ]]; then
    pass "an untouched untracked file did not fake a change"
else
    fail "someone's stray file now counts as the model's work — the original false accusation"
fi

echo "==> 11/14 an edited untracked file out of scope is not called 'invented'"
R="$(untracked_project untracked_scope src/S.php)"
SNAP="$(snapshot "$R")"
printf 'one\ntwo\nthree\n' > "$R/notes.md"
HANDOFF_UNTRACKED_BEFORE="$R/.handoff/untracked-before" \
    "$V" "$R" "$R/.handoff/plans/p.md" HEAD "$R/.handoff/e" "$SNAP" >/dev/null 2>&1
if grep -q 'invented: notes.md' "$R/.handoff/e/scope.log" 2>/dev/null; then
    fail "a file that existed before the run was called invented — sends the reviewer hunting litter"
elif grep -q 'notes.md' "$R/.handoff/e/scope.log" 2>/dev/null; then
    pass "reported out of scope, and named as an edit rather than as litter"
else
    fail "an out-of-scope edit to an untracked file was not reported at all"
fi

# ------------------------------------------------------------------------------------------------
# The lock. Two agent sessions once drove this harness at one checkout: rounds interleaved, one
# session reverted the file the other was patching, and the verdict came back "the working tree is
# unchanged; nothing was implemented" — true about the tree, false about the round, and nothing in
# the artifacts distinguished the two. Case 13 is the one that keeps the cure from being worse than
# the disease: a killed round must not leave a repository that refuses to run until someone deletes
# a directory by hand.

echo "==> 12/14 a second round refuses while the first holds the lock"
export PATH="$REPO/bin:$PATH"
R="$(new_project locking)"
cp "$SANDBOX/advisory/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
( cd "$R" && printf '.handoff/runs/\n' >> .gitignore && git add -A && git commit --quiet -m ig )
# The lock lives outside the tree, keyed by the checkout path — see acquire_lock in bin/handoff.
LOCKD="${XDG_RUNTIME_DIR:-/tmp}/agent-handoff-locks/$(printf '%s' "$(cd "$R" && pwd -P)" | tr '/' '%')"
# Held by a process that is genuinely alive: `sleep` in the background, its real pid in the lock.
mkdir -p "$LOCKD"
sleep 30 & HOLDER=$!
echo "$HOLDER" > "$LOCKD/pid"
echo "other-slug" > "$LOCKD/slug"
echo "2026-08-13T16:00:00Z" > "$LOCKD/since"
OUT="$( cd "$R" && HANDOFF_PROVIDER=stub STUB_PATCH="sed -i 's/return 1;/return 7;/' src/S.php" \
        handoff do p 2>&1 )"; RC=$?
kill "$HOLDER" 2>/dev/null; wait "$HOLDER" 2>/dev/null
if [[ "$RC" -eq 0 ]]; then
    fail "a second round ran while another held the lock — this is the incident, reproduced"
elif ! grep -q "other-slug" <<<"$OUT"; then
    fail "refused without naming the round that holds it, so there is nothing to act on"
elif ! git -C "$R" diff --quiet -- src/S.php; then
    fail "refused, but the stub patch still landed — the refusal came after the tree was touched"
else
    pass "refused, named the holder, and left the tree alone"
fi

echo "==> 13/14 a lock whose owner is gone is cleared, not fatal"
R="$(new_project stalelock)"
cp "$SANDBOX/advisory/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
( cd "$R" && printf '.handoff/runs/\n' >> .gitignore && git add -A && git commit --quiet -m ig )
LOCKD="${XDG_RUNTIME_DIR:-/tmp}/agent-handoff-locks/$(printf '%s' "$(cd "$R" && pwd -P)" | tr '/' '%')"
mkdir -p "$LOCKD"
# A pid that has certainly exited: start one and reap it.
sleep 0.1 & DEAD=$!; wait "$DEAD" 2>/dev/null
echo "$DEAD" > "$LOCKD/pid"
echo "killed-round" > "$LOCKD/slug"
echo "2026-08-13T16:00:00Z" > "$LOCKD/since"
OUT="$( cd "$R" && HANDOFF_PROVIDER=stub STUB_PATCH="sed -i 's/return 1;/return 7;/' src/S.php" \
        STUB_REPORT='{"status":"complete","summary":"s","files_changed":[],"tests_run":[],"deviations":[],"blockers":[],"follow_ups":[]}' \
        handoff do p 2>&1 )"; RC=$?
if [[ "$RC" -ne 0 ]]; then
    fail "a stale lock blocked the round; a SIGKILLed run would wedge the repository"
    sed -n '1,3p' <<<"$OUT" | sed 's/^/        /'
elif ! grep -q "stale lock" <<<"$OUT"; then
    fail "took the lock silently — a cleared lock is worth one line, in case it was not stale"
else
    pass "cleared it, said so, and ran"
fi

echo "==> 14/14 the lock is released when a round ends, so the next one runs"
R="$(new_project lockrelease)"
cp "$SANDBOX/advisory/.handoff/plans/p.md" "$R/.handoff/plans/p.md"
( cd "$R" && printf '.handoff/runs/\n' >> .gitignore && git add -A && git commit --quiet -m ig )
( cd "$R" && HANDOFF_PROVIDER=stub STUB_PATCH="sed -i 's/return 1;/return 7;/' src/S.php" \
    handoff do p >/dev/null 2>&1 )
LOCKD="${XDG_RUNTIME_DIR:-/tmp}/agent-handoff-locks/$(printf '%s' "$(cd "$R" && pwd -P)" | tr '/' '%')"
if [[ -d "$LOCKD" ]]; then
    fail "the lock outlived the round — every later round in this repository would refuse"
else
    ( cd "$R" && git checkout --quiet -- src/S.php )
    ( cd "$R" && HANDOFF_PROVIDER=stub STUB_PATCH="sed -i 's/return 1;/return 7;/' src/S.php" \
        handoff do p >/dev/null 2>&1 ); SECOND=$?
    if [[ "$SECOND" -eq 0 ]]; then
        pass "released on exit, and a second round runs normally"
    else
        fail "the lock was gone but the second round still failed (exit $SECOND)"
    fi
fi

echo
if [[ "$FAILURES" -eq 0 ]]; then echo "all checks passed"; else echo "$FAILURES check(s) failed"; fi
exit $(( FAILURES > 0 ? 1 : 0 ))
