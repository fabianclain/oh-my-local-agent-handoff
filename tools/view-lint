#!/usr/bin/env python3
"""view-lint — damage to a view that renders anyway.

    tools/view-lint page.html
    tools/view-lint resources/views/pages/thing.blade.php
    tools/view-lint page.html --strict      treat the advisories as failures too

Exit 0 when the markup is well-formed, 1 when it is not (or, with --strict, when any advisory
fires), 2 when the file cannot be read.

WHY

The skill says views are the worst case because text assertions are fakeable. The sharper point,
from the round that prompted this:

    HTML with unbalanced tags renders and passes everything. A parse check is three lines and
    catches a class of damage nothing else does.

That round's plan described renaming two `div`s. A criterion asserted `grep -c 'div' -eq 0`; the
file had a third occurrence the prose had not counted, and the model — obeying the criterion over
the prose — changed an opening tag and left the closing one. The result was malformed HTML that 85
tests passed over. The gate that caught it was one the reviewer had added by hand.

ON libxml, WHICH IS THE OBVIOUS WAY TO DO THIS AND DOES NOT WORK

`libxml` parses HTML4. Every HTML5 element — `<main>`, `<section>`, `<nav>` — comes back as error
code 801, "Tag X invalid", so an unfiltered check reports dozens of errors on a perfectly good page
and gets switched off. Filtering 801 works but is easy to forget, and the failure mode is a check
that either cries wolf or is disabled. This uses Python's own parser and its own stack instead, so
there is no code to filter.

OPTIONAL END TAGS

`</p>`, `</li>`, `</tr>` and friends may legally be omitted, so leaving them out is not damage and
is not reported. Everything else must be closed by the tag that opened it.

BLADE

`{{ }}`, `{!! !!}` and `@directive(...)` are stripped before parsing. If the file contains
conditional directives the tag balance is reported with a caveat, because a `<div>` opened in one
branch and closed in another is legitimate and unparseable here.
"""

from __future__ import annotations

import argparse
import pathlib
import re
import sys
from html.parser import HTMLParser

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param",
        "source", "track", "wbr"}
# End tags HTML5 permits omitting. Reporting these would flag ordinary correct markup, and a lint
# that flags correct markup is one nobody runs twice.
OPTIONAL_END = {"p", "li", "dt", "dd", "option", "optgroup", "thead", "tbody", "tfoot", "tr",
                "td", "th", "rt", "rp", "colgroup", "caption", "head", "body", "html"}
HEADINGS = {"h1", "h2", "h3", "h4", "h5", "h6"}
# Inside these, leading whitespace is content. Indentation findings are suppressed under them.
PREFORMATTED = {"pre", "textarea"}

# PHP first, and this is not optional.
#
# Livewire's inline-class syntax puts the whole component class at the top of the blade file, and
# a PHPDoc generic — `@return array<string, mixed>` — reads as an unclosed `<string,` tag. Running
# this over 117 real blade files reported 16 as malformed, and every one of those was a docblock.
# A lint whose first contact with a real codebase is 16 false accusations is worse than none: the
# next real finding is read as more of the same.
PHP_BLOCK = re.compile(r"<\?php.*?(\?>|\Z)", re.DOTALL)
BLADE_PHP = re.compile(r"@php\b.*?@endphp", re.DOTALL)
BLADE_EXPR = re.compile(r"\{\{--.*?--\}\}|\{\{.*?\}\}|\{!!.*?!!\}", re.DOTALL)
BLADE_DIRECTIVE = re.compile(r"@[a-zA-Z]+(\s*\((?:[^()]|\([^()]*\))*\))?")
BLADE_CONDITIONAL = re.compile(r"@(if|unless|foreach|forelse|for|while|auth|guest|switch|"
                               r"empty|isset|can|cannot|env|production|hasSection|else)\b")


def is_component(tag: str) -> bool:
    """A Blade or Flux component tag rather than an HTML element.

    `<flux:icon.check>` closed by `</flux:icon>` is a mismatch, but it is the TEMPLATE COMPILER's
    mismatch: Blade resolves these tags itself and errors at compile time, so the test suite
    already catches it. Raw HTML is the case nothing catches — it renders, and 85 tests passed
    over the malformed page that prompted this tool. Keeping the hard failure for the silent case
    is the whole point; lumping them together would mean the one real HTML finding in a repository
    arrives alongside a pile of component-syntax noise.
    """
    return ":" in tag or tag.startswith("x-")


class Balance(HTMLParser):
    """A tag stack, and what does not match it."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.stack: list[tuple[str, int]] = []
        self.errors: list[str] = []
        self.component_errors: list[str] = []
        self.tags: set[str] = set()
        self.ids: list[str] = []
        # How many elements the balance check actually applied to. Reported so the pass message
        # states its denominator instead of asserting a result that is vacuous at zero.
        self.checked = 0
        # Headings in document order, as (level, line). Order is the whole point: a page can have
        # an h1 and still read as a broken document if something outranks it on the way down.
        self.headings: list[tuple[int, int]] = []
        # Every start tag as (depth, line, tag, inside_preformatted), depth taken BEFORE the push.
        # Siblings are derived from this afterwards rather than tracked here, so none of the
        # unwinding logic below has to change to support it.
        self.opens: list[tuple[int, int, str, bool]] = []

    def report(self, tag: str, message: str) -> None:
        (self.component_errors if is_component(tag) else self.errors).append(message)

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        self.tags.add(tag)
        for key, value in attrs:
            if key.lower() == "id" and value:
                self.ids.append(value)
        if tag in HEADINGS:
            self.headings.append((int(tag[1]), self.getpos()[0]))
        self.opens.append((len(self.stack), self.getpos()[0], tag,
                           any(t in PREFORMATTED for t, _ in self.stack)))
        if tag not in VOID:
            self.checked += 1
            self.stack.append((tag, self.getpos()[0]))

    def handle_startendtag(self, tag, attrs):
        tag = tag.lower()
        self.tags.add(tag)
        self.opens.append((len(self.stack), self.getpos()[0], tag,
                           any(t in PREFORMATTED for t, _ in self.stack)))

    def handle_endtag(self, tag):
        tag = tag.lower()
        if tag in VOID:
            return
        for depth in range(len(self.stack) - 1, -1, -1):
            if self.stack[depth][0] != tag:
                continue
            # Everything above it was left open. Optional end tags are legitimately omitted;
            # anything else is the damage this exists for.
            for orphan, line in self.stack[depth + 1:]:
                if orphan not in OPTIONAL_END:
                    self.report(orphan,
                                f"line {line}: <{orphan}> is still open where </{tag}> closes")
            del self.stack[depth:]
            return
        self.report(tag, f"line {self.getpos()[0]}: </{tag}> closes nothing that is open")

    def finish(self) -> None:
        for tag, line in self.stack:
            if tag not in OPTIONAL_END:
                self.report(tag, f"line {line}: <{tag}> is never closed")


# --- the overflow trap --------------------------------------------------------------------------
#
# `align-items: center` on a `min-height: 100vh` flex container centres the child on the viewport.
# When the child is taller than the viewport it overflows in BOTH directions, and the top is
# clipped away with nothing to scroll to. Reported from real use on a page whose criteria all
# passed.

RULE = re.compile(r"([^{}]+)\{([^{}]*)\}")
COMMENT = re.compile(r"/\*.*?\*/", re.DOTALL)


def declarations(body: str) -> dict[str, str]:
    out = {}
    for piece in body.split(";"):
        if ":" in piece:
            name, _, value = piece.partition(":")
            out[name.strip().lower()] = value.strip().lower()
    return out


def check_overflow(css: str) -> list[str]:
    findings = []
    for match in RULE.finditer(COMMENT.sub("", css)):
        selector = match.group(1).strip().splitlines()[-1].strip()
        if selector.startswith("@"):
            continue
        decls = declarations(match.group(2))
        display = decls.get("display", "")
        centred = (decls.get("align-items") == "center"
                   or decls.get("place-items", "").startswith("center"))
        tall = any(decls.get(prop, "").endswith("100vh") for prop in ("min-height", "height"))
        scrolls = any(decls.get(prop, "") in ("auto", "scroll")
                      for prop in ("overflow", "overflow-y"))
        if display in ("flex", "grid", "inline-flex") and centred and tall and not scrolls:
            findings.append(
                f"`{selector}` centres on a {decls.get('min-height') or decls.get('height')} "
                f"box with no overflow-y")
    return findings


# --- what a view is for ---------------------------------------------------------------------

def check_structure(balance: Balance, text: str) -> list[str]:
    findings = []
    if balance.tags and not (balance.tags & HEADINGS):
        # A spec gap, not a model error, and named as one: a plan said "a centred card" and never
        # said "heading", so the model produced a card with no heading element and was right to.
        # A checklist prevents that; blame does not.
        findings.append("no heading element (h1-h6) — if the plan asked for one, this is a defect; "
                        "if it did not, the plan should have")
    # The outline, which is not the same question as "is there an h1".
    #
    # Reported from real use: a document rendered <h2>Supplier, <h2>Client, then <h1>Offer no. 42.
    # Tag balance is perfect, an h1 exists, every text assertion passes, and it reads as an HTML
    # dump rather than a document — the title does not lead. Nothing in the harness saw it.
    levels = [level for level, _ in balance.headings]
    if levels:
        first_h1 = next((i for i, level in enumerate(levels) if level == 1), None)
        if first_h1 is None:
            findings.append("headings start at h%d and there is no h1 — a document's title should "
                            "lead, and screen readers use the first level as the outline root"
                            % levels[0])
        elif first_h1 > 0:
            line = balance.headings[first_h1][1]
            findings.append("the h1 on line %d is preceded by %d heading(s) at h%s — the title "
                            "does not lead the outline"
                            % (line, first_h1, "/h".join(str(l) for l in levels[:first_h1])))
        if levels.count(1) > 1:
            findings.append("%d h1 elements — a document has one title" % levels.count(1))
        for (previous, _), (level, line) in zip(balance.headings, balance.headings[1:]):
            if level > previous + 1:
                findings.append("the outline skips from h%d to h%d on line %d"
                                % (previous, level, line))
                break

    duplicates = {i for i in balance.ids if balance.ids.count(i) > 1}
    if duplicates:
        findings.append("duplicate id(s): " + ", ".join(sorted(duplicates)))
    return findings


def check_indent(balance: Balance, text: str) -> list[str]:
    """Sibling elements that do not start at the same column.

    Reported from real use, by eye, after both gates and the full test suite had passed: a drag
    handle indented 16 spaces where its siblings sat at 8. Nothing saw it. `pint` does not format
    Blade, tag balance is unaffected, and every text assertion passes over it.

    It is advisory and stays advisory unless `--strict` is passed. Indentation that is wrong is a
    review comment, not a broken page, and a cosmetic rule able to reject correct work would be a
    worse bug than the one it reports.

    THREE THINGS IT REFUSES TO GUESS AT, because each would produce a false accusation:

      - an element that is not the first thing on its line has no indentation of its own
      - siblings separated by a Blade directive are legitimately at different depths, since
        `@foreach` indents its body without being an element
      - inside <pre> and <textarea>, leading whitespace is content

    Measured before shipping, because the header above records what happens when a lint's first
    contact with a real codebase is a pile of false accusations: over 120 real blade files it
    compared 2,698 sibling pairs, engaged on 117 of the 120, and reported nothing. High engagement
    with no findings is the result worth having — zero findings alone would equally describe a
    rule that never runs, which is why the pairs were counted rather than just the findings.
    """
    lines = text.splitlines()
    directive = re.compile(r"^\s*(@[a-zA-Z]|\{\{--|<!--|<\?php)")

    def column(line_no: int) -> int | None:
        if not 1 <= line_no <= len(lines):
            return None
        line = lines[line_no - 1]
        stripped = line.lstrip()
        # Only a tag that opens its own line has an indent that means anything.
        return len(line) - len(stripped) if stripped.startswith("<") else None

    def separated(first: int, second: int) -> bool:
        return any(directive.match(lines[n - 1]) for n in range(first + 1, second)
                   if 1 <= n <= len(lines))

    opens = balance.opens
    misaligned: list[str] = []
    for index, (depth, line, tag, in_pre) in enumerate(opens):
        if in_pre:
            continue
        for other in opens[index + 1:]:
            other_depth, other_line, other_tag, other_pre = other
            if other_depth < depth:
                break                      # left this parent; no more siblings
            if other_depth > depth:
                continue                   # a descendant, not a sibling
            here, there = column(line), column(other_line)
            if (here is not None and there is not None and here != there
                    and not other_pre and not separated(line, other_line)):
                misaligned.append(f"<{tag}> on line {line} starts at column {here}, "
                                  f"its sibling <{other_tag}> on line {other_line} at {there}")
            break                          # only the NEXT sibling; one shift would else cascade
    if misaligned:
        shown = "; ".join(misaligned[:3])
        more = f" (and {len(misaligned) - 3} more)" if len(misaligned) > 3 else ""
        return [f"sibling elements are indented differently — {shown}{more}"]
    return []


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("file")
    parser.add_argument("--strict", action="store_true",
                        help="advisories fail the run too, for use as an acceptance command")
    args = parser.parse_args()

    path = pathlib.Path(args.file)
    if not path.is_file():
        print(f"no such file: {args.file}", file=sys.stderr)
        return 2
    raw = path.read_text(errors="replace")

    # A file with nothing in it is not well-formed markup; it is an absence.
    #
    # Reporting "every element that requires an end tag has one" over an empty file is true and
    # useless: the statement is vacuous at zero elements, and it converts "nothing was written"
    # into a green gate. This tool runs as an acceptance criterion in real plans, so an empty
    # deliverable would have passed the only gate looking at the markup.
    #
    # Exit 2 rather than 1, following the convention the rest of the harness uses: this is not a
    # verdict of malformed, it is a refusal to give a verdict at all — the same distinction
    # css-contrast draws when it lists what it could not resolve instead of passing over it.
    #
    # Only a file that is empty or all whitespace is treated this way. A file with text and no
    # tags is a legitimate shape — a Blade partial that is nothing but directives strips to
    # exactly that — and failing it would be a false positive on real templates.
    if not raw.strip():
        print(f"{path}")
        print("\n  NOTHING TO CHECK — the file is empty.")
        print("  This is not a pass. A gate cannot certify markup that does not exist.")
        return 2

    conditional = bool(BLADE_CONDITIONAL.search(raw))
    text = raw
    for pattern in (PHP_BLOCK, BLADE_PHP, BLADE_EXPR, BLADE_DIRECTIVE):
        # Blank each match but KEEP its newlines. Collapsing a 60-line component class to one
        # space shifts every line number after it, and a lint that names the wrong line sends the
        # reader to correct markup and teaches them the tool is broken.
        text = pattern.sub(lambda m: "\n" * m.group(0).count("\n"), text)

    balance = Balance()
    balance.feed(text)
    balance.close()
    balance.finish()

    css = "\n".join(re.findall(r"<style[^>]*>(.*?)</style>", raw, re.DOTALL | re.IGNORECASE))
    advisories = check_overflow(css) + check_structure(balance, raw) + check_indent(balance, raw)
    advisories += [f"{e}  (a component tag — the template compiler catches this one)"
                   for e in balance.component_errors]

    print(f"{path}")
    if balance.errors:
        print(f"\n  MALFORMED — {len(balance.errors)} problem(s):")
        for error in balance.errors:
            print(f"    {error}")
        if conditional:
            print("\n  This file has Blade conditionals. A tag opened in one branch and closed in")
            print("  another is legitimate and cannot be checked here — read the lines above")
            print("  before believing them.")
    elif balance.checked:
        print(f"\n  well-formed: all {balance.checked} element(s) that require an end tag have"
              " one, in order")
    else:
        # Content, but no element the check applies to — a text fragment, or bytes that are not
        # markup at all. Saying "well-formed" here states a result over an empty denominator,
        # which is the shape this project has had to retract numbers for before.
        print("\n  no elements requiring an end tag were found, so nothing was checked.")
        print("  That is not the same as well-formed.")

    if advisories:
        print("\n  advisory:")
        for finding in advisories:
            print(f"    {finding}")

    print("\n  not checked: whether it looks right, whether the text is correct, and any")
    print("  markup produced at runtime rather than written in this file.")

    if balance.errors:
        return 1
    if args.strict and advisories:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
