DISABLED: set[str] = set()


def tool_schemas(include_report: bool, schema: dict) -> list[dict]:
    tools = [
        {"type": "function", "function": {
            "name": "read_files",
            "description": ("Read files from the repository. A large file is truncated unless "
                            "you window it: pass `start` and `end` (1-based, inclusive) to read "
                            "one part of it. Line numbers printed by `search` can be used "
                            "directly, so search for a declaration and then read around it."),
            "parameters": {"type": "object", "required": ["files"], "properties": {
                "files": {"type": "array", "items": {"type": "object", "properties": {
                    "path": {"type": "string"},
                    "start": {"type": "integer",
                              "description": "first line to read, 1-based and inclusive"},
                    "end": {"type": "integer",
                            "description": "last line to read, inclusive"}}}}}}}},
        {"type": "function", "function": {
            "name": "search",
            "description": ("Search the repository for a regular expression, printing "
                            "file:line:text. `query` is a REGEX: escape ( ) [ ] . * + ? | with a "
                            "backslash to match them literally — `moveItem\\(`, not `moveItem(`."),
            "parameters": {"type": "object", "required": ["query"], "properties": {
                "query": {"type": "string"}, "path": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "write_file",
            "description": ("Write a file in full. Creates it if absent, replaces it if "
                            f"present. Anything not named by the plan belongs in {SCRATCH}/, "
                            "which is yours and is ignored by the verifier."),
            "parameters": {"type": "object", "required": ["path", "content"], "properties": {
                "path": {"type": "string"}, "content": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "replace_in_file",
            "description": ("Replace one exact occurrence of `old` with `new` in a file. "
                            "Fails if `old` is absent or appears more than once."),
            "parameters": {"type": "object", "required": ["path", "old", "new"], "properties": {
                "path": {"type": "string"}, "old": {"type": "string"}, "new": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "run_commands",
            "description": ("Run shell commands in the repository root and return their "
                            "output. git commands that change history are refused."),
            "parameters": {"type": "object", "required": ["commands"], "properties": {
                "commands": {"type": "array", "items": {"type": "string"}}}}}},
    ]
    tools = [t for t in tools if t["function"]["name"] not in DISABLED]
    if include_report and "submit_report" not in DISABLED:
        tools.append({"type": "function", "function": {
            "name": "submit_report",
            "description": "Submit the completion report. Call this when the work is finished.",
            "parameters": schema}})
    return tools


class ToolFault(Exception):
    """The harness failed, not the model.

    The distinction is the entire point of this layer. Without it every tool-layer defect arrives
    as a rejected round with a damaged tree, indistinguishable from the model writing nonsense —
    which is how six separate instrument faults were attributed to the model in a single day
    before anyone checked. A fault raised here is logged with its own class and says whose it is.
    """

    def __init__(self, kind: str, detail: str) -> None:
        super().__init__(detail)
        self.kind = kind
        self.detail = detail


WRITABLE: set[str] = set()
READONLY: set[str] = set()


def check_writable(repo: pathlib.Path, path: pathlib.Path) -> None:
    """Refuse a write the gates would reject anyway, on the turn it happens.

    Two rules, both already enforced after the fact and both cheaper enforced now:

      - a file under '## Files to read, not modify' must come back byte-identical. A reviewer
        writes the tests before the run and lists them here; editing them is the implementer
        marking its own work, and the round is lost when the gate notices.
      - a file the plan does not name is a scope violation. Two of four `wide` rounds were
        rejected for tmp/test_*.php and verify.sh, one of them with 11 of 11 criteria met.

    Silence when the lists are unknown. A tool that refuses everything because nobody told it what
    was allowed is worse than one that refuses nothing.
    """
    try:
        rel = str(path.relative_to(repo.resolve()))
    except ValueError:
        return
    if rel in READONLY:
        raise ToolFault("scope", f"{rel} is listed under 'Files to read, not modify'; "
                                 "it must come back byte-identical and may not be edited")
    if WRITABLE and rel not in WRITABLE and not rel.startswith(SCRATCH + "/"):
        raise ToolFault("scope", f"{rel} is not in the plan's 'Files to touch'; "
                                 f"put anything else under {SCRATCH}/, which is yours")


def resolve(repo: pathlib.Path, raw: str) -> pathlib.Path:
    """Resolve a model-supplied path, and refuse anything that leaves the repository.

    `repo / path.lstrip("/")` was the previous behaviour and it silently rewrites `/etc/hosts` to
    `<repo>/etc/hosts`, which is not an error and not what was asked — the worst combination. `..`
    escapes were unhandled entirely.
    """
    text = str(raw)
    root = repo.resolve()
    # An absolute path is treated as absolute and then checked, NOT stripped to a relative one.
    # Stripping is what the docstring above warns against and what the first version of this
    # function did anyway: /etc/evil.txt became <repo>/etc/evil.txt and reported success, so the
    # model was told its write landed somewhere it did not.
    candidate = (pathlib.Path(text) if text.startswith("/") else repo / text).resolve()
    if candidate != root and root not in candidate.parents:
        raise ToolFault("scope", f"{text} resolves outside the repository; refusing")
    return candidate


def read_text_strict(path: pathlib.Path) -> str:
    """Decode strictly, and refuse what cannot be decoded.

    `errors="replace"` is the tempting default and it is lossy in silence: the file comes back with
    U+FFFD where the bytes were, the model edits that version, writes it back, and the corruption
    is now real and attributed to the model. Nothing in the tree, the gates or the log would say
    otherwise.
    """
    raw = path.read_bytes()
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ToolFault("encoding",
                        f"{path.name} is not valid UTF-8 ({error.reason} at byte {error.start}); "
                        "refusing to read it rather than silently replacing characters") from error


def atomic_write(path: pathlib.Path, content: str) -> None:
    """Write via a temporary file and rename, then confirm what landed.

    Two classes closed at once. A process killed mid-write leaves a truncated file that looks
    exactly like a model truncating its own output — the rename makes the write all-or-nothing, so
    that cannot happen. And re-reading afterwards turns "the disk did something else" from an
    invisible corruption into a named fault.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".native-tmp")
    try:
        tmp.write_text(content, encoding="utf-8")
        os.replace(tmp, path)
    except OSError as error:
        tmp.unlink(missing_ok=True)
        raise ToolFault("io", f"could not write {path.name}: {error}") from error

    landed = path.read_text(encoding="utf-8", errors="replace")
    if landed != content:
        raise ToolFault("postcondition",
                        f"{path.name} does not contain what was written "
                        f"({len(content)} bytes requested, {len(landed)} on disk)")


# A syntax checker per extension, run after a write. Each must be a pure parse check that touches
# nothing and returns non-zero on a broken file. Anything absent from the machine is skipped.
SYNTAX_CHECKS = {
    ".php": ["php", "-l"],
    # NOT `python3 -m py_compile`, which writes __pycache__/<name>.pyc next to the file it checks.
    # That would have the gate create the litter it exists to prevent: an unnamed file appearing in
    # the tree, charged to the model, on a plan that never mentioned Python. Verified by running it.
    # `compile()` parses and returns without touching the disk.
    ".py": ["python3", "-c",
            "import sys; compile(open(sys.argv[1]).read(), sys.argv[1], 'exec')"],
    ".sh": ["bash", "-n"],
    ".bash": ["bash", "-n"],
}


def syntax_note(path: pathlib.Path) -> str:
    """Parse what was just written, and say so in the tool result if it is broken.

    This is a POSTCONDITION, not an instruction, and the distinction is the whole point.
    docs/local-models.md records an arm that told the model to run the syntax checker after every
    write: n=20 per side, damage identical at 5/20, 38% slower, 37% more tokens. Instructions are
    not a mechanism. Running the check in the tool is.

    What it targets, from an observed round: forced into whole-file writes, the model rendered its
    addition in DIFF syntax -- every new line prefixed with `+`, the context line with a literal
    space -- and wrote that into the .php file. One parse error at line 67 made every one of the
    nine functional criteria fail, because each one loads the file first. The round scored 2 of 11
    and stayed broken through a second attempt, since nothing told the model the file would not
    parse. It cost 394 seconds and 71 model requests.

    The file is NOT reverted. A write that parses badly may still be most of the work, and the
    model is the thing best placed to fix it -- it just has to be told.
    """
    command = SYNTAX_CHECKS.get(path.suffix)
    if not command or not shutil.which(command[0]):
        return ""
    try:
        done = subprocess.run(command + [str(path)], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        # A checker that will not run is not evidence about the file, so say nothing rather than
        # reporting a syntax error the file may not have.
        return ""
    if done.returncode == 0:
        return ""
    detail = (done.stdout + done.stderr).strip().splitlines()
    return ("\nWARNING: the file does not parse. " +
            (detail[0] if detail else f"{command[0]} exited {done.returncode}") +
            "\nFix it before doing anything else; every check that loads this file will fail.")


def clamp(text: str) -> str:
    if len(text) <= OUTPUT_CAP:
        return text
    return text[:OUTPUT_CAP] + f"\n[... {len(text) - OUTPUT_CAP} bytes truncated]"


def plain(query: str) -> str:
    """The same search, with the regex metacharacters escaped.

    Offered in the error rather than applied silently: a model that meant `moveItem\\(int` gets a
    working alternative to copy, and one that meant a real pattern is not second-guessed.
    """
    return re.sub(r"([(){}\[\].*+?|^$\\])", r"\\\1", query)


def read_window(item: dict, label: str, body: str) -> str:
    """One file, whole or windowed, with a truncation note that names the remedy.

    `start` and `end` are 1-based and inclusive, matching what `search` prints, so a model can
    take a line number straight from a match and read around it.

    The note matters as much as the window. The old one said `[... 18204 bytes truncated]`, which
    tells a model it lost something but not that anything can be done about it — and nothing
    could, so it re-issued the identical call three times over. A truncation notice that does not
    name a remedy trains exactly that loop.
    """
    lines = body.splitlines()
    total = len(lines)
    start, end = item.get("start"), item.get("end")
    windowed = isinstance(start, int) or isinstance(end, int)

    if windowed:
        first = max(1, start if isinstance(start, int) else 1)
        last = min(total, end if isinstance(end, int) else first + READ_WINDOW - 1)
        if first > total:
            return (f"--- {label} ---\n(start {first} is past the end; the file has "
                    f"{total} lines)")
        text = "\n".join(lines[first - 1:last])
        head = f"--- {label} (lines {first}-{last} of {total}) ---"
        note = ""
        if last < total:
            note = f"\n[lines {last + 1}-{total} not shown; read them with start/end]"
        return f"{head}\n{text}{note}"

    if len(body) <= OUTPUT_CAP:
        return f"--- {label} ---\n{body}"

    # Cut on a line boundary so the window's last line is whole, and so the number in the note is
    # a line a follow-up call can actually ask for. The budget is short of OUTPUT_CAP by more than
    # the note's own length, because the note is appended and then the whole result passes through
    # clamp(): filling the cap with content deletes the very sentence that says what to do next.
    # The selftest caught this on the first run, which is the case for writing it first.
    shown, size = 0, 0
    for line in lines:
        if size + len(line) + 1 > OUTPUT_CAP - 700:
            break
        size += len(line) + 1
        shown += 1
    return (f"--- {label} (lines 1-{shown} of {total}) ---\n"
            + "\n".join(lines[:shown])
            + f"\n[{total - shown} more lines. This file is too big to read at once: call "
              f"read_files again with start and end to see any part of it, for example "
              f'{{"path": "{label}", "start": {shown + 1}, "end": {min(total, shown + READ_WINDOW)}}}.'
              f" Line numbers from `search` can be used directly.]")


def run_tool(repo: pathlib.Path, name: str, args: dict) -> str:
    try:
        if name == "read_files":
            out = []
            for item in args.get("files") or []:
                path = resolve(repo, item.get("path", ""))
                if not path.exists():
                    out.append(f"--- {item.get('path')} ---\n(no such file)")
                    continue
                # Deliberately NOT line-numbered. The rented loop returns numbered lines, and a
                # model wrote the gutter back into a file — `  1 | # Add a discount` — corrupting
                # it. Content in, content out.
                out.append(read_window(item, item.get("path"), read_text_strict(path)))
            return clamp("\n\n".join(out) or "(no files requested)")

        if name == "search":
            query = str(args.get("query", ""))
            where = str(args.get("path") or ".")
            proc = subprocess.run(["grep", "-rnE", "--", query, where], cwd=repo,
                                  capture_output=True, text=True, timeout=TOOL_TIMEOUT)
            # grep exits 1 for "no matches" and 2+ for "I could not run that". Collapsing both
            # into "no matches" is how an unbalanced paren in a query — `moveOption(`, an invalid
            # regex — was reported to the model as a definitive absence. It believed it, searched
            # around the answer for ten turns, and never learned the tool had failed. An error
            # returned as a negative result is the same fault this whole harness exists to refuse.
            if proc.returncode >= 2:
                detail = (proc.stderr or "").strip().splitlines()
                return (f"error: the search pattern is not valid: "
                        f"{detail[0] if detail else f'grep exited {proc.returncode}'}\n"
                        f"This is NOT 'no matches' — the search never ran. `query` is a regular "
                        f"expression, so ( ) [ ] . * + ? | need a backslash to be matched "
                        f"literally. This query would work: {plain(query)}")
            return clamp(proc.stdout or f"no matches for {query!r}")

        if name == "write_file":
            path = resolve(repo, args["path"])
            check_writable(repo, path)
            content = args.get("content") or ""
            atomic_write(path, content)
            where = path.relative_to(repo.resolve())
            return (f"wrote {where} ({len(content)} bytes, {content.count(chr(10)) + 1} lines)"
                    + syntax_note(path))

        if name == "replace_in_file":
            path = resolve(repo, args["path"])
            check_writable(repo, path)
            if not path.exists():
                return f"error: {args['path']} does not exist"
            body = read_text_strict(path)
            old = args.get("old") or ""
            hits = body.count(old)
            # Refusing an ambiguous match is the whole value of this tool over a patch grammar:
            # the failure is reported on the turn it happens, not discovered in the diff.
            if hits == 0:
                return f"error: `old` not found in {args['path']}; the file is unchanged"
            if hits > 1:
                return f"error: `old` appears {hits} times in {args['path']}; make it unique"
            atomic_write(path, body.replace(old, args.get("new") or "", 1))
            return f"replaced 1 occurrence in {args['path']}" + syntax_note(path)

        if name == "run_commands":
            out = []
            for command in args.get("commands") or []:
                if FORBIDDEN.search(command):
                    out.append(f"$ {command}\nrefused: the plan forbids git history changes; "
                               "leave every change uncommitted in the working tree\n(exit 1)")
                    continue
                proc = subprocess.run(["bash", "-o", "pipefail", "-c", command], cwd=repo,
                                      capture_output=True, text=True, timeout=TOOL_TIMEOUT)
                body = (proc.stdout or "") + (proc.stderr or "")
                out.append(f"$ {command}\n{body}(exit {proc.returncode})")
            return clamp("\n\n".join(out) or "(no commands)")

    except ToolFault:
        raise
    except subprocess.TimeoutExpired:
        return f"error: {name} timed out after {TOOL_TIMEOUT}s"
    except Exception as error:  # noqa: BLE001 — a tool fault is a result the model must see
        raise ToolFault("io", f"{name} failed: {type(error).__name__}: {error}") from error
    return f"error: unknown tool {name}"


