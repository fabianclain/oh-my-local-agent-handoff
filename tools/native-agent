#!/usr/bin/env python3
"""native-agent — the implementation loop, owned by the harness instead of rented.

    tools/native-agent --repo DIR --schema FILE --result FILE --log FILE \\
        --system TEXT --prompt TEXT [--max-turns 40]

WHY

The harness already owns the plan, the prompt layers, the gates, the verification and the journal.
The loop was the one rented part, and measurement kept arriving at fixes that could not be applied
through it:

  - dropping tools for the report turn measured 100% reporting against 44% with them registered,
    and no client here exposes per-turn tool selection
  - the client's system prompt and 25-tool schema add ~8k tokens to every request, invisible in
    anything it logs, and conversation depth is what correlates with discarded output
  - one round made 117 requests and 143k prompt tokens for a six-file change; that is loop
    granularity, not the model needing 117 turns

This is not a replacement for Cline. It is a second provider, so the two can be compared on the
same plans, and so a bad idea here is reversible.

WHAT IT CONTROLS THAT A CLIENT DOES NOT

  the tool set          five tools, not twenty-five
  the report turn       tools are REMOVED for it, which is the single largest measured effect
  sampling              per turn, not per server
  the turn budget       and what happens when it runs out
  the context           it can refuse to overflow rather than discovering it afterwards

EVENT LOG COMPATIBILITY

The log is written in Cline's event shape on purpose. tools/journal, tools/final-turn-shape and
tools/replay-final-turn all mine that format, and a native loop that logged its own dialect would
silently drop out of every existing measurement.

SAFETY

run_commands executes arbitrary shell in the repository, exactly as the rented loop did. Nothing
here sandboxes that, and the guidance is unchanged: run against a git worktree with its own
database, never a live one.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

# The model's own directory, and the only place outside the plan's file list it may create
# anything. templates/agent-rules.md has said so for a long time; nothing enforced it, and two of
# four `wide` rounds were rejected for writing tmp/test_*.php and verify.sh instead. The tool now
# creates it, names it in its own description, and steers writes there.
SCRATCH = ".handoff/scratch"

# Commands the agent rules forbid, enforced rather than requested. "Do not create git commits, do
# not amend, do not stash, do not run git checkout or git reset" has been in the instructions
# throughout; an instruction is not a mechanism, which round 16 measured at n=20 per arm.
FORBIDDEN = re.compile(
    r"\bgit\s+(commit|push|amend|stash|checkout|reset|rebase|cherry-pick|clean)\b")

TOOL_TIMEOUT = 120
OUTPUT_CAP = 20000
# Held back from the loop so a round that runs long still ends with a report rather than an
# overflow. A usable tree with an account beats a full window every time.
RESERVE_FOR_REPORT = 4096


def emit(log, kind: str, event: dict) -> None:
    log.write(json.dumps({"type": kind, "event": event} if kind == "agent_event" else
                         {"type": kind, **event}) + "\n")
    log.flush()


# ------------------------------------------------------------------------------------------------
# tools


def tool_schemas(include_report: bool, schema: dict) -> list[dict]:
    tools = [
        {"type": "function", "function": {
            "name": "read_files",
            "description": "Read files from the repository.",
            "parameters": {"type": "object", "required": ["files"], "properties": {
                "files": {"type": "array", "items": {"type": "object", "properties": {
                    "path": {"type": "string"}}}}}}}},
        {"type": "function", "function": {
            "name": "search",
            "description": "Search the repository for a regular expression.",
            "parameters": {"type": "object", "required": ["query"], "properties": {
                "query": {"type": "string"}, "path": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "write_file",
            "description": ("Write a file in full. Creates it if absent, replaces it if "
                            f"present. Anything not named by the plan belongs in {SCRATCH}/, "
                            "which is yours and is ignored by the verifier."),
            "parameters": {"type": "object", "required": ["path", "content"], "properties": {
                "path": {"type": "string"}, "content": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "replace_in_file",
            "description": ("Replace one exact occurrence of `old` with `new` in a file. "
                            "Fails if `old` is absent or appears more than once."),
            "parameters": {"type": "object", "required": ["path", "old", "new"], "properties": {
                "path": {"type": "string"}, "old": {"type": "string"}, "new": {"type": "string"}}}}},
        {"type": "function", "function": {
            "name": "run_commands",
            "description": ("Run shell commands in the repository root and return their "
                            "output. git commands that change history are refused."),
            "parameters": {"type": "object", "required": ["commands"], "properties": {
                "commands": {"type": "array", "items": {"type": "string"}}}}}},
    ]
    if include_report:
        tools.append({"type": "function", "function": {
            "name": "submit_report",
            "description": "Submit the completion report. Call this when the work is finished.",
            "parameters": schema}})
    return tools


class ToolFault(Exception):
    """The harness failed, not the model.

    The distinction is the entire point of this layer. Without it every tool-layer defect arrives
    as a rejected round with a damaged tree, indistinguishable from the model writing nonsense —
    which is how six separate instrument faults were attributed to the model in a single day
    before anyone checked. A fault raised here is logged with its own class and says whose it is.
    """

    def __init__(self, kind: str, detail: str) -> None:
        super().__init__(detail)
        self.kind = kind
        self.detail = detail


WRITABLE: set[str] = set()
READONLY: set[str] = set()


def check_writable(repo: pathlib.Path, path: pathlib.Path) -> None:
    """Refuse a write the gates would reject anyway, on the turn it happens.

    Two rules, both already enforced after the fact and both cheaper enforced now:

      - a file under '## Files to read, not modify' must come back byte-identical. A reviewer
        writes the tests before the run and lists them here; editing them is the implementer
        marking its own work, and the round is lost when the gate notices.
      - a file the plan does not name is a scope violation. Two of four `wide` rounds were
        rejected for tmp/test_*.php and verify.sh, one of them with 11 of 11 criteria met.

    Silence when the lists are unknown. A tool that refuses everything because nobody told it what
    was allowed is worse than one that refuses nothing.
    """
    try:
        rel = str(path.relative_to(repo.resolve()))
    except ValueError:
        return
    if rel in READONLY:
        raise ToolFault("scope", f"{rel} is listed under 'Files to read, not modify'; "
                                 "it must come back byte-identical and may not be edited")
    if WRITABLE and rel not in WRITABLE and not rel.startswith(SCRATCH + "/"):
        raise ToolFault("scope", f"{rel} is not in the plan's 'Files to touch'; "
                                 f"put anything else under {SCRATCH}/, which is yours")


def resolve(repo: pathlib.Path, raw: str) -> pathlib.Path:
    """Resolve a model-supplied path, and refuse anything that leaves the repository.

    `repo / path.lstrip("/")` was the previous behaviour and it silently rewrites `/etc/hosts` to
    `<repo>/etc/hosts`, which is not an error and not what was asked — the worst combination. `..`
    escapes were unhandled entirely.
    """
    text = str(raw)
    root = repo.resolve()
    # An absolute path is treated as absolute and then checked, NOT stripped to a relative one.
    # Stripping is what the docstring above warns against and what the first version of this
    # function did anyway: /etc/evil.txt became <repo>/etc/evil.txt and reported success, so the
    # model was told its write landed somewhere it did not.
    candidate = (pathlib.Path(text) if text.startswith("/") else repo / text).resolve()
    if candidate != root and root not in candidate.parents:
        raise ToolFault("scope", f"{text} resolves outside the repository; refusing")
    return candidate


def read_text_strict(path: pathlib.Path) -> str:
    """Decode strictly, and refuse what cannot be decoded.

    `errors="replace"` is the tempting default and it is lossy in silence: the file comes back with
    U+FFFD where the bytes were, the model edits that version, writes it back, and the corruption
    is now real and attributed to the model. Nothing in the tree, the gates or the log would say
    otherwise.
    """
    raw = path.read_bytes()
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ToolFault("encoding",
                        f"{path.name} is not valid UTF-8 ({error.reason} at byte {error.start}); "
                        "refusing to read it rather than silently replacing characters") from error


def atomic_write(path: pathlib.Path, content: str) -> None:
    """Write via a temporary file and rename, then confirm what landed.

    Two classes closed at once. A process killed mid-write leaves a truncated file that looks
    exactly like a model truncating its own output — the rename makes the write all-or-nothing, so
    that cannot happen. And re-reading afterwards turns "the disk did something else" from an
    invisible corruption into a named fault.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".native-tmp")
    try:
        tmp.write_text(content, encoding="utf-8")
        os.replace(tmp, path)
    except OSError as error:
        tmp.unlink(missing_ok=True)
        raise ToolFault("io", f"could not write {path.name}: {error}") from error

    landed = path.read_text(encoding="utf-8", errors="replace")
    if landed != content:
        raise ToolFault("postcondition",
                        f"{path.name} does not contain what was written "
                        f"({len(content)} bytes requested, {len(landed)} on disk)")


def clamp(text: str) -> str:
    if len(text) <= OUTPUT_CAP:
        return text
    return text[:OUTPUT_CAP] + f"\n[... {len(text) - OUTPUT_CAP} bytes truncated]"


def run_tool(repo: pathlib.Path, name: str, args: dict) -> str:
    try:
        if name == "read_files":
            out = []
            for item in args.get("files") or []:
                path = resolve(repo, item.get("path", ""))
                if not path.exists():
                    out.append(f"--- {item.get('path')} ---\n(no such file)")
                    continue
                # Deliberately NOT line-numbered. The rented loop returns numbered lines, and a
                # model wrote the gutter back into a file — `  1 | # Add a discount` — corrupting
                # it. Content in, content out.
                out.append(f"--- {item.get('path')} ---\n{read_text_strict(path)}")
            return clamp("\n\n".join(out) or "(no files requested)")

        if name == "search":
            query = str(args.get("query", ""))
            where = str(args.get("path") or ".")
            proc = subprocess.run(["grep", "-rnE", "--", query, where], cwd=repo,
                                  capture_output=True, text=True, timeout=TOOL_TIMEOUT)
            return clamp(proc.stdout or f"no matches for {query!r}")

        if name == "write_file":
            path = resolve(repo, args["path"])
            check_writable(repo, path)
            content = args.get("content") or ""
            atomic_write(path, content)
            where = path.relative_to(repo.resolve())
            return f"wrote {where} ({len(content)} bytes, {content.count(chr(10)) + 1} lines)"

        if name == "replace_in_file":
            path = resolve(repo, args["path"])
            check_writable(repo, path)
            if not path.exists():
                return f"error: {args['path']} does not exist"
            body = read_text_strict(path)
            old = args.get("old") or ""
            hits = body.count(old)
            # Refusing an ambiguous match is the whole value of this tool over a patch grammar:
            # the failure is reported on the turn it happens, not discovered in the diff.
            if hits == 0:
                return f"error: `old` not found in {args['path']}; the file is unchanged"
            if hits > 1:
                return f"error: `old` appears {hits} times in {args['path']}; make it unique"
            atomic_write(path, body.replace(old, args.get("new") or "", 1))
            return f"replaced 1 occurrence in {args['path']}"

        if name == "run_commands":
            out = []
            for command in args.get("commands") or []:
                if FORBIDDEN.search(command):
                    out.append(f"$ {command}\nrefused: the plan forbids git history changes; "
                               "leave every change uncommitted in the working tree\n(exit 1)")
                    continue
                proc = subprocess.run(["bash", "-o", "pipefail", "-c", command], cwd=repo,
                                      capture_output=True, text=True, timeout=TOOL_TIMEOUT)
                body = (proc.stdout or "") + (proc.stderr or "")
                out.append(f"$ {command}\n{body}(exit {proc.returncode})")
            return clamp("\n\n".join(out) or "(no commands)")

    except ToolFault:
        raise
    except subprocess.TimeoutExpired:
        return f"error: {name} timed out after {TOOL_TIMEOUT}s"
    except Exception as error:  # noqa: BLE001 — a tool fault is a result the model must see
        raise ToolFault("io", f"{name} failed: {type(error).__name__}: {error}") from error
    return f"error: unknown tool {name}"


# ------------------------------------------------------------------------------------------------
# the loop


def dispatch(repo: pathlib.Path, name: str, parsed: dict, call_id: str, log) -> str:
    """Every tool call goes through here, so every tool call is logged the same way.

    Returns what the model is told. Emits two things when the harness is at fault: the usual
    content_end so the trajectory stays readable, tagged with the fault class, AND a separate
    `error` event whose message tools/journal already knows how to classify. Without the second
    one a harness fault is invisible to every aggregate view and shows up only as a worse round.
    """
    started = time.monotonic()
    fault = None
    try:
        result = run_tool(repo, name, parsed)
    except ToolFault as bad:
        fault = bad
        result = f"error: {bad.detail}"

    event = {
        "type": "content_end", "contentType": "tool", "toolName": name,
        "toolCallId": call_id,
        "output": {"query": json.dumps(parsed)[:400], "result": result,
                   "success": fault is None and not result.startswith("error:")},
        "durationMs": int((time.monotonic() - started) * 1000),
    }
    if fault is not None:
        event["fault"] = fault.kind
    emit(log, "agent_event", event)

    if fault is not None:
        # Worded so classify_error in tools/journal maps it to its own bucket rather than keeping
        # it verbatim. "tool-<kind> fault" is the phrase that file matches on.
        emit(log, "agent_event", {"type": "error", "error": {
            "message": f"tool-{fault.kind} fault in {name}: {fault.detail}"}})
    return result


def estimate_tokens(messages: list[dict], tools: list[dict]) -> int:
    """Rough, and deliberately so — 4 characters per token, counted generously."""
    return (sum(len(json.dumps(m)) for m in messages) + len(json.dumps(tools))) // 4


def served_context(host: str, port: int) -> int:
    try:
        with urllib.request.urlopen(f"http://{host}:{port}/props", timeout=10) as response:
            return int(json.loads(response.read())["default_generation_settings"]["n_ctx"])
    except Exception:  # noqa: BLE001 — not knowing is survivable; guessing is not
        return 0


def call_model(host: str, port: int, model: str, messages: list[dict], tools: list[dict],
               temperature: float, timeout: int) -> dict:
    payload = {"model": model, "messages": messages, "stream": False,
               "temperature": temperature}
    if tools:
        payload["tools"] = tools
    request = urllib.request.Request(f"http://{host}:{port}/v1/chat/completions",
                                     data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8", "replace"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", type=pathlib.Path, required=True)
    parser.add_argument("--schema", type=pathlib.Path, required=True)
    parser.add_argument("--result", type=pathlib.Path, required=True)
    parser.add_argument("--log", type=pathlib.Path, required=True)
    parser.add_argument("--system", default="")
    parser.add_argument("--prompt", default="")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8071)
    parser.add_argument("--model", default="gpt-oss-20b")
    parser.add_argument("--temp", type=float, default=0.8)
    parser.add_argument("--max-turns", type=int, default=40)
    # Colon-separated, exported by bin/handoff from tools/plan-files. Empty means "unknown", and
    # unknown must not become "forbidden" — a provider run outside the driver would refuse every
    # write and look like a total failure.
    parser.add_argument("--writable", default="")
    parser.add_argument("--readonly", default="")
    parser.add_argument("--timeout", type=int, default=600)
    args = parser.parse_args()

    WRITABLE.update(p for p in args.writable.split(":") if p)
    READONLY.update(p for p in args.readonly.split(":") if p)
    (args.repo / SCRATCH).mkdir(parents=True, exist_ok=True)

    schema = json.loads(args.schema.read_text())
    messages = [{"role": "system", "content": args.system},
                {"role": "user", "content": args.prompt}]
    totals = {"in": 0, "out": 0}
    report = None
    finish = "completed"

    with args.log.open("a") as log:
        window = served_context(args.host, args.port)
        for turn in range(1, args.max_turns + 1):
            emit(log, "agent_event", {"type": "iteration_start", "iteration": turn})

            # Stop before overflowing rather than discovering it in a server error.
            #
            # This was claimed in the module docstring and not implemented, which is its own small
            # lesson. Leaving room for the report turn matters more than leaving room for one more
            # tool call: a round that stops with a report is usable, and one that dies of overflow
            # is not.
            if window:
                need = estimate_tokens(messages, tool_schemas(True, schema))
                if need > window - RESERVE_FOR_REPORT:
                    emit(log, "agent_event", {"type": "error", "error": {"message": (
                        f"context-budget: conversation is ~{need} tokens against a {window} window; "
                        f"stopping with {RESERVE_FOR_REPORT} reserved for the report")}})
                    finish = "context-budget"
                    break
            try:
                body = call_model(args.host, args.port, args.model, messages,
                                  tool_schemas(True, schema), args.temp, args.timeout)
            except urllib.error.HTTPError as error:
                detail = error.read().decode("utf-8", "replace")[:300]
                emit(log, "agent_event", {"type": "error",
                                          "error": {"message": f"HTTP {error.code}: {detail}"}})
                finish = "error"
                break
            except Exception as error:  # noqa: BLE001
                emit(log, "agent_event", {"type": "error",
                                          "error": {"message": f"{type(error).__name__}: {error}"}})
                finish = "error"
                break

            usage = body.get("usage") or {}
            totals["in"] += usage.get("prompt_tokens") or 0
            totals["out"] += usage.get("completion_tokens") or 0
            emit(log, "agent_event", {"type": "usage",
                                      "inputTokens": usage.get("prompt_tokens"),
                                      "outputTokens": usage.get("completion_tokens"),
                                      "totalInputTokens": totals["in"],
                                      "totalOutputTokens": totals["out"]})

            choice = (body.get("choices") or [{}])[0]
            message = choice.get("message") or {}
            reasoning = message.get("reasoning_content")
            if reasoning:
                emit(log, "agent_event", {"type": "content_end", "contentType": "reasoning",
                                          "reasoning": reasoning})
            text = (message.get("content") or "").strip()
            calls = message.get("tool_calls") or []

            if text:
                emit(log, "agent_event", {"type": "content_end", "contentType": "text",
                                          "text": text})

            if not calls:
                # Nothing called and nothing to execute. The turn is spent; ask for the report
                # below rather than looping on an empty exchange.
                messages.append({"role": "assistant", "content": text or ""})
                break

            messages.append({"role": "assistant", "content": text or "",
                             "tool_calls": calls})
            done = False
            for call in calls:
                function = call.get("function") or {}
                name = function.get("name") or "?"
                raw = function.get("arguments")
                try:
                    parsed = json.loads(raw) if isinstance(raw, str) else (raw or {})
                except ValueError:
                    parsed = {}
                    emit(log, "agent_event", {"type": "error", "error": {
                        "message": f"{name} arguments did not parse as JSON"}})

                if name == "submit_report":
                    report = parsed
                    emit(log, "agent_event", {"type": "content_end", "contentType": "tool",
                                              "toolName": name, "toolCallId": call.get("id"),
                                              "output": {"query": name, "result": "report received",
                                                         "success": True}})
                    done = True
                    break

                result = dispatch(args.repo, name, parsed, call.get("id"), log)
                messages.append({"role": "tool", "tool_call_id": call.get("id"),
                                 "name": name, "content": result})
            if done:
                break
        else:
            finish = "turn-limit"

        # The report turn, asked with NO TOOLS IN SCOPE.
        #
        # This is the whole reason the loop is worth owning. Measured on the shallow fixture:
        # 44% reporting with tools registered, 100% with none. The model diverts because it is
        # asked to attest to work it could still go and check; removing the option removes the
        # temptation without forbidding anything, which is what made tool_choice:"none" produce
        # silence instead of reports.
        if report is None:
            emit(log, "agent_event", {"type": "iteration_start", "iteration": "report"})
            ask = ("The work is finished. Reply with ONLY a JSON object matching this schema, "
                   "as your final message. No prose, no code fence.\n\n"
                   + json.dumps(schema, indent=2))
            try:
                body = call_model(args.host, args.port, args.model,
                                  messages + [{"role": "user", "content": ask}],
                                  [], args.temp, args.timeout)
                final = ((body.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
                emit(log, "agent_event", {"type": "content_end", "contentType": "text",
                                          "text": final})
                match = re.search(r"\{.*\}", final, re.S)
                if match:
                    report = json.loads(match.group(0))
            except Exception as error:  # noqa: BLE001
                emit(log, "agent_event", {"type": "error", "error": {
                    "message": f"report turn: {type(error).__name__}: {error}"}})

        # A round whose conclusion was discarded by the parser and then recovered is not an
        # error round, and labelling it one would send the journal's classifier to the wrong
        # outcome. This happened on the very first native run: four clean tool calls, the work
        # verified, then HTTP 500 "does not match the expected peg-native format" on the turn the
        # model tried to conclude — and the no-tools report turn recovered a complete report.
        # Under the rented loop that round is recorded as patch-ok-no-report.
        if finish == "error" and report is not None:
            finish = "recovered-report"

        emit(log, "run_result", {"finishReason": finish,
                                 "usage": {"inputTokens": totals["in"],
                                           "outputTokens": totals["out"]},
                                 "text": json.dumps(report) if report else ""})

    args.result.write_text(json.dumps(report) if report is not None else "")
    return 0


if __name__ == "__main__":
    sys.exit(main())
