def analysable_args(name: str, parsed: dict) -> dict:
    """The fields an analysis tool needs, without the file contents that force truncation.

    Deliberately narrow. `write_file` carries a whole file in `content` and `replace_in_file`
    carries two fragments of one; none of that tells you anything about how a round spent its
    turns, and including it is what made the logged argument unreadable.
    """
    args: dict = {}
    path = parsed.get("path")
    if isinstance(path, str):
        args["path"] = path
    files = parsed.get("files")
    if isinstance(files, list):
        args["paths"] = [f.get("path") for f in files
                         if isinstance(f, dict) and isinstance(f.get("path"), str)]
        # Whether a read was windowed is the difference between "read the file again" and "read
        # the part it could not reach before". Three rounds of identical whole-file reads looked
        # like ordinary repetition in the logs precisely because this was not recorded.
        windows = [f"{f.get('start', '')}-{f.get('end', '')}" for f in files
                   if isinstance(f, dict) and (f.get("start") or f.get("end"))]
        if windows:
            args["windows"] = windows
    if name in ("search", "search_codebase") and isinstance(parsed.get("query"), str):
        args["query"] = parsed["query"]
    commands = parsed.get("commands")
    if isinstance(commands, list):
        args["commands"] = [str(c) for c in commands]
    return args


# --- the repeat guard ---------------------------------------------------------------------------
#
# A model that asks the same question twice has been told something it cannot use. Three rounds
# against one file made 66 searches and 8 whole-file reads and wrote nothing, and the tell was in
# the arguments the whole time: the identical `read_files` call returning the identical 20,028
# bytes, three times over, and a search for a declaration the tool had already located at line 914.
#
# It is ADVISORY. It never refuses a call and never rewrites one — the model may have a reason, and
# a guard that vetoes on suspicion would break the legitimate case below. All it does is say what
# the harness can see and the model cannot: that this exact call has already been made, and what
# came back.
#
# THE LEGITIMATE REPEAT, which is why this is not a simple counter.
#
# Running the test suite, fixing something, and running it again is the correct behaviour and the
# calls are byte-identical. So a successful WRITE clears the counters: after the tree changes,
# every previous answer is stale and asking again is right. What remains counted is repetition with
# nothing changed in between, which is the only kind that cannot be productive.
#
# The key is the FULL argument string. Only the quoted preview is capped, because a key truncated
# to a preview would collide two different long commands into one false repeat.
REPEAT_THRESHOLDS = (3, 5, 8)
REPEAT_PREVIEW = 300
_repeats: dict[tuple[str, str], list[str]] = {}


def repeat_note(name: str, parsed: dict, result: str) -> str:
    """What to append to this result, if anything. Mutates the repeat chain."""
    if name in ("write_file", "replace_in_file") and not result.startswith("error:"):
        _repeats.clear()          # the tree moved; every earlier answer is now stale
        return ""
    if name == "submit_report":
        return ""

    key = (name, json.dumps(parsed, sort_keys=True, default=str))
    seen = _repeats.setdefault(key, [])
    seen.append(hashlib.sha256(result.encode("utf-8", "replace")).hexdigest())
    count = len(seen)
    if count not in REPEAT_THRESHOLDS:
        return ""

    preview = key[1]
    if len(preview) > REPEAT_PREVIEW:
        preview = preview[:REPEAT_PREVIEW] + "…"
    same = len(set(seen)) == 1
    note = [f"\n\n[harness] This is call {count} of `{name}` with exactly these arguments, "
            f"and nothing has been written since the first one."]
    if same:
        note.append("Every one returned byte-for-byte the same thing, so a further attempt will "
                    "return it again.")
    note.append(f"Arguments: {preview}")
    if count >= REPEAT_THRESHOLDS[-1]:
        note.append("Stop repeating this. If you cannot get what you need from this tool, do the "
                    "work a different way, or finish and record the blocker in your report — an "
                    "honest blocker is a useful result and running out of turns is not.")
    else:
        note.append("If it did not answer your question the first time, a different question or a "
                    "different tool will serve you better than the same one again.")
    return " ".join(note)


def dispatch(repo: pathlib.Path, name: str, parsed: dict, call_id: str, log) -> str:
    """Every tool call goes through here, so every tool call is logged the same way.

    Returns what the model is told. Emits two things when the harness is at fault: the usual
    content_end so the trajectory stays readable, tagged with the fault class, AND a separate
    `error` event whose message tools/journal already knows how to classify. Without the second
    one a harness fault is invisible to every aggregate view and shows up only as a worse round.
    """
    started = time.monotonic()
    fault = None
    try:
        result = run_tool(repo, name, parsed)
    except ToolFault as bad:
        fault = bad
        result = f"error: {bad.detail}"

    event = {
        "type": "content_end", "contentType": "tool", "toolName": name,
        "toolCallId": call_id,
        "output": {"query": json.dumps(parsed)[:400], "result": result,
                   "success": fault is None and not result.startswith("error:")},
        "durationMs": int((time.monotonic() - started) * 1000),
        # `query` is capped at 400 characters so the log stays readable, and that cap silently
        # destroyed a measurement: 15 of 28 run_commands arguments were truncated, so
        # tools/turn-economy reported "0 repeated commands" over a denominator of 13. Absence of
        # data, printed as a finding. This field carries the parts worth analysing -- paths,
        # commands, the search question -- and never file contents, which is what made `query`
        # long in the first place.
        "args": analysable_args(name, parsed),
    }
    if fault is not None:
        event["fault"] = fault.kind
    emit(log, "agent_event", event)

    if fault is not None:
        # Worded so classify_error in tools/journal maps it to its own bucket rather than keeping
        # it verbatim. "tool-<kind> fault" is the phrase that file matches on.
        emit(log, "agent_event", {"type": "error", "error": {
            "message": f"tool-{fault.kind} fault in {name}: {fault.detail}"}})

    # Appended AFTER the event is emitted, so provider.log records what the tool actually returned
    # and every analysis tool built on it keeps measuring the tool rather than the commentary.
    # Only the model sees the note.
    if fault is None:
        return result + repeat_note(name, parsed, result)
    return result


class ReadHistory:
    """Which past tool messages still hold file contents that are current.

    The loop re-sends the whole conversation every turn, and measured over six `wide` rounds tool
    results are 76% of the text it carries — of which 59% of read results had been superseded by a
    later write to the same file. So the model pays for depth, in the one currency that causes its
    dominant failure, to be re-shown the OLD contents of files it has since rewritten. The parse
    fault runs at 0.00% below 8k and 4.0-4.5% between 8k and 32k; nothing else available moves
    depth this much.

    A read message is dropped only when EVERY path it covers has been superseded. `read_files`
    takes a list, and replacing a message because one of its four files was rewritten would throw
    away three that are still current.
    """

    def __init__(self) -> None:
        self.pending: dict[int, set[str]] = {}   # message index -> paths not yet superseded
        self.by_path: dict[str, set[int]] = {}   # path -> message indices mentioning it
        self.covered: dict[int, list[str]] = {}  # message index -> every path it read, for the note

    def record(self, index: int, paths: list[str]) -> None:
        live = {p for p in paths if p}
        if not live:
            return
        self.pending[index] = live
        self.covered[index] = sorted(live)
        for path in live:
            self.by_path.setdefault(path, set()).add(index)

    def supersede(self, path: str) -> list[int]:
        """Note a successful write to `path`. Returns message indices that are now entirely stale."""
        done = []
        for index in sorted(self.by_path.pop(path, set())):
            remaining = self.pending.get(index)
            if remaining is None:
                continue
            remaining.discard(path)
            if not remaining:
                self.pending.pop(index, None)
                done.append(index)
        return done

    def paths_of(self, index: int) -> list[str]:
        return self.covered.get(index, [])


def estimate_tokens(messages: list[dict], tools: list[dict]) -> int:
    """Rough, and deliberately so — 4 characters per token, counted generously."""
    return (sum(len(json.dumps(m)) for m in messages) + len(json.dumps(tools))) // 4


def served_context(host: str, port: int) -> int:
    try:
        with urllib.request.urlopen(f"http://{host}:{port}/props", timeout=10) as response:
            return int(json.loads(response.read())["default_generation_settings"]["n_ctx"])
    except Exception:  # noqa: BLE001 — not knowing is survivable; guessing is not
        return 0



# ------------------------------------------------------------------------------------------------
# harmony, parsed here instead of by the server


# Messages are split on their TERMINATORS, not on `<|start|>`. The model does not always emit
# `<|start|>assistant` between an analysis message and the tool call that follows it, and splitting
# on it merged the two: the tool call ended up inside the analysis body and was lost entirely. That
# cost a live round its report — on the change built to stop losing reports — and the harness saw
# only "submit_report arguments did not parse as JSON".
HARMONY_SPLIT = re.compile(r"<\|end\|>|<\|call\|>|<\|return\|>")
# `to=functions.NAME` is the canonical recipient. The garbled form drops `to=` and puts the name
# straight after a channel token, which is 75 of the 99 discarded completions measured overnight.
RECIPIENT = re.compile(r"(?:to=)?functions\.([A-Za-z_][A-Za-z0-9_]*)")
CHANNEL_NAME = re.compile(r"<\|channel\|>\s*([A-Za-z]+)")


def parse_harmony(text: str) -> dict:
    """Read gpt-oss's harmony output leniently, and return it in OpenAI message shape.

    llama.cpp discards a completion whose header it cannot map, and answers HTTP 500 with the text
    gone. Measured over one night: 99 of 3,131 completions, 3.16%, of which 75 were a header the
    model garbled by one token and 18 were a `final` message tagged `<|constrain|>json`. Both are
    unambiguous to a reader:

        <|channel|>functions.write_file<|channel|>commentary json<|message|>{"path": ...}
        <|channel|>final <|constrain|>json<|message|>{"status": "complete", ...}

    The first is a call to write_file. The second is a final message carrying JSON. Nothing about
    either is genuinely ambiguous — the grammar simply does not admit them, and the round dies for
    it. This parser admits them.

    Deliberately tolerant in exactly three ways, each from an observed failure:
      * the recipient is found anywhere in the header, with or without `to=`
      * `<|constrain|>` and its argument are ignored wherever they appear
      * a repeated `<|channel|>` does not invalidate the header

    Deliberately strict about the one thing that matters: a segment with no `<|message|>` has no
    body, and is dropped rather than guessed at. Reconstructing a truncated tool call is how a
    partial `newString` replaces a file with a valid-looking partial copy, which this project
    declined to do once already.
    """
    calls, reasoning, content = [], [], []
    for chunk in HARMONY_SPLIT.split(text):
        if "<|message|>" not in chunk:
            continue
        header, _, body = chunk.partition("<|message|>")

        recipient = RECIPIENT.search(header)
        channels = CHANNEL_NAME.findall(header)
        channel = next((c for c in channels if c in ("analysis", "commentary", "final")), "")

        if recipient:
            calls.append({"id": f"call-{len(calls) + 1}", "type": "function",
                          "function": {"name": recipient.group(1), "arguments": body.strip()}})
        elif channel == "analysis":
            reasoning.append(body)
        else:
            # `final`, and anything whose channel could not be read. A body that reached here is
            # the model's answer; refusing it because the header was unreadable is the behaviour
            # being replaced.
            content.append(body)

    message = {"role": "assistant", "content": "".join(content).strip()}
    if calls:
        message["tool_calls"] = calls
    if reasoning:
        message["reasoning_content"] = "".join(reasoning).strip()
    return message


def call_model_raw(host: str, port: int, messages: list[dict], tools: list[dict],
                   temperature: float, timeout: int) -> dict:
    """Generate through /completions, with the server's own template but not its parser.

    /apply-template renders exactly the prompt /v1/chat/completions would build, so the prompt is
    not a reimplementation and cannot drift from the server's idea of it. Only the parsing is ours.
    """
    rendered = json.loads(http_post(host, port, "/apply-template",
                                    {"messages": messages, "tools": tools}, timeout))
    body = json.loads(http_post(host, port, "/completions",
                                {"prompt": rendered["prompt"], "n_predict": -1,
                                 "temperature": temperature}, timeout))
    usage = {"prompt_tokens": body.get("tokens_evaluated") or 0,
             "completion_tokens": body.get("tokens_predicted") or 0}
    raw = body.get("content") or ""
    message = parse_harmony(raw)
    # Keep the raw completion whenever the parse produced a tool call whose arguments are not
    # JSON. Owning the parser means owning its failures, and the first round of them was not
    # diagnosable at all: the loop reported "submit_report arguments did not parse as JSON" and
    # the text that caused it was already gone. A parser that cannot be debugged from its own log
    # is worse than the one it replaced.
    for call in message.get("tool_calls") or []:
        try:
            json.loads(call["function"]["arguments"])
        except (ValueError, TypeError):
            message["_raw_harmony"] = raw[-2000:]
            break
    return {"choices": [{"message": message, "finish_reason": "stop"}], "usage": usage}


def http_post(host: str, port: int, path: str, payload: dict, timeout: int) -> bytes:
    request = urllib.request.Request(f"http://{host}:{port}{path}",
                                     data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


RAW_HARMONY = False


def call_model(host: str, port: int, model: str, messages: list[dict], tools: list[dict],
               temperature: float, timeout: int) -> dict:
    # The raw path takes llama.cpp's chat parser off the critical path: same prompt, our parsing.
    if RAW_HARMONY:
        return call_model_raw(host, port, messages, tools, temperature, timeout)
    payload = {"model": model, "messages": messages, "stream": False,
               "temperature": temperature}
    if tools:
        payload["tools"] = tools
    request = urllib.request.Request(f"http://{host}:{port}/v1/chat/completions",
                                     data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8", "replace"))


def _balanced_objects(text: str):
    """Every balanced {...} in `text` that parses to an object, in order of appearance.

    Also descends into string VALUES that themselves contain JSON. That is not defensive
    generality — it is the observed case. See extract_json_object.
    """
    candidates = []
    depth = 0
    start = -1
    in_string = False
    escaped = False
    for index, char in enumerate(text):
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            continue
        if char == '"':
            in_string = True
        elif char == "{":
            if depth == 0:
                start = index
            depth += 1
        elif char == "}":
            if depth:
                depth -= 1
                if depth == 0 and start >= 0:
                    candidates.append(text[start:index + 1])

    for candidate in candidates:
        try:
            parsed = json.loads(candidate)
        except ValueError:
            continue
        if not isinstance(parsed, dict):
            continue
        yield parsed
        for value in parsed.values():
            if isinstance(value, str) and "{" in value:
                yield from _balanced_objects(value)


def extract_json_object(text: str, wanted: "frozenset[str] | set[str] | tuple" = ()):
    """Find the REPORT inside whatever the model actually said.

    `wanted` is the set of keys the report schema declares. Without it this returns the last
    balanced object, which is what it used to do and what is right for a plain answer. With it,
    the candidate carrying the most schema keys wins — and that is the difference between a
    recorded report and `patch-ok-no-report`.

    The case that forced it, from a live round at 16.3k depth. Asked for the report with NO tools
    registered, the model tried to call one anyway and, with no schema for llama.cpp to parse the
    call against, the harmony header arrived as plain text:

        <|channel|>commentary to=functions.write_file<|channel|>json<|message|>
        {"path":"final_report.json","content":"{\\n \\"status\\": \\"complete\\", ...}"}

    The report was complete, correct, and one level down inside `content`. Taking the last
    balanced object took the tool call's ARGUMENTS instead, so the harness stored
    {"path": ..., "content": ...}, found no `status`, and recorded the round as having no report
    although 11 of 11 criteria had passed.

    So: descend into string values, and score candidates by schema keys rather than by position.
    """
    wanted = set(wanted)
    best = None
    best_score = -1
    for candidate in _balanced_objects(text):
        score = len(wanted & set(candidate))
        # >= rather than > so that, on a tie, the LAST match wins: a model that reasons and then
        # answers puts the answer at the end.
        if score >= best_score:
            best, best_score = candidate, score
    return best


def call_model_retrying(host: str, port: int, model: str, messages: list[dict], tools: list[dict],
                        temperature: float, timeout: int, log, where: str) -> dict:
    """Re-ask a completion that llama.cpp refused to parse, instead of losing the round to it.

    The fault is in the serving stack, not in the conversation. The model generated output,
    llama.cpp's harmony parser could not map it to the grammar, and the server answered 500. The
    messages are unchanged and still valid, so re-asking costs one completion — where breaking
    costs every turn the loop had left.

    Measured across the 71 archived runs that existed before this was written:

      * a peg fault ended the provider call in 13 of 13 segments, under this loop AND under Cline.
        Neither retried. Zero tool calls followed the fault in any of them.
      * 22 of 29 runs that hit one ended `patch-ok-no-report`, against 1 of 42 that did not
        (Fisher p = 2.5e-11).

    So this is the mechanism behind the missing reports, and it was previously recorded as the
    model declining to report. It does not decline. It is cut off.

    A retry helps because production runs at temperature 0.8, where re-asking draws a genuinely
    different sample. It will NOT rescue the deterministic repro in docs/local-models.md, which
    reproduces the same malformed harmony under greedy decoding — that one is for upstream.

    Only a 500 naming the peg parser is retried. Every other HTTPError is raised: a 400 means the
    request is wrong and would be wrong again, and retrying an overflow would burn the budget on a
    request that cannot fit.
    """
    for attempt in range(1, PEG_RETRIES + 2):
        try:
            return call_model(host, port, model, messages, tools, temperature, timeout)
        except urllib.error.HTTPError as error:
            detail = error.read().decode("utf-8", "replace")[:300]
            # Logged on every occurrence, recovered or not, so tools/peg-audit and the journal
            # still see the fault rate. The retry event below is what distinguishes a fault that
            # cost the round from one that cost a completion.
            emit(log, "agent_event", {"type": "error",
                                      "error": {"message": f"HTTP {error.code}: {detail}"}})
            if error.code != 500 or PEG_MARKER not in detail or attempt > PEG_RETRIES:
                raise
            emit(log, "agent_event", {"type": "peg_retry", "where": where,
                                      "attempt": attempt, "of": PEG_RETRIES})
    raise AssertionError("unreachable: the loop either returns or raises")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", type=pathlib.Path, required=True)
    parser.add_argument("--schema", type=pathlib.Path, required=True)
    parser.add_argument("--result", type=pathlib.Path, required=True)
    parser.add_argument("--log", type=pathlib.Path, required=True)
    parser.add_argument("--system", default="")
    parser.add_argument("--prompt", default="")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8071)
    parser.add_argument("--model", default="gpt-oss-20b")
    parser.add_argument("--temp", type=float, default=0.8)
    parser.add_argument("--max-turns", type=int, default=40)
    # Colon-separated, exported by bin/handoff from tools/plan-files. Empty means "unknown", and
    # unknown must not become "forbidden" — a provider run outside the driver would refuse every
    # write and look like a total failure.
    # Design variants, so the loop's own choices can be measured instead of assumed. Each is one
    # flag here and a three-line provider overlay, which is the practical benefit of owning the
    # loop: round 15's whole-file question waited months for a benchmark arm and is now a flag.
    parser.add_argument("--no-replace", action="store_true",
                        help="drop replace_in_file, forcing whole-file writes (round 15)")
    parser.add_argument("--no-report-tool", action="store_true",
                        help="no submit_report tool; the report comes from the no-tools final turn")
    parser.add_argument("--raw-harmony", action="store_true",
                        help="generate via /completions and parse harmony here, not in the server")
    parser.add_argument("--prune-superseded", action="store_true",
                        help="replace read results the model has since overwritten (see ReadHistory)")
    parser.add_argument("--report-tool-max-depth", type=int, default=0,
                        help="stop offering submit_report once the conversation exceeds N tokens")
    parser.add_argument("--max-syntax-warnings", type=int, default=0,
                        help="stop the loop after N writes that do not parse, and ask for the report")
    parser.add_argument("--writable", default="")
    parser.add_argument("--readonly", default="")
    parser.add_argument("--timeout", type=int, default=600)
    args = parser.parse_args()

    if args.raw_harmony:
        globals()["RAW_HARMONY"] = True
    if args.no_replace:
        DISABLED.add("replace_in_file")
    if args.no_report_tool:
        DISABLED.add("submit_report")
    WRITABLE.update(p for p in args.writable.split(":") if p)
    READONLY.update(p for p in args.readonly.split(":") if p)
    (args.repo / SCRATCH).mkdir(parents=True, exist_ok=True)

    schema = json.loads(args.schema.read_text())
    # The keys that identify a report, used to tell it apart from any other JSON object in the
    # model's final message — a tool call's arguments, most importantly. See extract_json_object.
    report_keys = set(schema.get("properties") or {}) | set(schema.get("required") or [])
    messages = [{"role": "system", "content": args.system},
                {"role": "user", "content": args.prompt}]
    totals = {"in": 0, "out": 0}
    report = None
    finish = "completed"
    history = ReadHistory()
    pruned = 0
    warnings = 0
    depth = 0

    with args.log.open("a") as log:
        window = served_context(args.host, args.port)
        for turn in range(1, args.max_turns + 1):
            emit(log, "agent_event", {"type": "iteration_start", "iteration": turn})

            # Stop before overflowing rather than discovering it in a server error.
            #
            # This was claimed in the module docstring and not implemented, which is its own small
            # lesson. Leaving room for the report turn matters more than leaving room for one more
            # tool call: a round that stops with a report is usable, and one that dies of overflow
            # is not.
            # The report tool costs 606 tokens in every request and, on `wide`, was used once in
            # twelve rounds — roughly 24k prompt tokens per round for a tool the model does not
            # reach for at that depth. It IS used shallow: 4 of 8 semantic rounds at ~8k. So offer
            # it while the conversation is short and drop it once it is not, rather than choosing
            # one of the two globally. --report-tool-max-depth 0 keeps the old behaviour.
            offer_report = not (args.report_tool_max_depth
                                and depth > args.report_tool_max_depth)
            if window:
                need = estimate_tokens(messages, tool_schemas(offer_report, schema))
                if need > window - RESERVE_FOR_REPORT:
                    emit(log, "agent_event", {"type": "error", "error": {"message": (
                        f"context-budget: conversation is ~{need} tokens against a {window} window; "
                        f"stopping with {RESERVE_FOR_REPORT} reserved for the report")}})
                    finish = "context-budget"
                    break
            try:
                body = call_model_retrying(args.host, args.port, args.model, messages,
                                           tool_schemas(offer_report, schema), args.temp,
                                           args.timeout,
                                           log, f"turn-{turn}")
            except urllib.error.HTTPError:
                # call_model_retrying has already logged the body and exhausted any retry the
                # fault was eligible for.
                finish = "error"
                break
            except Exception as error:  # noqa: BLE001
                emit(log, "agent_event", {"type": "error",
                                          "error": {"message": f"{type(error).__name__}: {error}"}})
                finish = "error"
                break

            usage = body.get("usage") or {}
            depth = usage.get("prompt_tokens") or depth
            totals["in"] += usage.get("prompt_tokens") or 0
            totals["out"] += usage.get("completion_tokens") or 0
            emit(log, "agent_event", {"type": "usage",
                                      "inputTokens": usage.get("prompt_tokens"),
                                      "outputTokens": usage.get("completion_tokens"),
                                      "totalInputTokens": totals["in"],
                                      "totalOutputTokens": totals["out"]})

            choice = (body.get("choices") or [{}])[0]
            message = choice.get("message") or {}
            reasoning = message.get("reasoning_content")
            if reasoning:
                emit(log, "agent_event", {"type": "content_end", "contentType": "reasoning",
                                          "reasoning": reasoning})
            if message.get("_raw_harmony"):
                emit(log, "agent_event", {"type": "error", "error": {"message": (
                    "raw-harmony: a tool call parsed with non-JSON arguments; tail of the "
                    f"completion: {message['_raw_harmony'][-600:]!r}")}})
            text = (message.get("content") or "").strip()
            calls = message.get("tool_calls") or []

            if text:
                emit(log, "agent_event", {"type": "content_end", "contentType": "text",
                                          "text": text})

            if not calls:
                # Nothing called and nothing to execute. The turn is spent; ask for the report
                # below rather than looping on an empty exchange.
                messages.append({"role": "assistant", "content": text or ""})
                break

            # The arguments go back to the server on every later render, and /apply-template
            # VALIDATES them: one malformed argument returns HTTP 500 and poisons every subsequent
            # request in the round, not just the turn that produced it. Observed on the raw path,
            # where a tool call whose body was not valid JSON killed an attempt that had already
            # met every criterion. What the tool actually ran is unaffected — `parsed` below is
            # taken from the raw text; this only sanitises the copy kept for context.
            history_calls = []
            for call in calls:
                function = dict(call.get("function") or {})
                raw_args = function.get("arguments")
                try:
                    json.loads(raw_args if isinstance(raw_args, str) else json.dumps(raw_args))
                except (ValueError, TypeError):
                    function["arguments"] = "{}"
                history_calls.append({**call, "function": function})
            messages.append({"role": "assistant", "content": text or "",
                             "tool_calls": history_calls})
            done = False
            for call in calls:
                function = call.get("function") or {}
                name = function.get("name") or "?"
                raw = function.get("arguments")
                try:
                    parsed = json.loads(raw) if isinstance(raw, str) else (raw or {})
                except ValueError:
                    parsed = {}
                    emit(log, "agent_event", {"type": "error", "error": {
                        "message": f"{name} arguments did not parse as JSON"}})

                if name == "submit_report":
                    report = parsed
                    emit(log, "agent_event", {"type": "content_end", "contentType": "tool",
                                              "toolName": name, "toolCallId": call.get("id"),
                                              "output": {"query": name, "result": "report received",
                                                         "success": True}})
                    done = True
                    break

                result = dispatch(args.repo, name, parsed, call.get("id"), log)
                messages.append({"role": "tool", "tool_call_id": call.get("id"),
                                 "name": name, "content": result})

                if args.prune_superseded:
                    where = analysable_args(name, parsed)
                    touched = ([where["path"]] if isinstance(where.get("path"), str) else []) \
                        + [p for p in (where.get("paths") or []) if isinstance(p, str)]
                    if name in ("read_files", "read_file"):
                        history.record(len(messages) - 1, touched)
                    elif name in ("write_file", "replace_in_file") \
                            and not result.startswith("error:"):
                        for path in touched:
                            for index in history.supersede(path):
                                covered = history.paths_of(index)
                                messages[index]["content"] = SUPERSEDED.format(
                                    paths=", ".join(covered), this=path, turn=turn)
                                pruned += 1
                                emit(log, "agent_event", {
                                    "type": "prune", "turn": turn, "message": index,
                                    "paths": covered, "superseded_by": path})

                if result.count("WARNING: the file does not parse"):
                    warnings += 1
                    # A round that writes unparseable files repeatedly is already lost: measured
                    # over 36 rounds, one or two such writes ended 14/14 accepted and three or
                    # more ended 1 accepted against 2 failed. Stopping here spends the remaining
                    # budget on a report instead of on more of the same.
                    if args.max_syntax_warnings and warnings >= args.max_syntax_warnings:
                        emit(log, "agent_event", {"type": "error", "error": {"message": (
                            f"syntax-budget: {warnings} unparseable writes; stopping the loop "
                            "and asking for the report")}})
                        finish = "syntax-budget"
                        done = True
                        break
            if done:
                break
        else:
            finish = "turn-limit"

        # The report turn, asked with NO TOOLS IN SCOPE.
        #
        # This is the whole reason the loop is worth owning. Measured on the shallow fixture:
        # 44% reporting with tools registered, 100% with none. The model diverts because it is
        # asked to attest to work it could still go and check; removing the option removes the
        # temptation without forbidding anything, which is what made tool_choice:"none" produce
        # silence instead of reports.
        # The 100% was measured on a SHALLOW fixture, and it does not survive depth. Audited over
        # the first native rounds: below ~9k the model reports through the tool and this turn is
        # never reached, but on `wide` at 14–25k the tool goes unused, this turn is reached every
        # time, and it failed in three of four — one empty response, one truncated mid-reasoning,
        # one 62 characters of prose. So it is asked up to REPORT_ATTEMPTS times, and every attempt
        # is logged with what came back and why it was rejected.
        #
        # Nothing here reduces the reasoning effort, which is the obvious lever and a disproved
        # one: docs/local-models.md records missing finals at 33% on `low` against 40% on `off`.
        for attempt in range(1, REPORT_ATTEMPTS + 1):
            if report is not None:
                break
            emit(log, "agent_event", {"type": "iteration_start",
                                      "iteration": "report" if attempt == 1 else
                                      f"report-{attempt}"})
            ask = ("The work is finished. Reply with ONLY a JSON object matching this schema, "
                   "as your final message. No prose, no code fence.\n\n"
                   + json.dumps(schema, indent=2))
            if attempt > 1:
                # Say what was wrong with the last answer. An empty response and a page of
                # reasoning are different failures and the same instruction does not fix both.
                ask += ("\n\nYour previous reply did not contain a JSON object. Do not explain, "
                        "do not reason, do not restate the work. Emit the object and nothing "
                        "else, beginning with { and ending with }.")
            try:
                body = call_model_retrying(args.host, args.port, args.model,
                                           messages + [{"role": "user", "content": ask}],
                                           [], args.temp, args.timeout, log,
                                           f"report-{attempt}")
                choice = (body.get("choices") or [{}])[0]
                final = (choice.get("message") or {}).get("content") or ""
                usage = body.get("usage") or {}
                emit(log, "agent_event", {"type": "content_end", "contentType": "text",
                                          "text": final})
                # Without this the report turn is a black box, which is exactly how "100%" went
                # unchallenged: a truncated answer and a refusal look identical from outside.
                emit(log, "agent_event", {
                    "type": "report_turn", "attempt": attempt,
                    "finishReason": choice.get("finish_reason"),
                    "chars": len(final),
                    "inputTokens": usage.get("prompt_tokens"),
                    "outputTokens": usage.get("completion_tokens")})
                totals["in"] += usage.get("prompt_tokens") or 0
                totals["out"] += usage.get("completion_tokens") or 0
                report = extract_json_object(final, report_keys)
                if report is None:
                    emit(log, "agent_event", {"type": "error", "error": {"message": (
                        f"report turn {attempt}: no JSON object in "
                        f"{len(final)} chars (finish_reason="
                        f"{choice.get('finish_reason')})")}})
            except Exception as error:  # noqa: BLE001
                emit(log, "agent_event", {"type": "error", "error": {
                    "message": f"report turn: {type(error).__name__}: {error}"}})
                break

        # A round whose conclusion was discarded by the parser and then recovered is not an
        # error round, and labelling it one would send the journal's classifier to the wrong
        # outcome. This happened on the very first native run: four clean tool calls, the work
        # verified, then HTTP 500 "does not match the expected peg-native format" on the turn the
        # model tried to conclude — and the no-tools report turn recovered a complete report.
        # Under the rented loop that round is recorded as patch-ok-no-report.
        if finish == "error" and report is not None:
            finish = "recovered-report"

        if pruned or warnings:
            emit(log, "agent_event", {"type": "loop_stats", "pruned": pruned,
                                      "syntaxWarnings": warnings, "finalDepth": depth})
        emit(log, "run_result", {"finishReason": finish,
                                 "usage": {"inputTokens": totals["in"],
                                           "outputTokens": totals["out"]},
                                 "text": json.dumps(report) if report else ""})

    args.result.write_text(json.dumps(report) if report is not None else "")
    return 0


if __name__ == "__main__":
    sys.exit(main())
