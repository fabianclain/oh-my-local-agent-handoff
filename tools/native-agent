#!/usr/bin/env python3
"""native-agent — the implementation loop, owned by the harness instead of rented.

    tools/native-agent --repo DIR --schema FILE --result FILE --log FILE \\
        --system TEXT --prompt TEXT [--max-turns 40]

WHY

The harness already owns the plan, the prompt layers, the gates, the verification and the journal.
The loop was the one rented part, and measurement kept arriving at fixes that could not be applied
through it:

  - dropping tools for the report turn measured 100% reporting against 44% with them registered,
    and no client here exposes per-turn tool selection
  - the client's system prompt and 25-tool schema add ~8k tokens to every request, invisible in
    anything it logs, and conversation depth is what correlates with discarded output
  - one round made 117 requests and 143k prompt tokens for a six-file change; that is loop
    granularity, not the model needing 117 turns

This is not a replacement for Cline. It is a second provider, so the two can be compared on the
same plans, and so a bad idea here is reversible.

WHAT IT CONTROLS THAT A CLIENT DOES NOT

  the tool set          five tools, not twenty-five
  the report turn       tools are REMOVED for it, which is the single largest measured effect
  sampling              per turn, not per server
  the turn budget       and what happens when it runs out
  the context           it can refuse to overflow rather than discovering it afterwards

EVENT LOG COMPATIBILITY

The log is written in Cline's event shape on purpose. tools/journal, tools/final-turn-shape and
tools/replay-final-turn all mine that format, and a native loop that logged its own dialect would
silently drop out of every existing measurement.

SAFETY

run_commands executes arbitrary shell in the repository, exactly as the rented loop did. Nothing
here sandboxes that, and the guidance is unchanged: run against a git worktree with its own
database, never a live one.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

# The model's own directory, and the only place outside the plan's file list it may create
# anything. templates/agent-rules.md has said so for a long time; nothing enforced it, and two of
# four `wide` rounds were rejected for writing tmp/test_*.php and verify.sh instead. The tool now
# creates it, names it in its own description, and steers writes there.
SCRATCH = ".handoff/scratch"

# Commands the agent rules forbid, enforced rather than requested. "Do not create git commits, do
# not amend, do not stash, do not run git checkout or git reset" has been in the instructions
# throughout; an instruction is not a mechanism, which round 16 measured at n=20 per arm.
FORBIDDEN = re.compile(
    r"\bgit\s+(commit|push|amend|stash|checkout|reset|rebase|cherry-pick|clean)\b")

TOOL_TIMEOUT = 120
OUTPUT_CAP = 20000
# A file bigger than the cap is not readable in one call, and for three rounds there was no second
# call that could reach the rest of it: `read_files` took a path and nothing else, so every byte
# past OUTPUT_CAP was unreachable by any tool the model had. A 1,052-line component whose insertion
# anchors sat at lines 871 and 914 cost three rounds and ~25 minutes of GPU to an unsatisfiable
# loop — 66 searches, 8 whole-file reads, 0 writes — while the model's own reasoning asked for the
# thing that did not exist: "let's open around 860-900 lines again". `start`/`end` are that thing.
READ_WINDOW = 400
# Held back from the loop so a round that runs long still ends with a report rather than an
# overflow. A usable tree with an account beats a full window every time.
RESERVE_FOR_REPORT = 4096

# How many times to re-ask a completion llama.cpp could not parse. See call_model_retrying for the
# evidence; three is chosen because the fault ran at roughly 1% per completion, so a second failure
# on the same turn is already unlikely and a third is not worth waiting for.
PEG_RETRIES = 3
# The server's own words for the fault, from the 500 body:
#   "The model produced output that does not match the expected peg-native format"
# Matching the parser's name rather than the sentence, which upstream may reword.
PEG_MARKER = "peg-native"
# How many times to ask for the report when the answer carries no JSON object. Two, because the
# second ask says what was wrong with the first and a third has nothing new to add.
REPORT_ATTEMPTS = 2

# What a pruned read result is replaced with. It says the content is gone and how to get it back,
# because a model that does not know it may re-read will work from memory instead.
SUPERSEDED = ("[the earlier contents of {paths} are omitted here: you rewrote {this} at turn "
              "{turn}, so what was read is no longer what is on disk. Read the file again if you "
              "need its current contents.]")


def emit(log, kind: str, event: dict) -> None:
    log.write(json.dumps({"type": kind, "event": event} if kind == "agent_event" else
                         {"type": kind, **event}) + "\n")
    log.flush()


