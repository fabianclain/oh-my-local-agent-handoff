#!/usr/bin/env bash
#
# selftest-all — is anything broken?
#
#   tools/selftest-all
#
# Every suite here, and no GPU. Run it before trusting a change and before shipping one; each
# suite's checks are failures that actually happened, not hypotheticals.
#
#   smoke-e2e            the whole journey — init, check, do, verify, diff — and the state it leaves
#   harness-selftest     bench/run end to end, against a provider that runs no model
#   verifier-selftest    verify-round and bin/handoff — the parts real use touches
#   refuse-destructive-selftest  the commands an acceptance criterion may never contain, and the
#                        ordinary ones it must never refuse
#   sequence-selftest    the advance loop: what it commits, and what it refuses to commit
#   blade-balance-selftest  every Blade control directive closed by its own closer — the gap that
#                        cost a round, invisible to php -l and to the HTML tag check
#   invisible-characters-selftest  characters that are not the character they look like. A U+2011
#                        shipped twice, in rounds accepted 10/10 and 16/16
#   process-commentary-selftest  comments about the edit rather than the code. Every plan forbids
#                        them in prose; prose is not a control
#   feedback-selftest    what a repair attempt is told
#   patch-shape-selftest the order and hunk-count checks
#   shim-selftest        the tool-call shim (needs no model either)
#   native-retry-selftest the native loop against a scripted server that returns parse faults
#   native-tools-selftest can the model reach a file past the read cap, and is a failed search
#                         reported as a failure rather than as an absence
#   turn-economy-selftest the redundancy counters, against a log built to trip them
#   report-audit-selftest which channel each round's report came through, and why not
#   journal-selftest      the two columns a person reads: files touched, and errors
#   roundup-selftest      what the round-up states, and what it refuses to state
#   plan-lint-selftest    every plan-linter check, from both sides
#   view-selftest         the contrast and markup gates, against the page they come from
#   site-audit-selftest   every structural gate of the site plan, each mutation-tested
#   overnight-selftest    the queue runner: resume, deadline, timeout, orphans
#   docblock-anchor-selftest  an edit that steals a docblock, which parses cleanly
#   repeat-guard-selftest     the model is told when it is asking the same question again, and
#                             NOT told when a test re-run after an edit repeats legitimately
#   repair-provenance-selftest  when the harness repairs a report, the log says so — and when it
#                             repairs nothing, the log stays silent
#   schema-typedef-selftest   the report schema rendered small — and every name, enum value and
#                             description still present, which is what makes it a saving
#   harmony-render-selftest   the prompt OpenAI's renderer builds: nested tool types kept, tool
#                             results unescaped, and everything the control says still said
#   schema-grammar-selftest   a GBNF from the report schema: one root, no dangling rules, legal
#                             names, and a REFUSAL for every construct it cannot express
#   peg-capture-selftest      each round keeps the completions llama.cpp discarded, attributed to
#                             the right round, and refuses when the log rotated under it
#   dossier-verify-selftest   the gate on a survey: every fabrication shape it claims to
#                             catch, mutation-tested one field at a time from an honest dossier
#   usage-selftest            the machine-wide usage ledger: written outside every repo, read
#                             back when the repo is gone, and never counted twice when it is not
#   queue-selftest            the GPU lock, the position/estimate register, and the spool
#   answerability-selftest    every gate's three exit codes: holds, does not hold, could not tell.
#                             The third is the one five separate tools got wrong
#
# Then two consistency checks the suites cannot make individually.
#
# smoke-e2e runs first and takes two seconds. It is the one to read when something is broken: the
# others tell you a unit misbehaves, it tells you the pieces are no longer wired together.
#
# Then a consistency check the suites cannot make individually: that tools/check-plan still agrees
# with bench/run about which plans are valid. Those two parse plans with expressions copied
# character for character, and the copy is the risk.

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
cd "$REPO"
FAILED=()

for suite in smoke-e2e harness-selftest verifier-selftest refuse-destructive-selftest sequence-selftest blade-balance-selftest invisible-characters-selftest process-commentary-selftest feedback-selftest patch-shape-selftest shim-selftest native-retry-selftest native-tools-selftest turn-economy-selftest report-audit-selftest journal-selftest roundup-selftest plan-lint-selftest view-selftest site-audit-selftest overnight-selftest docblock-anchor-selftest repeat-guard-selftest repair-provenance-selftest schema-typedef-selftest harmony-render-selftest schema-grammar-selftest peg-capture-selftest usage-selftest queue-selftest answerability-selftest dossier-verify-selftest; do
    # Suites live in tools/, except the ones that test a bench fixture and belong beside it.
    # Resolving only tools/ made a real suite report `SKIP (missing)` — which this file's own next
    # comment calls the failure it exists to avoid, one line before failing to avoid it.
    path=""
    for candidate in "$HERE/$suite" "$REPO/bench/checks/$suite"; do
        [[ -x "$candidate" ]] && { path="$candidate"; break; }
    done
    [[ -n "$path" ]] || { echo "SKIP  $suite (missing)"; continue; }
    printf '%-24s ' "$suite"
    out="$(timeout 900 "$path" 2>&1)"; rc=$?
    # Exit 2 means a suite could not run at all — a missing interpreter, not a broken harness.
    # Reporting that as a pass would convert "nothing was checked" into apparent evidence, which
    # is the exact failure the verifier's `skipped` status exists to avoid.
    if [[ "$rc" -eq 0 ]]; then
        echo "pass"
    elif [[ "$rc" -eq 2 ]]; then
        echo "SKIP  ($(tail -1 <<<"$out"))"
    else
        echo "FAIL"
        FAILED+=("$suite")
        sed 's/^/      /' <<<"$out" | grep -E "FAIL|check\(s\) failed" | head -6
    fi
done

printf '%-24s ' "plan-parser agreement"
# The invariant: the three pattern literals that decide how a plan is read are the same text in
# bench/run and tools/check-plan. A checker that parsed plans its own way could approve a plan the
# harness refuses, which is worse than no checker.
#
# Compare the literals, not whole lines. The first version of this check grepped for the heading
# and swept up error messages that merely mention it, then reported drift that did not exist.
MISMATCH=0
extract() {  # $1=file  $2=extended regex for the literal
    grep -oE "$2" "$1" | tr -d '[:space:]' | sort -u
}
check_literal() {
    local label="$1" pattern="$2"
    local a b
    a="$(extract bench/run "$pattern")"
    b="$(extract tools/check-plan "$pattern")"
    if [[ -z "$a" || -z "$b" ]]; then
        echo; echo "      MISSING the $label pattern in $( [[ -z "$a" ]] && echo bench/run || echo tools/check-plan )"
        MISMATCH=1
    elif [[ "$a" != "$b" ]]; then
        echo; echo "      DRIFTED: $label"
        diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | sed 's/^/        /' | head -4
        MISMATCH=1
    fi
}
check_literal "the Verification heading"   '/\^## Verification\([^/]*\)?\[\[:space:\]\]\*\$/'
check_literal "the Files-to-touch heading" '/\^## Files to touch\[\[:space:\]\]\*\$/'
check_literal "the criteria pattern"       "\^- \\\\\[ \\\\\]"
if [[ "$MISMATCH" -eq 0 ]]; then echo "pass"; else echo "FAIL"; FAILED+=("plan-parser agreement"); fi

printf '%-24s ' "lock-path agreement"
# The invariant: every place that takes, waits on, or probes the serialising lock names the SAME
# file. bench/run and bin/handoff were unified onto one lock and four other sites were left on the
# retired name -- two runtime guards (sync-bench-clone, capture-cline-wire) that could therefore
# never refuse, and two operator instructions telling a future session to probe a lock nobody
# takes. A guard that cannot fail is worse than no guard.
#
# Stated as agreement rather than as a blacklist of the old name, for two reasons. A blacklist
# cannot see a THIRD name being introduced, which is the same defect again. And it cannot tell a
# live reference from a comment explaining the history -- the first draft of this check failed on
# three files that merely describe the change, which is precisely the mistake the plan-parser
# check above already records against itself.
#
# Comments are stripped, so prose about the retired lock is free; only executable references count.
NAMES="$(grep -rhoE '^[^#]*agent-handoff-[a-z]+\.lock' --exclude-dir=.git --exclude=selftest-all . 2>/dev/null \
         | grep -oE 'agent-handoff-[a-z]+\.lock' | sort -u)"
if [[ -z "$NAMES" ]]; then
    echo "FAIL"; echo "      no lock reference found at all -- this check is no longer looking at anything"
    FAILED+=("lock-path agreement")
elif [[ "$(wc -l <<<"$NAMES")" -ne 1 ]]; then
    echo "FAIL"
    echo "      the serialising lock is referred to by more than one name, so at least one"
    echo "      guard is watching a file nobody locks:"
    sed 's/^/        /' <<<"$NAMES"
    grep -rnE "^[^#]*agent-handoff-[a-z]+\.lock" --exclude-dir=.git --exclude=selftest-all . 2>/dev/null \
        | sed 's/^/        /' | head -8
    FAILED+=("lock-path agreement")
else
    echo "pass ($NAMES)"
fi

echo
if (( ${#FAILED[@]} )); then
    echo "BROKEN: ${FAILED[*]}"
    exit 1
fi
echo "everything passes"
