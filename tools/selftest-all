#!/usr/bin/env bash
#
# selftest-all — is anything broken?
#
#   tools/selftest-all
#
# Every suite here, and no GPU. Run it before trusting a change and before shipping one; each
# suite's checks are failures that actually happened, not hypotheticals.
#
#   smoke-e2e            the whole journey — init, check, do, verify, diff — and the state it leaves
#   harness-selftest     bench/run end to end, against a provider that runs no model
#   verifier-selftest    verify-round and bin/handoff — the parts real use touches
#   feedback-selftest    what a repair attempt is told
#   patch-shape-selftest the order and hunk-count checks
#   shim-selftest        the tool-call shim (needs no model either)
#   native-retry-selftest the native loop against a scripted server that returns parse faults
#   turn-economy-selftest the redundancy counters, against a log built to trip them
#   report-audit-selftest which channel each round's report came through, and why not
#   journal-selftest      the two columns a person reads: files touched, and errors
#
# smoke-e2e runs first and takes two seconds. It is the one to read when something is broken: the
# others tell you a unit misbehaves, it tells you the pieces are no longer wired together.
#
# Then a consistency check the suites cannot make individually: that tools/check-plan still agrees
# with bench/run about which plans are valid. Those two parse plans with expressions copied
# character for character, and the copy is the risk.

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
cd "$REPO"
FAILED=()

for suite in smoke-e2e harness-selftest verifier-selftest feedback-selftest patch-shape-selftest shim-selftest native-retry-selftest turn-economy-selftest report-audit-selftest journal-selftest; do
    [[ -x "$HERE/$suite" ]] || { echo "SKIP  $suite (missing)"; continue; }
    printf '%-24s ' "$suite"
    out="$(timeout 900 "$HERE/$suite" 2>&1)"; rc=$?
    # Exit 2 means a suite could not run at all — a missing interpreter, not a broken harness.
    # Reporting that as a pass would convert "nothing was checked" into apparent evidence, which
    # is the exact failure the verifier's `skipped` status exists to avoid.
    if [[ "$rc" -eq 0 ]]; then
        echo "pass"
    elif [[ "$rc" -eq 2 ]]; then
        echo "SKIP  ($(tail -1 <<<"$out"))"
    else
        echo "FAIL"
        FAILED+=("$suite")
        sed 's/^/      /' <<<"$out" | grep -E "FAIL|check\(s\) failed" | head -6
    fi
done

printf '%-24s ' "plan-parser agreement"
# The invariant: the three pattern literals that decide how a plan is read are the same text in
# bench/run and tools/check-plan. A checker that parsed plans its own way could approve a plan the
# harness refuses, which is worse than no checker.
#
# Compare the literals, not whole lines. The first version of this check grepped for the heading
# and swept up error messages that merely mention it, then reported drift that did not exist.
MISMATCH=0
extract() {  # $1=file  $2=extended regex for the literal
    grep -oE "$2" "$1" | tr -d '[:space:]' | sort -u
}
check_literal() {
    local label="$1" pattern="$2"
    local a b
    a="$(extract bench/run "$pattern")"
    b="$(extract tools/check-plan "$pattern")"
    if [[ -z "$a" || -z "$b" ]]; then
        echo; echo "      MISSING the $label pattern in $( [[ -z "$a" ]] && echo bench/run || echo tools/check-plan )"
        MISMATCH=1
    elif [[ "$a" != "$b" ]]; then
        echo; echo "      DRIFTED: $label"
        diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | sed 's/^/        /' | head -4
        MISMATCH=1
    fi
}
check_literal "the Verification heading"   '/\^## Verification\([^/]*\)?\[\[:space:\]\]\*\$/'
check_literal "the Files-to-touch heading" '/\^## Files to touch\[\[:space:\]\]\*\$/'
check_literal "the criteria pattern"       "\^- \\\\\[ \\\\\]"
if [[ "$MISMATCH" -eq 0 ]]; then echo "pass"; else echo "FAIL"; FAILED+=("plan-parser agreement"); fi

echo
if (( ${#FAILED[@]} )); then
    echo "BROKEN: ${FAILED[*]}"
    exit 1
fi
echo "everything passes"
