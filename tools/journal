#!/usr/bin/env python3
"""journal — what the local model did, per run, kept where you can query it later.

    tools/journal record --run-dir DIR --slug SLUG ...   append a record (called by bin/handoff)
    tools/journal list [--slug S] [--limit N]            one line per run, newest last
    tools/journal show <run-id|slug>                     everything recorded about one run
    tools/journal stats [--json]                         aggregate across runs
    tools/journal export-sqlite [path]                   build a queryable .db from the records
    tools/journal retro-prompt <run-id>                  the prompt that asks the model to reflect
    tools/journal attach <run-id> --retro FILE           store that reflection against the run

Why this exists
---------------
Seven rounds of one real feature left three surviving logs. `.handoff/runs/<slug>` is reused, so
each round overwrote the one before it, and by the time anyone wrote the round up the evidence for
four of them was gone. The single most useful diagnostic in this project — comparing a round with
the round before it — was impossible on the runs that most needed it.

So: every run appends one immutable record here, and its artifacts are copied aside before the next
round can overwrite them.

Storage is JSON Lines, one object per run, and that is deliberate. It needs no daemon, no schema
migration and no dependency beyond python3; it is append-safe under concurrent runs; and `grep`,
`jq` and `git diff` all work on it. SQLite is offered as a *derived view* — `export-sqlite` rebuilds
it from the records in a second — rather than as the source of truth, because a corrupted source of
truth is exactly the failure that motivated this file.

What is recorded, and what is not
---------------------------------
Everything here is measured from the tree, the evidence bundle and the provider's own event stream.
The model's completion report is stored, but only as an object of study: it is recorded next to the
tree so the two can be compared, never used to decide what happened. Three runs in this project
reported success over trees they had not touched.
"""

from __future__ import annotations

import argparse
import collections
import gzip
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

SCHEMA_VERSION = 1


# --------------------------------------------------------------------------------------------
# paths


def usage_ledger() -> Path:
    """The machine-wide record of what the local model has spent.

    The per-repository journal is the authority on a ROUND -- it sits beside the artifacts it
    describes and is read by everything that reasons about outcomes. It is a poor authority on
    USAGE over time, for one reason: it lives inside the repository, so deleting a worktree
    deletes its history. Six projects on this machine hold the only copy of their own token
    counts, and a `git worktree remove` takes one of them with it.

    So each round also appends a small line here, outside every repository. Usage only: no
    outcome, no gates, no report. Those belong with the artifacts and are not what survives.

    Under XDG state rather than ~/.cache, deliberately: a cache is by definition safe for anything
    to delete, and this is the copy that exists precisely because the other one is not durable.
    """
    root = os.environ.get("HANDOFF_STATE_HOME") or os.environ.get("XDG_STATE_HOME") \
        or str(Path.home() / ".local" / "state")
    return Path(root) / "agent-handoff" / "usage.jsonl"


def append_usage(record: dict, repo: Path) -> None:
    """One line per round, append-only, and never fatal.

    A usage ledger that could fail a round would be worse than no ledger: the round is the thing
    that matters and this is bookkeeping about it. Every error is swallowed on purpose, which is
    the one place in this file where that is the right call.
    """
    try:
        tokens = (record.get("activity") or {}).get("tokens") or {}
        line = {
            "run_id": record.get("run_id"),
            "at": record.get("started_at") or record.get("recorded_at"),
            "project": repo.name,
            "project_path": str(repo),
            "slug": record.get("slug"),
            "provider": (record.get("provider") or {}).get("name"),
            "model": (record.get("provider") or {}).get("model"),
            "seconds": record.get("seconds"),
            # Presented, not evaluated: this is the API's per-turn prompt_tokens summed, which
            # re-counts the whole context every turn. Named so nobody adds it to a bench figure.
            "input_presented": tokens.get("input"),
            "output": tokens.get("output"),
        }
        path = usage_ledger()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as fh:
            fh.write(json.dumps(line) + "\n")
    except Exception:  # noqa: BLE001
        pass


def journal_dir(repo: Path) -> Path:
    return Path(os.environ.get("HANDOFF_JOURNAL_DIR") or (repo / ".handoff" / "journal"))


def records_path(repo: Path) -> Path:
    return journal_dir(repo) / "runs.jsonl"


def load_records(repo: Path) -> list[dict]:
    path = records_path(repo)
    if not path.exists():
        return []
    out = []
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except ValueError:
            # A truncated final line loses one record, not the history. Skipping beats refusing to
            # read anything, which is what a database would do here.
            continue
    return out


# --------------------------------------------------------------------------------------------
# mining the provider's event stream
#
# Cline emits newline-delimited JSON events, one per token, so a 45-turn run is 1.4 MB of which
# 98% is reasoning tokens. Three things in there are worth keeping and nothing else is:
# which tools were called, what the adapter complained about, and the token totals.


# Every tool that can change a file, across every client this harness drives.
#
# `replace_in_file` was missing, and it is the native loop's PRIMARY edit tool — so native rounds
# that edited six files reported write_calls=0. The count is used for one thing, the infra-failure
# heuristic ("writes: 0 means the model never attempted the work, re-run rather than re-specify"),
# and a false zero sends you to re-run a round that actually did the work.
WRITE_TOOLS = {"apply_patch", "write_file", "write_to_file", "create_file", "edit_file",
               "replace_in_file", "str_replace_editor", "insert_edit_into_file"}

# Tools that run arbitrary shell, and can therefore edit a file without naming it.
#
# `sed -i`, a heredoc, `php -r` writing a file — none of it is distinguishable from `ls` by tool
# name, so no name-based count can be complete. Reported from real use: a round that changed four
# files reported writes: 0 because it edited through the shell. The count below is therefore a
# LOWER BOUND whenever one of these was called, and says so rather than implying certainty.
SHELL_TOOLS = {"run_commands", "execute_command", "run_command", "bash", "shell", "terminal"}


def mine_events(log: Path) -> dict:
    tools: collections.Counter = collections.Counter()
    errors: collections.Counter = collections.Counter()
    iterations = 0
    tokens = {}
    if not log.exists():
        return {"parsed": False}

    for line in log.open(errors="replace"):
        line = line.strip()
        if not line or not line.startswith("{"):
            continue
        try:
            event = json.loads(line).get("event") or {}
        except ValueError:
            continue
        kind = event.get("type")
        if kind == "iteration_start":
            iterations += 1
        elif kind == "content_end" and event.get("contentType") == "tool":
            tools[event.get("toolName") or "?"] += 1
        elif kind == "error":
            errors[classify_error(error_message(event.get("error")))] += 1
        elif kind == "usage":
            tokens = {
                "input": event.get("totalInputTokens"),
                "output": event.get("totalOutputTokens"),
                "cache_read": event.get("totalCacheReadTokens"),
            }

    if not tools and not iterations and not errors:
        return {"parsed": False}

    return {
        "parsed": True,
        "iterations": iterations,
        "tool_calls": dict(tools),
        "total_tool_calls": sum(tools.values()),
        "write_calls": sum(n for t, n in tools.items() if t in WRITE_TOOLS),
        "shell_calls": sum(n for t, n in tools.items() if t in SHELL_TOOLS),
        "errors": dict(errors),
        "tokens": tokens,
    }


# Error messages carry ids and token counts, so the raw text never aggregates. These are the
# classes seen in real runs; anything else is kept verbatim, truncated, so a new failure mode
# shows up as itself rather than being folded into "other".
ERROR_CLASSES = [
    # Harness faults first, and named so nobody has to wonder. These come from the native loop's
    # tool layer, which knows when it was itself at fault — a truncated write, a file that is not
    # UTF-8, a postcondition that did not hold. Every one of them would otherwise arrive as a
    # rejected round with a damaged tree and be read as the model writing nonsense.
    #
    # Ordered above the generic patterns deliberately: "tool-io fault: ... timed out" must classify
    # as ours rather than matching the timeout rule below.
    # `tool-scope fault` was missing while the other three were present, so a scope refusal — the
    # most common one, since it fires whenever the model reaches outside the plan's file list —
    # fell through to the raw message and showed up as its own unique "class" every time.
    (r"tool-scope fault", "harness-scope"),
    (r"tool-encoding fault", "harness-encoding"),
    (r"tool-postcondition fault", "harness-postcondition"),
    (r"tool-io fault", "harness-io"),
    (r"context-budget:", "context-budget"),
    (r"does not match the expected .*format", "tool-call-format"),
    (r"maximum output token limit", "output-token-limit"),
    (r"exceeds the available context size", "context-overflow"),
    (r"\b(429|rate.?limit)", "rate-limited"),
    (r"\b(ECONNREFUSED|socket hang up|fetch failed)", "connection"),
    (r"\btimed? ?out\b", "timeout"),
]


def error_message(error) -> str:
    """The human-readable text of an error event, whatever shape it arrived in.

    `(event.get("error") or {}).get("message")` was here, and it broke on all three shapes that
    are not a dict carrying `message`:

      * a bare string — `"boom"` — raised AttributeError and took the whole entry's activity with
        it, so the round showed no tool counts and no errors at all
      * absent — classified as the literal string "None"
      * a dict with an empty message — classified as "{'message': ''}"

    Each produced a nonsense row in the errors column rather than a class anyone could act on.
    """
    if isinstance(error, str):
        return error
    if isinstance(error, dict):
        for key in ("message", "error", "detail", "name"):
            value = error.get(key)
            if isinstance(value, str) and value.strip():
                return value
        return "unknown-error"
    return "unknown-error" if error is None else str(error)


def classify_error(message: str) -> str:
    for pattern, name in ERROR_CLASSES:
        if re.search(pattern, message, re.I):
            return name
    # Never return an empty label: it renders as a bare separator in the errors column and reads
    # as a formatting fault rather than as an error nobody has classified yet.
    return message.strip()[:80] or "unknown-error"


def trim_log(src: Path, dest: Path) -> None:
    """Keep the events worth re-reading, gzipped. Reasoning tokens are 98% of the bytes and
    nothing has ever been diagnosed from them; tool calls, errors and usage are everything."""
    kept = 0
    with gzip.open(dest, "wt") as out:
        for line in src.open(errors="replace"):
            line = line.strip()
            if not line or not line.startswith("{"):
                continue
            try:
                event = json.loads(line).get("event") or {}
            except ValueError:
                continue
            if event.get("contentType") == "reasoning":
                continue
            if event.get("type") == "content_start" and event.get("contentType") == "text":
                continue
            out.write(line + "\n")
            kept += 1
    if kept == 0:
        dest.unlink(missing_ok=True)


# --------------------------------------------------------------------------------------------
# reading the rest of the run


def git(repo: Path, *args: str) -> str:
    try:
        return subprocess.run(["git", "-C", str(repo), *args], capture_output=True,
                              text=True, check=False).stdout.strip()
    except OSError:
        return ""


def read_tree_change(repo: Path, run_dir: Path) -> dict:
    before, after = run_dir / "tree-before", run_dir / "tree-after"
    if not (before.exists() and after.exists()):
        return {"known": False}
    a, b = before.read_text().strip(), after.read_text().strip()
    excludes = [":(exclude).handoff/**", ":(exclude).omc/**", ":(exclude).claude/**"]
    names = git(repo, "diff-tree", "-r", "--name-status", a, b, "--", *excludes)
    stat = git(repo, "diff-tree", "-r", "--numstat", a, b, "--", *excludes)
    changed, created, deleted = [], [], []
    for row in names.splitlines():
        parts = row.split("\t")
        if len(parts) < 2:
            continue
        status, path = parts[0], parts[-1]
        changed.append(path)
        if status.startswith("A"):
            created.append(path)
        elif status.startswith("D"):
            deleted.append(path)
    insertions = deletions = 0
    for row in stat.splitlines():
        cells = row.split("\t")
        if len(cells) >= 2:
            insertions += int(cells[0]) if cells[0].isdigit() else 0
            deletions += int(cells[1]) if cells[1].isdigit() else 0
    return {"known": True, "changed": changed, "created": created, "deleted": deleted,
            "files_changed": len(changed), "insertions": insertions, "deletions": deletions}


def read_gates(run_dir: Path) -> dict:
    path = run_dir / "evidence" / "evidence.json"
    if not path.exists():
        return {"known": False}
    try:
        data = json.loads(path.read_text())
    except ValueError:
        return {"known": False}
    rows = data.get("gates") or []
    return {
        "known": True,
        "verdict": data.get("verdict"),
        "acceptance_passed": data.get("acceptance_passed"),
        "acceptance_total": data.get("acceptance_total"),
        "regressed": data.get("regressed"),
        "failed": [r["gate"] for r in rows if r.get("status") == "fail" and not r.get("advisory")],
        "advisory_failed": [r["gate"] for r in rows
                            if r.get("status") == "fail" and r.get("advisory")],
        "skipped": [r["gate"] for r in rows if r.get("status") == "skipped"],
    }


def read_report(run_dir: Path) -> dict:
    path = run_dir / "result.json"
    if not path.exists() or path.stat().st_size == 0:
        return {"present": False, "parsed": False}
    raw = path.read_text(errors="replace").strip()
    if not raw:
        return {"present": False, "parsed": False}
    try:
        data = json.loads(raw)
    except ValueError:
        return {"present": True, "parsed": False}
    if not isinstance(data, dict):
        return {"present": True, "parsed": False}
    return {"present": True, "parsed": True, "status": data.get("status"),
            "summary": (data.get("summary") or "")[:400],
            "claimed_files": data.get("files_changed") or [],
            "deviations": data.get("deviations") or [],
            "blockers": data.get("blockers") or []}


def read_plan(plan: Path) -> dict:
    if not plan or not plan.exists():
        return {"known": False}
    text = plan.read_text(errors="replace")
    criteria = len(re.findall(r"(?m)^- \[ \]", text))
    commands = 0
    in_section = in_block = False
    for line in text.splitlines():
        if re.match(r"^## Verification(\s+commands)?\s*$", line):
            in_section = True
            continue
        if in_section and line.startswith("```"):
            if in_block:
                break
            in_block = True
            continue
        if in_block and line.strip():
            commands += 1
    files = len(re.findall(r"(?m)^\|", text))
    return {"known": True, "path": str(plan), "criteria": criteria, "commands": commands,
            "table_rows": files, "bytes": len(text),
            "sha256": hashlib.sha256(text.encode()).hexdigest()[:16]}


# --------------------------------------------------------------------------------------------
# the outcome
#
# Same taxonomy as bench/run, which derives it from the tree and never from the report, plus one
# class bench/run has no way to see: a round the infrastructure ate. Round 6 of a real feature made
# 41 tool calls, hit a tool-call format error, wrote nothing, and reported partial success. Scored
# as an ordinary failure it is indistinguishable from a model that tried and got it wrong — and the
# correct response is the opposite one. Re-run that plan; do not re-specify it.


def classify(tree: dict, gates: dict, report: dict, activity: dict) -> tuple[str, list[str]]:
    notes: list[str] = []
    changed = tree.get("files_changed", 0) if tree.get("known") else None
    verdict = gates.get("verdict") if gates.get("known") else None
    status = report.get("status")
    infra_errors = {"tool-call-format", "context-overflow", "connection", "timeout"}
    hit_infra = bool(infra_errors & set((activity.get("errors") or {}).keys()))

    if (activity.get("parsed") and activity.get("write_calls") == 0
            and not activity.get("shell_calls") and changed == 0):
        if hit_infra:
            notes.append("no write was ever attempted and the adapter reported an error — "
                         "re-run this plan once before changing it")
            return "infra-failed", notes
        notes.append("no write was ever attempted")

    # The verdict comes first, and this is a deliberate divergence from bench/run's taxonomy.
    # There, every round starts from a clean worktree, so "changed nothing" and "gates accept"
    # cannot both be true unless the plan is vacuous. In real use the tree is cumulative: a repair
    # round, or a round after an escalation, can legitimately change nothing because the work is
    # already there. Calling that `fabricated` reads as an accusation of a model that did nothing
    # wrong, and it appeared the first time the ladder ran.
    if verdict == "ACCEPT":
        if changed == 0:
            notes.append("this round changed nothing; the tree was already acceptable")
        return ("accepted" if report.get("parsed") else "patch-ok-no-report"), notes

    if changed == 0:
        if status in ("complete", "success"):
            notes.append("reported success over a tree it never touched")
            return "fabricated", notes
        return "no-op", notes

    if verdict == "ACCEPT":
        return ("accepted" if report.get("parsed") else "patch-ok-no-report"), notes
    if verdict == "REJECT":
        if gates.get("regressed"):
            notes.append("scored worse than the previous round — stop resuming")
        return "patch-damaged", notes
    return "unverified", notes


# --------------------------------------------------------------------------------------------
# record


def cmd_record(args: argparse.Namespace) -> int:
    repo = Path(args.repo).resolve()
    run_dir = Path(args.run_dir).resolve()
    jdir = journal_dir(repo)
    (jdir / "runs").mkdir(parents=True, exist_ok=True)

    started = args.started or ""
    ended = args.ended or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    seconds = None
    if started and ended:
        try:
            fmt = "%Y-%m-%dT%H:%M:%SZ"
            seconds = int((datetime.strptime(ended, fmt) - datetime.strptime(started, fmt))
                          .total_seconds())
        except ValueError:
            seconds = None

    existing = load_records(repo)
    attempt = sum(1 for r in existing if r.get("slug") == args.slug) + 1
    run_id = f"{(started or ended).replace(':', '').replace('-', '')}-{args.slug}-{attempt}"

    tree = read_tree_change(repo, run_dir)
    gates = read_gates(run_dir)
    report = read_report(run_dir)
    activity = mine_events(run_dir / "stdout.log")
    outcome, notes = classify(tree, gates, report, activity)

    record = {
        "schema": SCHEMA_VERSION,
        "run_id": run_id,
        # Which project this run came from.
        #
        # Needed as soon as HANDOFF_JOURNAL_DIR points several projects at one directory, which is
        # the setup worth having: the interesting questions — does this model do better on mature
        # code than greenfield, which failure classes recur everywhere — cannot be asked of a
        # single project's history, and a per-project journal makes them unanswerable by
        # construction. Recorded always, so a journal that is later centralised does not have a
        # blind era in the middle of it.
        "project": repo.name,
        "project_path": str(repo),
        "slug": args.slug,
        "attempt": attempt,
        "mode": args.mode,
        "recorded_at": ended,
        "started_at": started or None,
        "seconds": seconds,
        "provider": {"name": args.provider, "model": args.model or None,
                     "reasoning": args.reasoning or None, "context": args.context or None},
        "harness": {"commit": git(Path(args.handoff_home or repo), "rev-parse", "--short", "HEAD"),
                    "dirty": bool(git(Path(args.handoff_home or repo), "status", "--porcelain"))},
        "repo_head": git(repo, "rev-parse", "--short", "HEAD"),
        "plan": read_plan(Path(args.plan) if args.plan else None),
        "provider_exit": args.exit_status,
        "tree": tree,
        "gates": gates,
        "activity": activity,
        "report": report,
        "outcome": outcome,
        "notes": notes,
        "retro": None,
    }

    # Copy the artifacts aside before the next round of this slug overwrites them. This is the
    # whole reason the file exists: seven rounds produced three surviving logs.
    archive = jdir / "runs" / run_id
    archive.mkdir(parents=True, exist_ok=True)
    for name in ("evidence/evidence.md", "evidence/evidence.json", "result.json", "feedback.md"):
        src = run_dir / name
        if src.exists():
            shutil.copy2(src, archive / Path(name).name)
    if (run_dir / "stdout.log").exists():
        trim_log(run_dir / "stdout.log", archive / "events.jsonl.gz")
    if args.plan and Path(args.plan).exists():
        shutil.copy2(args.plan, archive / "plan.md")
    record["archive"] = str(archive.relative_to(repo)) if archive.is_relative_to(repo) else str(archive)

    with records_path(repo).open("a") as fh:
        fh.write(json.dumps(record) + "\n")

    # And once more, outside the repository, so the usage survives the repository. See
    # usage_ledger(): six projects here hold the only copy of their own token counts.
    append_usage(record, repo)

    print(f"==> journal: {run_id}  {outcome}"
          + (f"  ({gates['acceptance_passed']}/{gates['acceptance_total']} criteria)"
             if gates.get("acceptance_total") else ""))
    for note in notes:
        print(f"==>          {note}")
    return 0


# --------------------------------------------------------------------------------------------
# read


def _files_touched(r: dict) -> str:
    """How many files the round changed, created or deleted, from the diff rather than the log."""
    tree = r.get("tree") or {}
    if not tree.get("known"):
        return "-"
    return str(len(tree.get("changed") or []) + len(tree.get("created") or [])
               + len(tree.get("deleted") or []))


def fmt_row(r: dict) -> str:
    g = r.get("gates") or {}
    score = (f"{g.get('acceptance_passed')}/{g.get('acceptance_total')}"
             if g.get("acceptance_total") else "-")
    act = r.get("activity") or {}
    return (f"{r.get('recorded_at', ''):<21}{r.get('slug', '')[:28]:<29}"
            f"{r.get('outcome', ''):<20}{score:>7}"
            f"{(str(r.get('seconds')) + 's' if r.get('seconds') is not None else '-'):>8}"
            # FILES THE TREE ACTUALLY GAINED, LOST OR CHANGED — not tool calls.
            #
            # This column counted calls to a fixed list of tool names, and was wrong in every
            # direction that mattered. It missed `replace_in_file`. It missed every edit made
            # through the shell, so a round that deleted eleven files reported 0. And the whole
            # point of the column is the infra-failure heuristic — "0 means the model never
            # attempted the task, re-run rather than re-specify" — which a false 0 sends you to
            # apply to a round that did the work.
            #
            # A name-based count can never be complete, because `rm`, `sed -i` and a heredoc are
            # indistinguishable from `ls` by tool name. The tree cannot lie in the same way: it is
            # the same source every verdict here already comes from. 0 now means the tree is
            # untouched, which is exactly what the heuristic needs it to mean.
            f"{_files_touched(r):>7}"
            f"  {','.join(sorted((act.get('errors') or {}).keys()))}")


def unjournalled(repo: Path) -> list[str]:
    """Run directories with no journal entry — rounds that happened before this file existed.

    `no runs recorded yet` is true of the journal and false of the project, and the difference
    matters: a reader uses this column to tell "the model failed" from "the round never happened".
    Reported from real use — four run directories sat beside a journal that said nothing had ever
    run, and nothing said why.
    """
    runs = repo / ".handoff" / "runs"
    if not runs.is_dir():
        return []
    return sorted(d.name for d in runs.iterdir()
                  if d.is_dir() and (d / "result.json").exists() or
                  (d.is_dir() and (d / "tree-after").exists()))


def say_empty(repo: Path) -> None:
    print("no runs recorded yet")
    orphans = unjournalled(repo)
    if orphans:
        print()
        noun = "run directory exists" if len(orphans) == 1 else "run directories exist"
        print(f"But {len(orphans)} {noun} with no journal entry: {', '.join(orphans[:6])}"
              + (" ..." if len(orphans) > 6 else ""))
        print("Those rounds ran before the journal did. Their evidence is still in")
        print(".handoff/runs/<slug>/, and this view cannot summarise them — it reads")
        print("runs.jsonl, which they never wrote to. Not 'nothing happened'.")


def cmd_list(args: argparse.Namespace) -> int:
    rows = load_records(Path(args.repo).resolve())
    if args.slug:
        rows = [r for r in rows if r.get("slug") == args.slug]
    if not rows:
        say_empty(Path(args.repo).resolve())
        return 0
    print(f"{'when':<21}{'slug':<29}{'outcome':<20}{'score':>7}{'time':>8}{'files':>7}  errors")
    for r in rows[-args.limit:]:
        print(fmt_row(r))
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    rows = load_records(Path(args.repo).resolve())
