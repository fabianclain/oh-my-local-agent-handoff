def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo", default=os.environ.get("HANDOFF_REPO") or ".")
    sub = parser.add_subparsers(dest="cmd", required=True)

    rec = sub.add_parser("record")
    rec.add_argument("--run-dir", required=True)
    rec.add_argument("--slug", required=True)
    rec.add_argument("--mode", default="do")
    rec.add_argument("--provider", default="?")
    rec.add_argument("--model", default="")
    rec.add_argument("--reasoning", default="")
    rec.add_argument("--context", default="")
    rec.add_argument("--plan", default="")
    rec.add_argument("--started", default="")
    rec.add_argument("--ended", default="")
    rec.add_argument("--exit-status", type=int, default=None)
    rec.add_argument("--handoff-home", default="")
    rec.set_defaults(func=cmd_record)

    lst = sub.add_parser("list")
    lst.add_argument("--slug")
    lst.add_argument("--limit", type=int, default=30)
    lst.set_defaults(func=cmd_list)

    shw = sub.add_parser("show")
    shw.add_argument("which")
    shw.add_argument("--latest", action="store_true", default=True)
    shw.add_argument("--all", dest="latest", action="store_false")
    shw.set_defaults(func=cmd_show)

    sts = sub.add_parser("stats")
    sts.add_argument("--json", action="store_true")
    sts.set_defaults(func=cmd_stats)

    exp = sub.add_parser("export-sqlite")
    exp.add_argument("path", nargs="?")
    exp.set_defaults(func=cmd_export_sqlite)

    rp = sub.add_parser("retro-prompt")
    rp.add_argument("which")
    rp.set_defaults(func=cmd_retro_prompt)

    at = sub.add_parser("attach")
    at.add_argument("which")
    at.add_argument("--retro")
    at.set_defaults(func=cmd_attach)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
