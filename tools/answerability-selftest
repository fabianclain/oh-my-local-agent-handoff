#!/usr/bin/env python3
"""answerability-selftest — no gate in this chain may answer a question it could not ask.

    tools/answerability-selftest

THE CONTRACT

Every gate exits one of three ways, and the third is the point of this file:

    0   checked, and it holds
    1   checked, and it does not hold
    2   COULD NOT CHECK — and the reason is printed

Two is not a softer one. "This fails" and "I could not tell" are different facts with different
remedies, and a gate that cannot distinguish them will eventually report the second as the first
or, far worse, as a zero.

WHY THIS FILE EXISTS

Because that last failure has happened five times here, in five different tools, and each was found
by accident rather than by looking:

    search              grep exits 2 on an invalid pattern and writes nothing to stdout. The tool
                        returned `stdout or "no matches"`, so a search that never ran came back as
                        a confident absence, and the model believed it for ten turns.
    read_files          a file past the output cap was truncated with a note that named the loss
                        and no remedy. Three rounds re-issued the identical call.
    docblock-anchor     returned pass over a file that does not parse — blind exactly when the
                        syntax gate is red, which is when a displaced docblock is most likely. Also
                        exited 0 over a file with no docblocks at all.
    css-contrast        printed "0 colour pair(s) resolved" and exited 0. An empty stylesheet, a
                        stylesheet with no document, and a build that emitted no markup were all
                        green.
    verify-round        `pint`, `phpstan` and `pest` run only if present. Their absence was once
                        indistinguishable from their passing.

Only the last one was designed correctly from the start, and it is the reason `skipped` exists as a
first-class status in the evidence bundle. The rest agreed in their own PROSE that they could not
answer — `css-contrast` printed the reason and exited 0 underneath it — while the exit code said
otherwise. Prose is not a mechanism. This is.

WHAT IT DOES

Feeds every gate an input it genuinely cannot answer, and asserts two things: the exit code is 2,
and the output says why in words a person can act on. Adding a gate to GATES below is the whole
cost of covering a new one.

The last group is the control. A gate that returned 2 for everything would pass every case above
and be useless, so each tool must also still answer a question it CAN answer.
"""

from __future__ import annotations

import pathlib
import shutil
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
REPO = HERE.parent
FAILURES = 0


def pas(what: str) -> None:
    print(f"    PASS: {what}")


def bad(what: str, detail: str = "") -> None:
    global FAILURES
    FAILURES += 1
    print(f"    FAIL: {what}")
    for line in detail.splitlines()[:3]:
        print(f"        {line}")


work = pathlib.Path(tempfile.mkdtemp())

# ------------------------------------------------------------------------------------------------
# Inputs that are genuinely unanswerable — not malformed arguments, which are a different error.

(work / "empty.css").write_text("")
(work / "empty.php").write_text("")
(work / "empty.blade.php").write_text("")
(work / "junk.css").write_bytes(b"\x00\x01\x02not a stylesheet")
(work / "broken.php").write_text("<?php\nclass X {\n    /**\n     * Doc.\n     */\n")
(work / "valid.php").write_text(
    "<?php\n\nclass Y\n{\n    /**\n     * Real.\n     */\n    public function a(): int\n"
    "    {\n        return 1;\n    }\n}\n")
(work / "valid.html").write_text(
    "<html><body><style>p{color:#000;background:#fff}</style><p>text</p></body></html>")

php = shutil.which("php")

# (tool, argv, label, why it cannot be answered)
UNANSWERABLE = [
    ("css-contrast", ["empty.css"], "an empty stylesheet",
     "no colour pair can be resolved from nothing"),
    ("css-contrast", ["junk.css"], "binary garbage named .css",
     "the bytes are not a stylesheet"),
    ("docblock-anchor", ["empty.php"], "a file with no docblocks",
     "there is nothing to check, which is not the same as nothing being wrong"),
]
if php:
    UNANSWERABLE.append(
        ("docblock-anchor", ["broken.php"], "a file that does not parse",
         "every declaration the regex can see may be wrong"))

# Questions each tool CAN answer, so that returning 2 for everything does not pass this suite.
ANSWERABLE = [
    ("css-contrast", ["valid.html"], "a document with a resolvable pair"),
    ("docblock-anchor", ["valid.php"], "a file whose docblock sits on a declaration"),
]


def run(tool: str, argv: list[str]) -> tuple[int, str]:
    done = subprocess.run([str(HERE / tool), *argv], cwd=work,
                          capture_output=True, text=True, timeout=60)
    return done.returncode, (done.stdout or "") + (done.stderr or "")


print("==> gates must exit 2 and say why, when they cannot answer")
for tool, argv, label, why in UNANSWERABLE:
    code, out = run(tool, argv)
    if code == 0:
        bad(f"{tool}: {label} — exited 0. {why}", out)
    elif code == 1:
        bad(f"{tool}: {label} — exited 1, reporting a finding it did not make. {why}", out)
    elif code != 2:
        bad(f"{tool}: {label} — exited {code}, which is not part of the contract", out)
    elif "UNKNOWN" not in out and "not checked" not in out and "cannot" not in out.lower():
        bad(f"{tool}: {label} — exited 2 without saying why, so nobody can act on it", out)
    else:
        pas(f"{tool}: {label} — 2, with a reason")

print("==> and must still answer what they can, or 2 would be a cheap way to pass the above")
for tool, argv, label in ANSWERABLE:
    code, out = run(tool, argv)
    if code == 2:
        bad(f"{tool}: {label} — returned 'cannot check' over a question it can check", out)
    elif code not in (0, 1):
        bad(f"{tool}: {label} — exited {code}, outside the contract", out)
    else:
        pas(f"{tool}: {label} — answered ({code})")

print("==> a missing file is 2 everywhere, not a silent pass")
for tool in ("css-contrast", "docblock-anchor", "view-lint"):
    code, out = run(tool, ["definitely-not-here.txt"])
    if code == 2:
        pas(f"{tool}: missing file — 2")
    else:
        bad(f"{tool}: missing file exited {code}, expected 2", out)

# ------------------------------------------------------------------------------------------------
# verify-round is where an unanswered gate does the most damage, because its output is what the
# reviewer reads instead of the tree. It must name what it did not run rather than omitting it.

print("==> verify-round names what it could not check")
src = REPO / "tools" / "verify-round"
text = src.read_text()
if 'record "static-analysis" "skipped"' not in text or 'record "style" "skipped"' not in text:
    bad("verify-round no longer records a skipped status for absent tooling")
elif '"skipped": len(skipped)' not in text:
    bad("the evidence bundle stopped counting skipped gates")
elif "not run" not in text:
    bad("the report no longer distinguishes 'not run' from 'passed'")
else:
    pas("absent tooling is recorded as skipped and reported as 'not run', not as a pass")

print()
print("all checks passed" if not FAILURES else f"{FAILURES} check(s) failed")
shutil.rmtree(work, ignore_errors=True)
sys.exit(1 if FAILURES else 0)
