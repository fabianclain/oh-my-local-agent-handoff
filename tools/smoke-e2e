# Asked of the EFFECTIVE list rather than the tool's own text. verify-round now sources its
# exclusions from tools/lib/harness-paths.sh, shared with tools/sequence — which is the same
# anti-drift move this check exists to enforce, and which broke the check the first time, because
# grepping a file for a string is only ever a proxy for what the tool does. bench/run still
# declares its own, so both are searched.
effective_excludes() {
    case "$1" in
    tools/verify-round)
        ( source "$REPO/tools/lib/harness-paths.sh" && harness_excludes ) ;;
    *)
        grep -oE ':\(exclude\)[^"'"'"']*' "$REPO/$1" ;;
    esac
}

