# Reported from real use, and it cost a round. The criterion was
#   php artisan test | grep -qE 'Tests:[^0-9]*77 passed'
# and it could not pass over ANY tree, because artisan colours its output and the escape sequences
# between `Tests:` and the number contain digits — ^[[90m, ^[[39m, ^[[32;1m — so `[^0-9]*` cannot
# span them. A perfect tree and an unsatisfiable criterion look identical from the verdict alone.
COLOUR_REPO="$SANDBOX/ansi-criterion"
mkdir -p "$COLOUR_REPO"
( cd "$COLOUR_REPO" && git init -q && printf 'ok\n' >marker.txt && git add -A &&
