# can come back quietly.

# --- bench/run crashed on every early-failure path -----------------------------------------------
# write_metrics read ATTEMPTS, which only the attempt loop set. Under `set -u` a preflight failure
# aborted with "line 408: unbound variable" and no record of the actual cause — the worst possible
# behaviour for an unattended run, and it masked a real "provider adapter not found".
rm -rf "$REPO/bench/results/surgical/nosuchprovider"
