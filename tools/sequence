#!/usr/bin/env bash
#
# sequence — run an ordered set of plans, committing each accepted step, stopping at the first
# step the gates do not accept.
#
#   handoff sequence chart-1-schema chart-2-collect chart-3-series
#   handoff sequence --dry-run <slug>...        say what it would do, run nothing
#   handoff sequence --check <slug>...          pre-flight every plan and stop
#   handoff sequence --reroll 2 <slug>...       ask a rejected step again, from a clean tree
#
# ## What this removes, and what it deliberately does not
#
# A sequence of one-file steps is the shape that works here — creates pass on the first attempt
# roughly four times as often as edits, and splitting a mixed step into a create and an edit is
# what makes a verdict mean something. But running one used to stop after every step and wait for
# a human, and a field report of nine rounds found what that human was actually contributing:
# five approvals, none of which decided anything. Every one was "continue".
#
# They were not approvals. They were COMMITS. The implementer leaves its changes uncommitted, and
# the scope gate charges the tree to whichever round is running — so step 1's files, still sitting
# there, are counted against step 2 and it fails for a reason unrelated to itself. Someone had to
# commit between steps, nothing but a person could, and so a person was in the loop at every step
# boundary to perform a mechanical act.
#
# This runs the commit. That is the entire change, and it is why the rule "never queue a sequence"
# does not apply to it: that rule exists because the queue could not commit, not because sequences
# are unsafe.
#
# ## Retrying: which kind, and why only one of them
#
# This tool refused to retry at all for a reason that is still true. Of four failed rounds in the
# field report, two failed on criteria that no honest implementation could satisfy — a test pinned
# to the wrong clock, and a single-query assertion contradicting another criterion in the same plan.
# The model's response to an impossible criterion was never to fail cleanly. It wrote
# `Carbon::setTestNow()` into production code to force a flag true.
#
# But that is an argument against ONE kind of retry, and the two are not alike:
#
#   a REPAIR   hands the model its failing commands and the tree it already wrote, and asks it to
#              close the gap. Against an impossible criterion this is what produces test-only APIs
#              in production code — the model is being pushed at a target that cannot be reached,
#              and it will reach for anything. Still gated behind `--consult`, still one attempt.
#
#   a RE-ROLL  discards the failed attempt, restores the tree, and asks the SAME question again
#              with no feedback at all. It is an independent sample, not a nudge. It cannot harden
#              a bad assertion because it never sees which assertion failed.
#
# The case for re-rolling is arithmetic, and it is measured rather than assumed. `2-collect` is
# accepted on 6 of 10 independent attempts, so p=0.60 — and a step at p=0.60 that stops on rejection
# lands 60% of the time, while the same step re-rolled until accepted lands every time for an
# expected 1.67 rounds of GPU. bench/slot-throughput works the comparison out against best-of-2,
# which loses on one card because it always pays for both rolls where a re-roll is paid for only
# when the previous one actually failed.
#
# What re-rolling costs is GPU against an unsatisfiable criterion: every roll fails the same way and
# the step stops anyway, several rounds later. That is why `--consult` CANCELS the remaining re-rolls
# when it cannot confirm the failure was the model's — the one judgement worth paying for here is
# "is this reachable at all", and re-rolling is only ever the answer to "was that roll unlucky".
#
# Default 0. A sequence with no `--reroll` behaves exactly as it did before this existed.
#
# ## What is still NOT automated
#
# Deciding a criterion is wrong. On a final rejection this stops, leaves the tree exactly as the
# gates found it, and hands back what to read. The diagnosis is the reviewer's, which is the one
# part of the loop a human was ever doing.
#
# Nothing is thrown away to make room for a re-roll. Each discarded attempt is committed to
# `refs/handoff/discarded/<slug>/<roll>` before the tree is restored, because the harness records
# `tree-after` as an UNREFERENCED git tree — durable enough to re-read the same night, and reapable
# by the next `git gc`. The evidence bundle survives on its own: tools/journal already archives
# every round's evidence, plan and event stream before the run directory is reused.

set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HANDOFF_HOME="$(cd "$HERE/.." && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

DRY_RUN=0
CHECK_ONLY=0
CONSULT=""
BEFORE_STEP=""
REROLL=0
SLUGS=()

while (( $# > 0 )); do
    case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --check)   CHECK_ONLY=1; shift ;;
    --consult) CONSULT="${2:?--consult needs a provider}"; shift 2 ;;
    --before-step) BEFORE_STEP="${2:?--before-step needs a command}"; shift 2 ;;
    --reroll)  REROLL="${2:?--reroll needs a count}"; shift 2 ;;
    # Bounded by the header comment rather than a line number: the range was `2,38p` and the header
    # has since grown, which would have silently truncated the help at the first edit past line 38.
    -h|--help) awk 'NR>1 && /^set -uo pipefail/{exit} NR>1' "$(readlink -f "${BASH_SOURCE[0]}")" \
                   | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        echo "unknown option: $1" >&2; exit 64 ;;
    *)         SLUGS+=("$1"); shift ;;
    esac
done

# Rejected here rather than degraded to 0. `--reroll two` silently meaning "do not re-roll" is the
# shape of the bug that had this project serving 32768 tokens while every document said 98304: an
# unusable value quietly becoming a plausible one, with nothing in the output to say so.
[[ "$REROLL" =~ ^[0-9]+$ ]] || { echo "--reroll needs a non-negative integer, got: $REROLL" >&2; exit 64; }

(( ${#SLUGS[@]} > 0 )) || { echo "usage: handoff sequence <slug> [<slug>...]" >&2; exit 64; }

# shellcheck disable=SC1091
[[ -f "$REPO_ROOT/.handoff/config.sh" ]] && source "$REPO_ROOT/.handoff/config.sh"
PLANS_DIR="${HANDOFF_PLANS_DIR:-$REPO_ROOT/.handoff/plans}"
RUNS_DIR="${HANDOFF_RUNS_DIR:-$REPO_ROOT/.handoff/runs}"
HANDOFF_BIN="$HANDOFF_HOME/bin/handoff"

rule() { printf '\n\033[1m── %s\033[0m\n' "$*"; }
say()  { printf '   %s\n' "$*"; }
die()  { printf '\n\033[1;31mstopped:\033[0m %s\n' "$*" >&2; exit 1; }

# --- 1. every plan, before any model time ------------------------------------------------------
#
# All of them, not just the first. Discovering that step 3's plan has four criteria against two
# commands — a plan the harness refuses outright — is worth knowing before spending twenty minutes
# on steps 1 and 2, and this is also where a destructive acceptance command is caught for the whole
# sequence at once.
rule "pre-flight ${#SLUGS[@]} plan(s)"
PREFLIGHT_FAILED=0
PLAN_FILES=()
for slug in "${SLUGS[@]}"; do
    plan="$PLANS_DIR/$slug.md"
    if [[ -f "$plan" ]]; then
        PLAN_FILES+=("$plan")
    else
        echo "  plan not found: ${plan#"$REPO_ROOT"/}" >&2
        PREFLIGHT_FAILED=1
    fi
done
# One invocation over all of them, not one each: check-plan prints a tally at the end, and calling
# it per plan produces a run of "1 plan(s) would be accepted" that buries the finding it is for.
(( ${#PLAN_FILES[@]} == 0 )) || "$HERE/check-plan" "${PLAN_FILES[@]}" | sed 's/^/  /' || PREFLIGHT_FAILED=1
(( PREFLIGHT_FAILED == 0 )) || die "fix the plans above. Nothing was run."

if (( CHECK_ONLY )); then
    echo
    echo "every plan would be accepted by the harness. Nothing was run."
    exit 0
fi

# --- 2. a clean tree, because the first step's verdict depends on it ----------------------------
#
# Refused rather than warned. Every plan asserts what it changed, and the scope gate compares the
# tree against the plan's file list — so anything already sitting there is charged to step 1 and
# it is rejected for someone else's work. There is no bypass for this: a sequence started dirty
# produces verdicts that mean nothing, which is worse than not running.
# Asked with the SAME exclusions the scope gate uses, or this refuses to start on trees the gates
# would happily judge. Plans live under .handoff/plans or .claude/plans and are usually uncommitted
# while a sequence is being written; counting them as dirt would make the tool unusable in exactly
# the workflow it is for. Found by its own selftest.
# shellcheck source=lib/harness-paths.sh
source "$HERE/lib/harness-paths.sh"
mapfile -t TREE_EXCLUDES < <(harness_excludes)
dirty() { git status --porcelain -- . "${TREE_EXCLUDES[@]}"; }

if [[ -n "$(dirty)" ]]; then
    echo
    dirty | sed 's/^/   /'
    # A dry run executes nothing, so a dirty tree cannot hurt it — and stopping here would mean
    # the one mode whose whole job is to show you the plan never gets as far as showing it.
    if (( DRY_RUN )); then
        say "(dirty — a real run would refuse until these are committed or stashed)"
    else
        die "the working tree is not clean.
   The scope gate charges everything in the tree to the running step, so step 1 would be
   rejected for changes it did not make. Commit or stash these first."
    fi
fi

# --- 3. the loop -------------------------------------------------------------------------------

# The subject line for a step's commit: the plan's own `## Commit` line if it has one, else its
# H1. A plan that names its commit subject is one whose history reads as a person wrote it.
commit_subject() {
    local plan="$1" subject
    subject="$(awk '
        /^## Commit[[:space:]]*$/ { in_section=1; next }
        in_section && /^## / { exit }
        in_section && NF { print; exit }
    ' "$plan")"
    [[ -n "$subject" ]] || subject="$(sed -n 's/^# \(.*\)/\1/p' "$plan" | head -1)"
    [[ -n "$subject" ]] || subject="$(basename "$plan" .md)"
    printf '%s' "$subject"
}

# --- keeping a discarded roll, and then discarding it ------------------------------------------
#
# A re-roll has to start from a clean tree — the scope gate charges whatever is sitting there to the
# running round, so the previous roll's files would fail the next one for work it did not do, and
# the model would be handed a broken half-implementation to "finish" rather than the question the
# plan asks.
#
# So the failed attempt has to go. `preserve_roll` is what makes that a move rather than a loss: it
# turns the tree the gates judged into a real commit under refs/handoff/discarded, which is
# invisible to `git log` and survives `git gc`. The harness's own `tree-after` is an unreferenced
# tree object — good enough to re-read the same night, which is all bench/gate-sweep ever needed,
# and reapable whenever gc next runs.
preserve_roll() {
    local slug="$1" roll="$2" passed="$3" total="$4"
    local tree ref commit
    tree="$(cat "$RUNS_DIR/$slug/tree-after" 2>/dev/null)"
    [[ -n "$tree" ]] || return 1
    ref="refs/handoff/discarded/$slug/$roll"
    commit="$(git commit-tree "$tree" -p HEAD -m "discarded roll $roll of $slug

Rejected by the gates at $passed of $total acceptance criteria, then discarded so the next
roll could start from the clean tree its scope gate needs. Nothing was lost — this commit is
the exact tree the gates judged.

  git show $ref
  git diff HEAD $ref
")" || return 1
    git update-ref "$ref" "$commit" || return 1
    printf '%s' "$ref"
}

# Restore exactly the files the gates attributed to the round, and nothing else.
#
# Not `git reset --hard` and not `git clean -fd`. Both would take the harness's own bookkeeping with
# them — the run evidence this function is reading its file list OUT of, among other things — and
# `reset --hard` would be reaching for HEAD when the thing that needs undoing is the working tree.
# The gates already did the work of separating the model's changes from the harness's footprint, and
# re-deriving it here is how the two drift apart.
restore_tree() {
    local slug="$1"
    local changed="$RUNS_DIR/$slug/evidence/changed-files.txt"
    [[ -s "$changed" ]] || return 0
    local -a files
    mapfile -t files <"$changed"
    local file
    for file in "${files[@]}"; do
        [[ -n "$file" ]] || continue
        # Tracked covers modified AND deleted: a file the model removed is still in the index, so it
        # takes the checkout path and comes back. Untracked means the model created it, and the only
        # way to un-create a file is to remove it.
        if git ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
            git checkout HEAD -- "$file" || return 1
        else
            rm -f -- "$file" || return 1
        fi
    done
    return 0
}

verdict_of() {
    python3 -c "
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print('NONE 0 0 0'); raise SystemExit
print(d.get('verdict','NONE'), d.get('acceptance_passed',0), d.get('acceptance_total',0),
      1 if d.get('regressed') else 0)" "$1" 2>/dev/null || echo "NONE 0 0 0"
}

COMPLETED=()
STEP=0
for slug in "${SLUGS[@]}"; do
    STEP=$((STEP + 1))
    plan="$PLANS_DIR/$slug.md"
    CONSULT_FINDING=""
    rule "step $STEP of ${#SLUGS[@]}: $slug"

    if (( DRY_RUN )); then
        say "would run: handoff do $slug"
        [[ -z "$BEFORE_STEP" ]] || say "would stage first: $BEFORE_STEP $slug"
        (( REROLL == 0 )) || say "would re-roll up to $REROLL time(s) if rejected"
        say "would commit as: $(commit_subject "$plan")"
        continue
    fi

    # Stage whatever this step needs that the reviewer owns — most often the test that judges it.
    #
    # Here, between the previous step's commit and this step's round, is the ONLY safe window for
    # it. A file appearing while a round is running is charged to that round by the scope gate,
    # which is why the guidance says to write plans up front; but the same guidance also says to
    # write the tests up front, and those two cannot both hold when a plan's criteria include a
    # broad filter. `--filter=Crawler` runs every Crawler test, so a later step's test sitting in
    # the tree fails the current step for work nobody has been asked to do yet.
    #
    # Plans up front, tests staged with their step, is the shape that satisfies both.
    if [[ -n "$BEFORE_STEP" ]]; then
        if ! $BEFORE_STEP "$slug"; then
            die "staging failed for $slug — nothing was run for this step."
        fi
    fi

    EVIDENCE="$RUNS_DIR/$slug/evidence/evidence.json"
    DISCARDED=()
    REROLL_CANCELLED=0
    ROLL=0

    while :; do
        ROLL=$((ROLL + 1))
        (( ROLL == 1 )) || say "re-roll $((ROLL - 1)) of $REROLL — same plan, clean tree, no feedback"

        "$HANDOFF_BIN" do "$slug"
        DO_STATUS=$?
        read -r VERDICT PASSED TOTAL REGRESSED <<<"$(verdict_of "$EVIDENCE")"

        # A missing verdict is not a rejection — it means the round did not reach the gates at all
        # (the provider died, the lock was held, the model produced nothing). Committing on a verdict
        # nobody wrote would be the one unrecoverable mistake this tool could make, and re-rolling
        # would be answering an infrastructure failure by spending more GPU on it.
        if [[ "$VERDICT" == "NONE" ]]; then
            die "step $STEP produced no verdict (handoff do exited $DO_STATUS).
   Nothing was committed and the tree is untouched.
   Look at: ${RUNS_DIR#"$REPO_ROOT"/}/$slug/stdout.log"
        fi

        say "verdict: $VERDICT — $PASSED of $TOTAL acceptance criteria"
        [[ "$VERDICT" != "ACCEPT" ]] || break

        # --- the one place a person was doing something other than pressing continue ------------
        #
        # A rejection is two failures wearing the same clothes: the model got it wrong, or the
        # criterion cannot be satisfied by anything. They need opposite responses, and telling them
        # apart is the judgement this loop cannot make for itself. `--consult` asks an orchestrator —
        # a DIFFERENT model from the implementer — and acts only on a confident answer.
        #
        # First rejection only, and it decides whether re-rolling is worth anything. If the failure
        # cannot be confirmed as the model's, every re-roll will fail the same way for the same
        # reason and the step stops several rounds later having learned nothing — so a non-RETRY
        # answer cancels them. This is the composition that earns consult its cost: not "retry with
        # a hint", but "is this reachable at all, before we pay to ask again".
        if [[ -n "$CONSULT" && $ROLL -eq 1 ]]; then
            say "rejected — asking $CONSULT which kind of failure this is"
            ANSWER="$("$HERE/consult" "$slug" --plan "$plan" --runs-dir "$RUNS_DIR" --provider "$CONSULT")"
            say "$CONSULT: ${ANSWER:0:200}"

            if [[ "$ANSWER" == RETRY* ]]; then
                # A REPAIR, not a re-roll: the tree is deliberately left in place, because the model
                # is being asked to close a named gap in work it can still see. Exactly one.
                say "repairing $slug once with a narrower instruction"
                HANDOFF_FEEDBACK_FILE="$RUNS_DIR/$slug/feedback.md" "$HANDOFF_BIN" do "$slug"
                DO_STATUS=$?
                read -r VERDICT PASSED TOTAL REGRESSED <<<"$(verdict_of "$EVIDENCE")"
                say "after repair: $VERDICT — $PASSED of $TOTAL"
                [[ "$VERDICT" != "ACCEPT" ]] || break
            else
                # STOP and UNAVAILABLE both land here. The distinction is in the message, which the
                # rejection block below prints; neither is a reason to run the step again, and
                # neither is a reason to re-roll it.
                CONSULT_FINDING="$ANSWER"
                REROLL_CANCELLED=1
            fi
        fi

        if (( REROLL_CANCELLED )); then
            say "not re-rolling: $CONSULT could not confirm this was the model's error"
            break
        fi
        (( ROLL < 1 + REROLL )) || break

        # Keep the attempt, then undo it. In that order — if preserving fails, nothing is discarded.
        REF="$(preserve_roll "$slug" "$ROLL" "$PASSED" "$TOTAL")" || die \
            "step $STEP was rejected and its tree could not be preserved, so it has NOT been
   discarded and no re-roll was attempted. The work is still in the tree:
     handoff diff $slug"
        DISCARDED+=("$REF")
        say "kept the rejected attempt at $REF"

        if ! restore_tree "$slug"; then
            die "step $STEP was rejected and the tree could not be restored for a re-roll.
   The attempt is safe at $REF, but this tree is now part-way between two states.
   Restore it by hand before continuing:  git status"
        fi

        # The re-roll's scope gate inherits whatever is left here, exactly as a next step's would.
        # A leftover means the model wrote outside the files the gates attributed to it, which
        # restore_tree deliberately does not touch — it undoes the round, not the tree.
        if [[ -n "$(dirty)" ]]; then
            echo
            dirty | sed 's/^/   /'
            die "step $STEP left changes outside the files the gates attributed to it, so the tree
   is not clean enough to re-roll into. The attempt is safe at $REF."
        fi
    done

    if [[ "$VERDICT" != "ACCEPT" ]]; then
        cat <<EOF

$STEP of ${#SLUGS[@]} steps ran. Step $STEP was rejected, and the sequence stops here —
later steps assume it landed.

The tree holds the last attempt, exactly as the gates found it, and nothing was committed,
so the work is there to read:

  handoff diff $slug
  ${RUNS_DIR#"$REPO_ROOT"/}/$slug/evidence/evidence.md

Diagnose before re-running. The harness has already retried this plan internally, handing the
model its failing commands each time, so running it again unchanged asks a question that has
been answered. Two things to separate first, because they need opposite responses:

  the model damaged working code   -> re-specify NARROWER and run the new plan
  a criterion cannot honestly pass -> fix the criterion; the round was never about the model

Check the second one first. It is the more common of the two and the one that looks like the
first. Read each failing command and ask whether an ideal implementation could satisfy it.
EOF
        # How many independent attempts this was is the single most useful line here, because it
        # separates "unlucky" from "unreachable" without anyone having to reason about it. One
        # rejection is a sample. Three rejections of the same plan from three clean trees is
        # evidence about the plan, and the criteria are where to look first.
        (( ROLL == 1 )) || {
            echo
            echo "This step was rolled $ROLL times, each from a clean tree with no feedback, and"
            echo "rejected every time. That is evidence about the PLAN rather than the attempt —"
            echo "an unlucky roll does not repeat $ROLL times. Read the criteria before the diff."
        }
        (( ${#DISCARDED[@]} == 0 )) || {
            echo
            echo "The rejected attempts were kept, not thrown away:"
            printf '  %s\n' "${DISCARDED[@]}"
            echo "  (git show <ref>, or git diff HEAD <ref>)"
        }
        [[ -z "$CONSULT_FINDING" ]] || {
            echo
            echo "$CONSULT read the evidence and said:"
            echo "  $CONSULT_FINDING"
        }
        (( ${#COMPLETED[@]} == 0 )) || {
            echo
            echo "Committed and kept:"
            printf '  %s\n' "${COMPLETED[@]}"
        }
        exit 1
    fi

    # A round can be accepted and still be worth stopping for. `regressed` means this attempt
    # scored below the previous attempt at the same plan, which is the fingerprint of a repair
    # that is damaging the tree rather than a step that is done.
    if [[ "$REGRESSED" == "1" ]]; then
        die "step $STEP scored worse than its previous attempt, despite being accepted.
   That is usually a repair damaging the tree. Nothing was committed. Read:
   ${RUNS_DIR#"$REPO_ROOT"/}/$slug/evidence/evidence.md"
    fi

    # Commit exactly what the gates measured, rather than `git add -A`. The gates already
    # separated the model's work from the harness's own bookkeeping — run evidence, staged plans,
    # the journal — and re-deriving that here is how the two would drift apart.
    CHANGED="$RUNS_DIR/$slug/evidence/changed-files.txt"
    if [[ ! -s "$CHANGED" ]]; then
        die "step $STEP was accepted but the gates recorded no changed files.
   Refusing to commit an empty step. Read: ${RUNS_DIR#"$REPO_ROOT"/}/$slug/evidence/evidence.md"
    fi

    # Read into an array rather than splitting `$(cat)`: a path with a space in it would otherwise
    # be staged as two paths, both of which fail, after the round had already succeeded. `--`
    # because a path beginning with a dash would be read as an option.
    mapfile -t CHANGED_FILES <"$CHANGED"
    if ! git add -- "${CHANGED_FILES[@]}"; then
        die "step $STEP was accepted but its files could not be staged. Nothing committed."
    fi

    # Which roll landed it belongs in the history. A step accepted on the third attempt and a step
    # accepted on the first are the same commit and very different facts, and the second is the one
    # that tells the next reader the plan is marginal.
    ROLL_NOTE=""
    (( ROLL == 1 )) || ROLL_NOTE="
Accepted on roll $ROLL — the earlier attempts were rejected and are kept at
${DISCARDED[*]}"

    SUBJECT="$(commit_subject "$plan")"
    if ! git commit --quiet -m "$SUBJECT" -m "$(cat <<EOF
Implemented by the local model from ${plan#"$REPO_ROOT"/}.
Acceptance: $PASSED of $TOTAL. Evidence: ${RUNS_DIR#"$REPO_ROOT"/}/$slug/evidence/evidence.md$ROLL_NOTE
EOF
)"; then
        die "step $STEP was accepted but the commit failed. Nothing was lost — the work is in
   the tree and can be committed by hand."
    fi

    COMMIT="$(git rev-parse --short HEAD)"
    say "committed $COMMIT  $SUBJECT"
    COMPLETED+=("$COMMIT  $SUBJECT")

    # The tree must be clean again before the next step, or its scope gate inherits whatever is
    # left. Anything still here was excluded from the commit deliberately — harness bookkeeping,
    # or something the model wrote outside the plan's file list — and the next step would be
    # blamed for it.
    if [[ -n "$(dirty)" ]]; then
        echo
        dirty | sed 's/^/   /'
        die "step $STEP left changes outside the files the gates attributed to it.
   The next step would be charged with these. Deal with them, then continue with:
     handoff sequence ${SLUGS[*]:$STEP}"
    fi
done

if (( DRY_RUN )); then
    echo
    echo "dry run — nothing was executed."
    exit 0
fi

rule "all ${#SLUGS[@]} step(s) accepted"
printf '   %s\n' "${COMPLETED[@]}"
cat <<EOF

Now read the diff. The gates cannot see the things a reviewer of this workflow has consistently
found only by reading — a truncated docblock, a non-breaking hyphen where a hyphen belonged, a
comment lifted from a sibling class describing the wrong thing. An accepted verdict means every
criterion held, and nothing more than that.

  git log --oneline -${#SLUGS[@]}
  git diff HEAD~${#SLUGS[@]}

EOF
