#!/usr/bin/env bash
#
# handoff — one model plans and verifies, another implements.
#
#   handoff do <slug>       fresh run against <plans>/<slug>.md
#   handoff resume <slug>   continue the same session using runs/<slug>/feedback.md
#   handoff diff <slug>     exactly what the implementer changed during the run
#   handoff init            wire this project up: plans dir, config, gitignore
#   handoff check <slug>    will the harness accept this plan, before you run it
#   handoff verify <slug>   run the gates over the tree and print the verdict
#
# `do` verifies automatically when it finishes. HANDOFF_NO_VERIFY=1 suppresses that, for
# callers running the same gates themselves.
#
# The implementer never commits. The reviewer owns the commit.
#
# Config: .handoff/config.sh in the target repo (see templates/config.sh)
# Env:    HANDOFF_PROVIDER (default codex), HANDOFF_MODEL, HANDOFF_EFFORT, HANDOFF_SANDBOX

set -euo pipefail

MODE="${1:-}"
SLUG="${2:-}"

if [[ "$MODE" == "init" ]]; then
    # Everything a project needs before its first run, and nothing else. Idempotent: safe to run
    # on a project that is already set up, which is what makes it safe for a skill to call.
    ROOT="$(git rev-parse --show-toplevel)"
    HOME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    cd "$ROOT"
    PLANS="$ROOT/.handoff/plans"
    # Respect an existing config's choice of plans directory rather than imposing a second one.
    [[ ! -f "$ROOT/.handoff/config.sh" ]] || PLANS="$(
        REPO_ROOT="$ROOT"; source "$ROOT/.handoff/config.sh" >/dev/null 2>&1
        echo "${HANDOFF_PLANS_DIR:-$ROOT/.handoff/plans}"
    )"
    mkdir -p "$PLANS" && echo "plans:     ${PLANS#"$ROOT"/}"

    if [[ -f "$ROOT/.handoff/config.sh" ]]; then
        echo "config:    .handoff/config.sh (kept — edit it to describe how this project builds)"
    else
        mkdir -p "$ROOT/.handoff"
        cp "$HOME_DIR/templates/config.sh" "$ROOT/.handoff/config.sh"
        echo "config:    .handoff/config.sh (copied from the template — EDIT IT)"
    fi

    # Agent state in the working tree breaks any plan that asserts how many files changed, and
    # that check is in most plans. A project's first run was rejected for exactly this.
    added=(); skipped=()
    for pattern in '.handoff/runs/' '.omc/' '.claude/'; do
        grep -qxF "$pattern" "$ROOT/.gitignore" 2>/dev/null && continue
        # Never ignore a path the project tracks, and never ignore the plans directory. A project
        # can legitimately keep plans under .claude, and blanket-ignoring it there would quietly
        # stop new plans from being added. This exact mistake was made against a real repository
        # that tracks 48 plans under .claude/plans.
        if [[ "$PLANS" == "$ROOT/${pattern%/}"* ]] ||
           [[ -n "$(git -C "$ROOT" ls-files -- "${pattern%/}" 2>/dev/null | head -1)" ]]; then
            skipped+=("${pattern%/}")
            continue
        fi
        printf '%s\n' "$pattern" >> "$ROOT/.gitignore"; added+=("$pattern")
    done
    (( ${#added[@]} == 0 )) || echo "gitignore: added ${added[*]}"
    (( ${#skipped[@]} == 0 )) || echo "gitignore: left ${skipped[*]} alone — tracked content lives there"
    (( ${#added[@]} + ${#skipped[@]} )) || echo "gitignore: already covered"

    echo
    echo "Next: write a plan in ${PLANS#"$ROOT"/}, then"
    echo "  handoff check <slug>   &&  HANDOFF_PROVIDER=local handoff do <slug>"
    exit 0
fi

if [[ -z "$MODE" || -z "$SLUG" ]]; then
    echo "usage: handoff {do|check|resume|diff|verify} <slug> | handoff init" >&2
    exit 64
fi

HANDOFF_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Project-specific conventions and verification commands. Without this the implementer has no
# idea how the project builds, tests, or formats — the single biggest source of avoidable churn.
#
# Sourced BEFORE the paths below are resolved. An earlier version computed them first, so the
# HANDOFF_PLANS_DIR override that templates/config.sh documents silently did nothing and the
# driver reported "plan not found" for a plan that existed.
# Addressed to the implementer, so it must not ask for anything. The previous wording — "create
# .handoff/config.sh" — was written for a human reading the terminal, went into the model's prompt,
# and got obeyed: the first clean-room run of the quickstart was rejected for an invented file the
# harness had told it to invent. Setup instructions belong in the setup output, not in the task.
PROJECT_RULES="(This project has no .handoff/config.sh, so no build, test or formatting conventions were supplied. Follow the conventions visible in the files you are editing. Do not create a config file.)"
# shellcheck disable=SC1091
[[ -f "$REPO_ROOT/.handoff/config.sh" ]] && source "$REPO_ROOT/.handoff/config.sh"

PLANS_DIR="${HANDOFF_PLANS_DIR:-$REPO_ROOT/.handoff/plans}"
RUNS_DIR="${HANDOFF_RUNS_DIR:-$REPO_ROOT/.handoff/runs}"
PLAN_FILE="$PLANS_DIR/${SLUG}.md"
RUN_DIR="$RUNS_DIR/$SLUG"
SCHEMA="$HANDOFF_HOME/schemas/handoff.schema.json"

PROVIDER="${HANDOFF_PROVIDER:-codex}"
PROVIDER_FILE="$HANDOFF_HOME/providers/${PROVIDER}.sh"
[[ -f "$PROVIDER_FILE" ]] || { echo "unknown provider: $PROVIDER" >&2; exit 64; }
# shellcheck disable=SC1090
source "$PROVIDER_FILE"
provider_preflight || exit 1

# Harness scratch state churns on its own during a run and is not the implementer's doing.
# Excluding it keeps the changed-file list honest for review.
DIFF_EXCLUDES=(
    ':(exclude).handoff/runs/**'
    ':(exclude).omc/**'
    ':(exclude)storage/logs/**'
    ':(exclude)storage/framework/**'
    ':(exclude)node_modules/**'
    ':(exclude)vendor/**'
)

# Snapshot the whole working tree (tracked + untracked, honouring .gitignore) into a git tree
# object, using a throwaway index so the real index is never touched. Comparing before/after
# trees yields exactly what the implementer changed, with pre-existing dirty state filtered out.
# Plain `git diff` is useless in a repo that already has uncommitted work.
snapshot_tree() {
    local idx
    idx="$(mktemp)"
    # A fresh repo with no commits has no .git/index. Copying it fails, and mktemp's zero-byte
    # file is not a valid index — git aborts with "index file smaller than expected". Remove the
    # placeholder so git creates a real index at that path instead.
    if ! cp -f "$(git rev-parse --git-dir)/index" "$idx" 2>/dev/null; then
        rm -f "$idx"
    fi
    GIT_INDEX_FILE="$idx" git add -A
    GIT_INDEX_FILE="$idx" git write-tree
    rm -f "$idx"
}

DEV_INSTRUCTIONS="You are the implementer in a two-model workflow. Another model wrote the plan and will review your work; you write the code. The plan file is the complete specification — implement exactly what it says, nothing more. Do not create git commits, do not amend, do not stash, do not run git checkout or git reset. Leave every change uncommitted in the working tree. Do not modify files listed as out of scope. If the plan is wrong or ambiguous, implement your best reading and record it under deviations rather than stopping. Report honestly: never claim a test passed unless you ran it and saw it pass."

# The operational rules are a separate layer from both the plan and the project's own conventions,
# and only the rule headings travel to the model — the rationale table in that file is for the
# maintainer. Three layers, kept apart on purpose: benchmark findings (never shown to the model,
# because telling a model under test which mistakes it is expected to make contaminates the
# measurement), these task-independent rules, and the plan.
#
# Extracted rather than inlined so the rules can be edited and diffed as prose. Everything from
# the first "## EDITING RULES" heading to the "## Why each rule is here" heading is sent.
AGENT_RULES_FILE="${HANDOFF_AGENT_RULES:-$HANDOFF_HOME/templates/agent-rules.md}"
if [[ -f "$AGENT_RULES_FILE" ]]; then
    AGENT_RULES="$(awk '
        /^## EDITING RULES/ { on=1 }
        /^## Why each rule is here/ { on=0 }
        on { print }
    ' "$AGENT_RULES_FILE")"
    [[ -z "$AGENT_RULES" ]] || DEV_INSTRUCTIONS="$DEV_INSTRUCTIONS

$AGENT_RULES"
fi

# Run the harness's own verifier over the working tree and report its verdict.
#
# This is the step that makes a local implementer usable. The model's report is not evidence — in
# this project runs have claimed `status: complete` over trees they never touched, and between a
# quarter and two fifths of runs return no report at all while leaving a byte-perfect patch. So the
# question "did this work?" has to be answered by running commands against the tree, not by reading
# what the model said about it.
#
# It also decides what a hosted reviewer is worth paying for. A rejected round should never reach
# one: the whole economic case for a local implementer collapses if every attempt costs hosted
# tokens to triage.
run_verification() {
    local slug="$1"
    local plan="$PLANS_DIR/${slug}.md"
    local out="$RUN_DIR/evidence"
    # $HANDOFF_HOME, not $REPO_ROOT. The verifier ships with the harness; REPO_ROOT is the user's
    # project, which has no reason to contain it. Getting this wrong made verification skip
    # silently for every real user while the benchmark — which calls verify-round by absolute path
    # — kept working, so nothing here noticed. Found by running the actual first-use journey in a
    # scratch project rather than by testing the verifier directly.
    local verifier="$HANDOFF_HOME/tools/verify-round"

    [[ -x "$verifier" ]] || {
        echo "==> no verifier at tools/verify-round — skipping (nothing checked this tree)" >&2
        return 0
    }
    [[ -f "$plan" ]] || { echo "plan not found: $plan" >&2; return 1; }

    # The verdict is only about this run if the tree was clean when the run started. Otherwise it
    # covers pre-existing changes too, which is a different claim, so say so rather than implying
    # a cleanliness the evidence does not support.
    if [[ -s "$RUN_DIR/tree-before" ]]; then
        local head_tree; head_tree="$(git rev-parse HEAD^{tree} 2>/dev/null || true)"
        if [[ -n "$head_tree" && "$(cat "$RUN_DIR/tree-before")" != "$head_tree" ]]; then
            echo "==> NOTE: the tree was already modified before this run; the verdict below covers"
            echo "==>       every uncommitted change, not only what this run did."
        fi
    fi

    echo
    echo "==> verifying against HEAD"
    # The run-start snapshot gives untracked read-only files a baseline. Without it the gate can
    # only see that they exist, not whether they changed.
    local snapshot=""
    [[ ! -s "$RUN_DIR/tree-before" ]] || snapshot="$(cat "$RUN_DIR/tree-before")"
    "$verifier" "$REPO_ROOT" "$plan" HEAD "$out" "$snapshot"
    local verdict=$?
    echo "==> evidence: ${out#"$REPO_ROOT"/}/evidence.md"
    return "$verdict"
}

case "$MODE" in
diff)
    if [[ ! -f "$RUN_DIR/tree-before" || ! -f "$RUN_DIR/tree-after" ]]; then
        echo "no completed run recorded for '$SLUG'" >&2
        exit 1
    fi
    git diff-tree -r --name-status \
        "$(cat "$RUN_DIR/tree-before")" "$(cat "$RUN_DIR/tree-after")" -- "${DIFF_EXCLUDES[@]}"
    exit 0
    ;;

do)
    [[ -f "$PLAN_FILE" ]] || {
        echo "plan not found: $PLAN_FILE" >&2
        echo "write it first — see $HANDOFF_HOME/templates/plan.md" >&2
        exit 1
    }
    mkdir -p "$RUN_DIR"
    snapshot_tree >"$RUN_DIR/tree-before"
    PROMPT="Implement the plan in the file ${PLAN_FILE#"$REPO_ROOT"/} relative to the repository root.

Read that file first, in full. It is the complete specification: implement every step and satisfy every acceptance criterion, and do not do anything it does not ask for.

${PROJECT_RULES}

When you are done, run the verification commands listed in the plan and report the real results. Leave all changes uncommitted in the working tree — the reviewer reads the diff and owns the commit."

    # A repair attempt. The harness has already run the plan's verification commands and knows
    # exactly which ones failed, so the model is told that rather than being asked to look again.
    #
    # This exists as a `do`-mode option rather than relying on `handoff resume` because resume
    # needs provider session support, and the Cline adapter has none: `--id` is incompatible with
    # --json in 3.0.52. A repair loop that only worked for some providers would silently measure
    # different things for different models.
    if [[ -n "${HANDOFF_FEEDBACK_FILE:-}" && -s "${HANDOFF_FEEDBACK_FILE}" ]]; then
        PROMPT="$PROMPT

## Previous attempt

You already attempted this task and the working tree still holds your changes.

$(cat "$HANDOFF_FEEDBACK_FILE")

Fix only what is needed to make those checks pass. Do not start over, do not revert your earlier
work, and do not change anything the plan did not ask for."
    fi
    ;;

resume)
    [[ -f "$RUN_DIR/feedback.md" ]] || { echo "no feedback at $RUN_DIR/feedback.md" >&2; exit 1; }
    [[ -s "$RUN_DIR/session-id" ]] || { echo "no session id for '$SLUG' — run 'handoff do' first" >&2; exit 1; }
    SESSION_ID="$(cat "$RUN_DIR/session-id")"
    PROMPT="Review feedback on your implementation. Address every point, then re-run the verification commands.

$(cat "$RUN_DIR/feedback.md")

${PROJECT_RULES}

Leave all changes uncommitted."
    ;;

check)
    # Reachable from any project, which tools/check-plan is not: only bin/ is on PATH, and asking
    # someone to know where the harness is checked out defeats the point of checking at all.
    CHECKER="$HANDOFF_HOME/tools/check-plan"
    [[ -x "$CHECKER" ]] || { echo "no checker at tools/check-plan" >&2; exit 1; }
    [[ -f "$PLAN_FILE" ]] || {
        echo "plan not found: $PLAN_FILE" >&2
        echo "plans for this project live in ${PLANS_DIR#"$REPO_ROOT"/}" >&2
        exit 1
    }
    "$CHECKER" "$PLAN_FILE"
    exit $?
    ;;

verify)
    run_verification "$SLUG"
    exit $?
    ;;

*)
    echo "unknown mode: $MODE (expected do|check|resume|diff|verify)" >&2
    exit 64
    ;;
esac

# Degrade loudly, never silently. A prompt-and-validate JSON round is not the same guarantee as
# a schema-enforced one, and the difference has to be visible in the log.
while IFS='=' read -r cap level; do
    [[ "$level" == "native" ]] || echo "==> NOTE: $PROVIDER $cap is '$level', not native"
done < <(provider_capabilities)

echo "==> handoff $MODE '$SLUG'  provider=$PROVIDER model=${HANDOFF_MODEL:-default} sandbox=${HANDOFF_SANDBOX:-workspace-write}"

set +e
if [[ "$MODE" == "resume" ]]; then
    provider_resume "$SESSION_ID" "$SCHEMA" "$RUN_DIR/result.json" "$RUN_DIR/stdout.log" "$DEV_INSTRUCTIONS" "$PROMPT"
else
    provider_run "$REPO_ROOT" "$SCHEMA" "$RUN_DIR/result.json" "$RUN_DIR/stdout.log" "$DEV_INSTRUCTIONS" "$PROMPT"
fi
STATUS=$?
set -e

# Only overwrite on a successful parse; a failed grep must not wipe a good id from an earlier run.
if SID="$(provider_parse_session_id "$RUN_DIR/stdout.log")" && [[ -n "$SID" ]]; then
    printf '%s\n' "$SID" >"$RUN_DIR/session-id"
fi

snapshot_tree >"$RUN_DIR/tree-after"

echo
echo "==> exit=$STATUS"
echo "==> handoff report: $RUN_DIR/result.json"
echo "==> changed by this run:"
git diff-tree -r --name-status \
    "$(cat "$RUN_DIR/tree-before")" "$(cat "$RUN_DIR/tree-after")" -- "${DIFF_EXCLUDES[@]}" || true

# Verify by default. HANDOFF_NO_VERIFY=1 is for callers that run the same gates themselves —
# bench/run does — so the work is not done twice inside a benchmark.
# resume verifies too. It did not, and exited 0 regardless, so a resumed round that the gates
# would have rejected looked like a pass — and was nearly reported as one.
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && "${HANDOFF_NO_VERIFY:-0}" != 1 ]]; then
    set +e
    run_verification "$SLUG"
    VERDICT=$?
    set -e

    # The gates decide, in both directions.
    #
    # A provider that exited cleanly over a tree the gates reject is a failed round. Less
    # obviously, a provider that failed over a tree the gates ACCEPT is a successful one: the
    # commonest provider failure by far is a missing or malformed completion report, which happens
    # on roughly one run in three and says nothing about the patch. Letting that override the
    # verdict would make `handoff do` exit non-zero on a third of its successes and teach anyone
    # scripting it to throw away good work.
    #
    # This is the same rule as everywhere else here: judge the tree, and treat the report as
    # untrusted metadata.
    if [[ "$STATUS" -ne 0 && "$VERDICT" -eq 0 ]]; then
        echo "==> NOTE: the provider exited $STATUS — most often a missing or malformed report —"
        echo "==>       but the gates accept this tree. Judging the tree: accepted."
    fi
    STATUS="$VERDICT"
fi

exit "$STATUS"
