#!/usr/bin/env bash
#
# handoff — one model plans and verifies, another implements.
#
#   handoff do <slug>       fresh run against <plans>/<slug>.md
#   handoff resume <slug>   continue the same session using runs/<slug>/feedback.md
#   handoff diff <slug>     exactly what the implementer changed during the run
#   handoff init            wire this project up: plans dir, config, gitignore
#   handoff check <slug>    will the harness accept this plan, before you run it
#   handoff prepare <slug>  the whole pre-flight: check, lint, and every criterion dry-run
#   handoff verify <slug>   run the gates over the tree and print the verdict
#   handoff log [slug]      every run recorded so far, one line each
#   handoff stats           how the local model is actually performing, across runs
#   handoff retro <slug>    ask the model what it thinks went wrong, and record the answer
#   handoff auto <slug>     the ladder: local tries, a hosted planner re-specifies, local retries
#   handoff sequence <slug>...  run steps in order, commit each accepted one, stop at the first
#                               rejection. Automates the advance; never the retry.
#   handoff queue [<slug>]  add a round to the machine-wide queue, or list what is queued
#   handoff drain [--once]  run the queued rounds, one at a time
#   handoff doctor          can this machine run a round right now? read-only
#   handoff contrast <file> WCAG contrast for every colour pair a view declares
#   handoff view-lint <file>  tag balance, the 100vh overflow trap, missing heading
#   handoff docblock-anchor --base <ref> <file>   every docblock still on its own declaration
#   handoff patch-shape <ref> <file> [--max-hunks N] [--max-added N]   the shape of the change
#
# `do` verifies automatically when it finishes. HANDOFF_NO_VERIFY=1 suppresses that, for
# callers running the same gates themselves.
#
# The implementer never commits. The reviewer owns the commit.
#
# Config: .handoff/config.sh in the target repo (see templates/config.sh)
# Env:    HANDOFF_PROVIDER (default codex), HANDOFF_MODEL, HANDOFF_EFFORT, HANDOFF_SANDBOX

set -euo pipefail

# Where this script really lives, following symlinks.
#
# `dirname "${BASH_SOURCE[0]}"` is the directory the script was INVOKED through, which stops being
# the checkout once it is installed. tools/install-local links ~/.local/bin/handoff at the repo,
# and every path built from the invocation directory then pointed into ~/.local: `handoff init`
# failed on a missing ~/.local/templates/config.sh, and `handoff do` reported "unknown provider:
# native" because it looked in ~/.local/providers. Both faults appear only when installed — which
# is the state every user is in, and the one no test had ever been in.
_handoff_real_self() {
    if command -v readlink >/dev/null 2>&1; then
        local resolved
        resolved="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null)"
        [[ -n "$resolved" ]] && { printf '%s\n' "$resolved"; return 0; }
    fi
    local target="${BASH_SOURCE[0]}"
    while [[ -L "$target" ]]; do
        local link; link="$(ls -ld -- "$target" | sed 's/.* -> //')"
        [[ "$link" == /* ]] && target="$link" || target="$(dirname "$target")/$link"
    done
    printf '%s\n' "$target"
}

MODE="${1:-}"
SLUG="${2:-}"

if [[ "$MODE" == "init" ]]; then
    # Everything a project needs before its first run, and nothing else. Idempotent: safe to run
    # on a project that is already set up, which is what makes it safe for a skill to call.
    ROOT="$(git rev-parse --show-toplevel)"
    HOME_DIR="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    # `init` runs long before the user config is sourced further down, so read it here or the
    # summary tells a new project it will use `codex` when it will not.
    # shellcheck disable=SC1091
    [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/agent-handoff/config.sh" ]] &&
        source "${XDG_CONFIG_HOME:-$HOME/.config}/agent-handoff/config.sh"
    cd "$ROOT"
    PLANS="$ROOT/.handoff/plans"
    # Respect an existing config's choice of plans directory rather than imposing a second one.
    [[ ! -f "$ROOT/.handoff/config.sh" ]] || PLANS="$(
        REPO_ROOT="$ROOT"; source "$ROOT/.handoff/config.sh" >/dev/null 2>&1
        echo "${HANDOFF_PLANS_DIR:-$ROOT/.handoff/plans}"
    )"
    mkdir -p "$PLANS" && echo "plans:     ${PLANS#"$ROOT"/}"

    if [[ -f "$ROOT/.handoff/config.sh" ]]; then
        echo "config:    .handoff/config.sh (kept — edit it to describe how this project builds)"
    else
        mkdir -p "$ROOT/.handoff"
        cp "$HOME_DIR/templates/config.sh" "$ROOT/.handoff/config.sh"
        echo "config:    .handoff/config.sh (copied from the template — EDIT IT)"
    fi

    # Agent state in the working tree breaks any plan that asserts how many files changed, and
    # that check is in most plans. A project's first run was rejected for exactly this.
    added=(); skipped=()
    for pattern in '.handoff/runs/' '.handoff/scratch/' '.handoff/journal/' '.omc/' '.claude/'; do
        grep -qxF "$pattern" "$ROOT/.gitignore" 2>/dev/null && continue
        # Never ignore a path the project tracks, and never ignore the plans directory. A project
        # can legitimately keep plans under .claude, and blanket-ignoring it there would quietly
        # stop new plans from being added. This exact mistake was made against a real repository
        # that tracks 48 plans under .claude/plans.
        if [[ "$PLANS" == "$ROOT/${pattern%/}"* ]] ||
           [[ -n "$(git -C "$ROOT" ls-files -- "${pattern%/}" 2>/dev/null | head -1)" ]]; then
            skipped+=("${pattern%/}")
            continue
        fi
        printf '%s\n' "$pattern" >> "$ROOT/.gitignore"; added+=("$pattern")
    done
    (( ${#added[@]} == 0 )) || echo "gitignore: added ${added[*]}"
    (( ${#skipped[@]} == 0 )) || echo "gitignore: left ${skipped[*]} alone — tracked content lives there"
    (( ${#added[@]} + ${#skipped[@]} )) || echo "gitignore: already covered"

    echo
    echo "Next: write a plan in ${PLANS#"$ROOT"/}, then"
    # Names the provider that will actually be used, rather than a fixed string. The old hint
    # hard-coded `HANDOFF_PROVIDER=local`; providers/local.sh does exist, but with a user config in
    # place the variable is unnecessary, and naming the wrong provider in the first instruction a
    # new project sees is worse than naming none.
    echo "  handoff prepare <slug>   &&  handoff do <slug>"
    echo
    echo "provider:  ${HANDOFF_PROVIDER:-codex}$([[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/agent-handoff/config.sh" ]] && echo " (from your user config)" || echo " (default — see tools/install-local)")"
    exit 0
fi

# Read-only, needs no slug, and must work before anything else does — so it comes first.
if [[ "$MODE" == "doctor" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    shift
    exec "$HANDOFF_HOME/tools/doctor" "$@"
fi

# The ladder runs the driver repeatedly, so it lives outside it rather than inside the mode switch.
if [[ "$MODE" == "auto" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    shift
    exec "$HANDOFF_HOME/tools/escalate" "$@"
fi

# An ordered set of plans in THIS repository, committing each accepted step. Outside the mode
# switch because it takes many slugs rather than one, and because it invokes `handoff do` itself.
#
# Not the same thing as `queue`, which is one job per project across several projects and cannot
# commit. The rule "never queue a sequence" is about that limitation, not about sequences.
if [[ "$MODE" == "sequence" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    shift
    exec "$HANDOFF_HOME/tools/sequence" "$@"
fi

# A queue of jobs, run unattended. Outside the mode switch for the same reason as `auto`: it
# invokes the driver (and the bench) many times rather than being one invocation of it.
if [[ "$MODE" == "overnight" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    export HANDOFF_HOME
    shift
    exec "$HANDOFF_HOME/tools/overnight" "$@"
fi

# `log` and `stats` read the journal and need no slug — they are about the history, not one run.
if [[ "$MODE" == "log" || "$MODE" == "stats" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    [[ "$MODE" == "log" ]] &&
        exec "$HANDOFF_HOME/tools/journal" --repo "$REPO_ROOT" list ${SLUG:+--slug "$SLUG"}
    shift                       # drop the mode; anything left is a flag for `stats`
    exec "$HANDOFF_HOME/tools/journal" --repo "$REPO_ROOT" stats "$@"
fi

# The two view gates, reachable from any project.
#
# They exist to be written into a plan's `## Verification` block, and a plan cannot say
# `tools/css-contrast` — that path only resolves inside this checkout, and the whole point of
# installing `handoff` on PATH is that a project never needs to know where the harness lives. A
# criterion naming a path the project does not have is a criterion that fails for the wrong reason,
# which is the exact failure mode this repository keeps finding.
# One table, not a chain of special cases. Every gate a plan may name lives here; adding one is a
# line, and forgetting to add one is how `ledger` shipped with `tools/docblock-anchor` in its
# verification block — which resolves inside this checkout and nowhere else, and would have failed
# for the wrong reason in the first real project that used it.
case "$MODE" in
    contrast)        GATE_TOOL="css-contrast" ;;
    view-lint)       GATE_TOOL="view-lint" ;;
    docblock-anchor) GATE_TOOL="docblock-anchor" ;;
    patch-shape)     GATE_TOOL="patch-shape" ;;
    *)               GATE_TOOL="" ;;
esac
if [[ -n "$GATE_TOOL" ]]; then
    HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
    TOOL="$HANDOFF_HOME/tools/$GATE_TOOL"
    [[ -x "$TOOL" ]] || { echo "no $MODE gate at $TOOL" >&2; exit 1; }
    shift
    exec "$TOOL" "$@"
fi

if [[ -z "$MODE" || -z "$SLUG" ]]; then
    echo "usage: handoff {do|prepare|check|resume|diff|verify|retro|auto} <slug>" >&2
    echo "       handoff {init|log|stats|doctor}" >&2
    echo "       handoff {contrast|view-lint|docblock-anchor|patch-shape} <file>" >&2
    exit 64
fi

HANDOFF_HOME="$(cd "$(dirname "$(_handoff_real_self)")/.." && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Project-specific conventions and verification commands. Without this the implementer has no
# idea how the project builds, tests, or formats — the single biggest source of avoidable churn.
#
# Sourced BEFORE the paths below are resolved. An earlier version computed them first, so the
# HANDOFF_PLANS_DIR override that templates/config.sh documents silently did nothing and the
# driver reported "plan not found" for a plan that existed.
# Addressed to the implementer, so it must not ask for anything. The previous wording — "create
# .handoff/config.sh" — was written for a human reading the terminal, went into the model's prompt,
# and got obeyed: the first clean-room run of the quickstart was rejected for an invented file the
# harness had told it to invent. Setup instructions belong in the setup output, not in the task.
PROJECT_RULES="(This project has no .handoff/config.sh, so no build, test or formatting conventions were supplied. Follow the conventions visible in the files you are editing. Do not create a config file.)"
# A user-level config, so the harness is usable in a repository that knows nothing about it.
#
# Without this, driving a local model anywhere meant `HANDOFF_PROVIDER=native handoff do <slug>`
# every time, or a config file committed into every project. Neither is reasonable for a tool whose
# whole point is being pointed at arbitrary code. Anything the provider contract reads belongs
# here: HANDOFF_PROVIDER, HANDOFF_MODEL, LLAMACPP_PORT.
#
# Sourced BEFORE the project's own config, so a repository that does have opinions still wins. An
# environment variable set on the command line beats both, because every assignment in either file
# is a `:=` default rather than a plain one.
# shellcheck disable=SC1091
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/agent-handoff/config.sh"
[[ -f "$USER_CONFIG" ]] && source "$USER_CONFIG"
# shellcheck disable=SC1091
[[ -f "$REPO_ROOT/.handoff/config.sh" ]] && source "$REPO_ROOT/.handoff/config.sh"

PLANS_DIR="${HANDOFF_PLANS_DIR:-$REPO_ROOT/.handoff/plans}"
RUNS_DIR="${HANDOFF_RUNS_DIR:-$REPO_ROOT/.handoff/runs}"
PLAN_FILE="$PLANS_DIR/${SLUG}.md"
RUN_DIR="$RUNS_DIR/$SLUG"
SCHEMA="$HANDOFF_HOME/schemas/handoff.schema.json"

PROVIDER="${HANDOFF_PROVIDER:-codex}"
PROVIDER_FILE="$HANDOFF_HOME/providers/${PROVIDER}.sh"
[[ -f "$PROVIDER_FILE" ]] || { echo "unknown provider: $PROVIDER" >&2; exit 64; }

# Defaults for the optional half of the provider contract, defined BEFORE the adapter so any
# adapter can override them. Without these the driver called functions that did not exist and bash
# printed `provider_capabilities: command not found` in the middle of a run — noise that reads like
# a harness crash, and that hid the genuinely serious case immediately below.
provider_capabilities() { :; }
provider_parse_session_id() { return 1; }

# shellcheck disable=SC1090
source "$PROVIDER_FILE"

# One round at a time against the shared local model.
#
# The repository lock above stops two rounds sharing a working tree. This stops two rounds sharing
# the GPU, which is a different failure and a quieter one. llama-server here has four slots, so
# concurrent rounds do not fail — they succeed, and providers/lcpp.sh states the cost in its own
# comment: token accounting brackets a round by BYTE OFFSET into llamacpp.log, and "a second
# client talking to the same server would be counted into whichever run happened to be open".
# Nothing rejects that round. Its numbers are simply wrong.
#
# flock, and re-exec, for the reason bench/run records: `--close` keeps the descriptor out of the
# child, so a model process that outlives its parent cannot go on holding the lock. A pid file
# cannot do that, and an inherited descriptor once wedged the bench for a full 600 seconds.
#
# The whole round runs under it, not just the model call. Holding it through verification costs a
# few extra seconds of serialisation and keeps this identical to bench/run — one pattern, one
# recorded lesson, two callers — rather than inventing a narrower scope that needs its own proof.
GPU_LOCK="${TMPDIR:-/tmp}/agent-handoff-gpu.lock"
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && -n "${HANDOFF_USES_LOCAL_GPU:-}" \
      && -z "${HANDOFF_GPU_LOCK_HELD:-}" ]]; then
    export HANDOFF_GPU_LOCK_HELD=1
    _queue="$HANDOFF_HOME/tools/gpu-queue"
    _ticket=""
    # `flock -n <file> true` takes the lock and drops it again, which is the only honest way to
    # ask "is it free" — and if it is, say nothing at all. A queue that announces itself when
    # there is no queue is noise, and noise is how a real message gets skimmed past.
    if [[ -x "$_queue" ]] && ! flock -n "$GPU_LOCK" true 2>/dev/null; then
        _ticket="$("$_queue" take "$SLUG" "$REPO_ROOT" --pid $$ 2>/dev/null || true)"
        echo "==> the local model is busy — waiting"
        _status="$("$_queue" status "$_ticket" 2>/dev/null || true)"
        [[ -n "$_status" ]] && printf '%s\n' "$_status"
        # The queue only knows about rounds that took a TICKET. bench/run takes the same lock with
        # a bare flock and registers nothing, so the status can truthfully say "nobody" about a
        # lock that is definitely held -- which is how a deadlocked run came to print "holder:
        # nobody — the model is free" every two minutes while waiting on it. Say which it is.
        if [[ "$_status" == *nobody* ]]; then
            echo "    NOTE: the lock is held by a process that registered no ticket — almost"
            echo "    always a benchmark. 'nobody' above means 'no queued round', not 'free'."
        fi
        echo "    (Ctrl-C to give up; nothing has been written yet)"
        _waited=0
        _limit="${HANDOFF_GPU_WAIT:-7200}"
        until flock -n "$GPU_LOCK" true 2>/dev/null; do
            # Bounded. This loop had no exit but success, so a lock that was never going to be
            # released -- one held by an ANCESTOR of this very process, which is what a bench round
            # produced -- waited forever at 15 W with no error and no deadline. An unbounded wait
            # for a condition that cannot change is a hang, not patience.
            if (( _waited >= _limit )); then
                echo "==> giving up after ${_waited}s: the GPU lock was never released." >&2
                echo "    Nothing has been written. If a benchmark is running, wait for it;" >&2
                echo "    if this round was started from INSIDE one, that is a bug -- bench/run" >&2
                echo "    must export HANDOFF_GPU_LOCK_HELD=1 so nested rounds do not re-take" >&2
                echo "    the lock their own parent holds." >&2
                [[ -n "$_ticket" ]] && "$_queue" drop "$_ticket" 2>/dev/null || true
                exit 75
            fi
            # Configurable only so the selftest can exercise the wait without taking a minute.
            sleep "${HANDOFF_GPU_POLL:-15}"
            _waited=$(( _waited + ${HANDOFF_GPU_POLL:-15} ))
            # Every two minutes, not every fifteen seconds: the estimate moves slowly and a line
            # that repeats faster than the thing it describes stops being read.
            if (( _waited % ${HANDOFF_GPU_REPORT:-120} == 0 )); then
                echo "==> still waiting (${_waited}s)"
                "$_queue" status "$_ticket" 2>/dev/null || true
            fi
        done
        [[ -n "$_ticket" ]] && "$_queue" drop "$_ticket" 2>/dev/null || true
        echo "==> the model is free — starting"
    fi
    # -w is a backstop, not the mechanism: the loop above has already waited for it to be free.
    # It bounds the case where another round wins the race between that check and this line.
    exec flock --close -w "${HANDOFF_GPU_WAIT:-7200}" "$GPU_LOCK" "$0" "$@"
fi

# A provider with no session support cannot resume, and must say so rather than appearing to work.
#
# Found while checking a field report that said `resume` exits 0 without verifying. That specific
# bug was already fixed — resume does verify — but the investigation turned up a worse one wearing
# the same clothes: with no `provider_resume`, bash printed `command not found`, the driver ran no
# model at all, and then verified the untouched tree and printed a verdict on it. The verdict was
# real, the round was not, and the commonest provider here — Cline, whose `--id` is incompatible
# with `--json` in 3.0.52 — is exactly one of these.
if [[ "$MODE" == "resume" ]] && ! declare -F provider_resume >/dev/null; then
    echo "provider '$PROVIDER' cannot resume: it has no session support." >&2
    echo "Use a repair attempt instead, which needs no session:" >&2
    echo "  HANDOFF_FEEDBACK_FILE=$RUN_DIR/feedback.md HANDOFF_PROVIDER=$PROVIDER handoff do $SLUG" >&2
    exit 64
fi

provider_preflight || exit 1

# Harness scratch state churns on its own during a run and is not the implementer's doing.
# Excluding it keeps the changed-file list honest for review.
DIFF_EXCLUDES=(
    ':(exclude).handoff/runs/**'
    ':(exclude).handoff/journal/**'
    ':(exclude).handoff/scratch/**'
    ':(exclude).omc/**'
    ':(exclude)storage/logs/**'
    ':(exclude)storage/framework/**'
    ':(exclude)node_modules/**'
    ':(exclude)vendor/**'
)

# Snapshot the whole working tree (tracked + untracked, honouring .gitignore) into a git tree
# object, using a throwaway index so the real index is never touched. Comparing before/after
# trees yields exactly what the implementer changed, with pre-existing dirty state filtered out.
# Plain `git diff` is useless in a repo that already has uncommitted work.
snapshot_tree() {
    local idx
    idx="$(mktemp)"
    # A fresh repo with no commits has no .git/index. Copying it fails, and mktemp's zero-byte
    # file is not a valid index — git aborts with "index file smaller than expected". Remove the
    # placeholder so git creates a real index at that path instead.
    if ! cp -f "$(git rev-parse --git-dir)/index" "$idx" 2>/dev/null; then
        rm -f "$idx"
    fi
    GIT_INDEX_FILE="$idx" git add -A
    GIT_INDEX_FILE="$idx" git write-tree
    rm -f "$idx"
}

DEV_INSTRUCTIONS="You are the implementer in a two-model workflow. Another model wrote the plan and will review your work; you write the code. The plan file is the complete specification — implement exactly what it says, nothing more. Do not create git commits, do not amend, do not stash, do not run git checkout or git reset. Leave every change uncommitted in the working tree. Do not modify files listed as out of scope. If the plan is wrong or ambiguous, implement your best reading and record it under deviations rather than stopping. Report honestly: never claim a test passed unless you ran it and saw it pass."

# The operational rules are a separate layer from both the plan and the project's own conventions,
# and only the rule headings travel to the model — the rationale table in that file is for the
# maintainer. Three layers, kept apart on purpose: benchmark findings (never shown to the model,
# because telling a model under test which mistakes it is expected to make contaminates the
# measurement), these task-independent rules, and the plan.
#
# Extracted rather than inlined so the rules can be edited and diffed as prose. Everything from
# the first "## EDITING RULES" heading to the "## Why each rule is here" heading is sent.
AGENT_RULES_FILE="${HANDOFF_AGENT_RULES:-$HANDOFF_HOME/templates/agent-rules.md}"
if [[ -f "$AGENT_RULES_FILE" ]]; then
    AGENT_RULES="$(awk '
        /^## EDITING RULES/ { on=1 }
        /^## Why each rule is here/ { on=0 }
        on { print }
    ' "$AGENT_RULES_FILE")"
    [[ -z "$AGENT_RULES" ]] || DEV_INSTRUCTIONS="$DEV_INSTRUCTIONS

$AGENT_RULES"
fi

# Run the harness's own verifier over the working tree and report its verdict.
#
# This is the step that makes a local implementer usable. The model's report is not evidence — in
# this project runs have claimed `status: complete` over trees they never touched, and between a
# quarter and two fifths of runs return no report at all while leaving a byte-perfect patch. So the
# question "did this work?" has to be answered by running commands against the tree, not by reading
# what the model said about it.
#
# It also decides what a hosted reviewer is worth paying for. A rejected round should never reach
# one: the whole economic case for a local implementer collapses if every attempt costs hosted
# tokens to triage.
run_verification() {
    local slug="$1"
    local plan="$PLANS_DIR/${slug}.md"
    local out="$RUN_DIR/evidence"
    # $HANDOFF_HOME, not $REPO_ROOT. The verifier ships with the harness; REPO_ROOT is the user's
    # project, which has no reason to contain it. Getting this wrong made verification skip
    # silently for every real user while the benchmark — which calls verify-round by absolute path
    # — kept working, so nothing here noticed. Found by running the actual first-use journey in a
    # scratch project rather than by testing the verifier directly.
    local verifier="$HANDOFF_HOME/tools/verify-round"
    # Handed to the verifier so it can tell the model's new files from the repository's own.
    export HANDOFF_UNTRACKED_BEFORE="$RUN_DIR/untracked-before"

    [[ -x "$verifier" ]] || {
        echo "==> no verifier at tools/verify-round — skipping (nothing checked this tree)" >&2
        return 0
    }
    [[ -f "$plan" ]] || { echo "plan not found: $plan" >&2; return 1; }

    # The verdict is only about this run if the tree was clean when the run started. Otherwise it
    # covers pre-existing changes too, which is a different claim, so say so rather than implying
    # a cleanliness the evidence does not support.
    if [[ -s "$RUN_DIR/tree-before" ]]; then
        local head_tree; head_tree="$(git rev-parse HEAD^{tree} 2>/dev/null || true)"
        if [[ -n "$head_tree" && "$(cat "$RUN_DIR/tree-before")" != "$head_tree" ]]; then
            echo "==> NOTE: the tree was already modified before this run; the verdict below covers"
            echo "==>       every uncommitted change, not only what this run did."
        fi
    fi

    echo
    echo "==> verifying against HEAD"
    # The run-start snapshot gives untracked read-only files a baseline. Without it the gate can
    # only see that they exist, not whether they changed.
    local snapshot=""
    [[ ! -s "$RUN_DIR/tree-before" ]] || snapshot="$(cat "$RUN_DIR/tree-before")"
    "$verifier" "$REPO_ROOT" "$plan" HEAD "$out" "$snapshot"
    local verdict=$?
    echo "==> evidence: ${out#"$REPO_ROOT"/}/evidence.md"
    return "$verdict"
}

# One round at a time per repository, enforced rather than requested.
#
# The rule "nothing should touch the tree between `handoff do` and its verdict" was written into
# the skill and then broken the same day, by two agent sessions driving this harness at the same
# checkout. Their rounds interleaved: one wrote four patches into a 1,052-line component while the
# other, following the skill's own "revert and re-run" step, ran `git checkout --` over it. The
# verdict that came back said `no-op`, "the working tree is unchanged; nothing was implemented" —
# a true statement about the tree and a false one about the round, and there was nothing in the
# artifacts to tell the difference. Five rounds of evidence were void before anyone noticed, and
# what noticed was a plan file appearing on disk that neither session had written.
#
# A verdict over a tree someone else is editing is not a weaker measurement, it is not a
# measurement. So this refuses rather than warns.
#
# mkdir is the atomic primitive: it either creates the directory or fails, with no window between
# testing and taking. A lock file written after a test has that window, and two rounds starting
# together is exactly the case worth being careful about.
#
# The lock lives OUTSIDE the repository, keyed by the checkout's absolute path. Putting it in
# `.handoff/` seemed natural and was wrong: the first full suite run after that change failed
# harness-selftest, because a lock directory in the tree is an untracked file the plan never named
# — the scope gate read it as litter and downgraded a `patch-incomplete` round to `patch-damaged`.
# A guard that changes the verdicts it is supposed to be protecting is worse than the fault it
# guards against. Out of tree it cannot interact with any gate, and it still finds every session
# on the same checkout however each has configured HANDOFF_RUNS_DIR.
LOCK_ROOT="${XDG_RUNTIME_DIR:-/tmp}/agent-handoff-locks"
LOCK_DIR="$LOCK_ROOT/$(printf '%s' "$REPO_ROOT" | tr '/' '%')"
LOCK_HELD=""

release_lock() {
    [[ -n "$LOCK_HELD" ]] && rm -rf "$LOCK_DIR"
    LOCK_HELD=""
}

acquire_lock() {
    mkdir -p "$LOCK_ROOT"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        local holder_pid holder_slug holder_since
        holder_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        holder_slug="$(cat "$LOCK_DIR/slug" 2>/dev/null || echo '?')"
        holder_since="$(cat "$LOCK_DIR/since" 2>/dev/null || echo '?')"
        # A lock whose owner is gone is litter, not a conflict — a round killed with SIGKILL leaves
        # one behind, and a harness that then refuses to run until someone deletes a file by hand
        # would be a worse failure than the one it is preventing.
        if [[ -z "$holder_pid" ]] || ! kill -0 "$holder_pid" 2>/dev/null; then
            echo "==> NOTE: clearing a stale lock from '$holder_slug' (pid ${holder_pid:-unknown}" \
                 "is gone, held since $holder_since)"
            rm -rf "$LOCK_DIR"
            mkdir "$LOCK_DIR" 2>/dev/null || { echo "cannot create $LOCK_DIR" >&2; exit 70; }
        else
            echo "refusing to start: a round is already running in this repository." >&2
            echo "    slug:    $holder_slug" >&2
            echo "    pid:     $holder_pid" >&2
            echo "    since:   $holder_since" >&2
            echo >&2
            echo "    lock:    $LOCK_DIR" >&2
            echo >&2
            echo "Two rounds sharing one working tree produce verdicts about each other's edits," >&2
            echo "not about either plan. Wait for that one to finish, or stop it." >&2
            exit 69
        fi
    fi
    echo "$$" >"$LOCK_DIR/pid"
    echo "$SLUG" >"$LOCK_DIR/slug"
    date -u +%Y-%m-%dT%H:%M:%SZ >"$LOCK_DIR/since"
    LOCK_HELD=1
    trap release_lock EXIT INT TERM
}

case "$MODE" in
diff)
    if [[ ! -f "$RUN_DIR/tree-before" || ! -f "$RUN_DIR/tree-after" ]]; then
        echo "no completed run recorded for '$SLUG'" >&2
        exit 1
    fi
    git diff-tree -r --name-status \
        "$(cat "$RUN_DIR/tree-before")" "$(cat "$RUN_DIR/tree-after")" -- "${DIFF_EXCLUDES[@]}"
    exit 0
    ;;

do)
    [[ -f "$PLAN_FILE" ]] || {
        echo "plan not found: $PLAN_FILE" >&2
        echo "write it first — see $HANDOFF_HOME/templates/plan.md" >&2
        exit 1
    }
    acquire_lock
    mkdir -p "$RUN_DIR"
    snapshot_tree >"$RUN_DIR/tree-before"
    # Which files were ALREADY untracked, before the model ran.
    #
    # The scope gate lists untracked files as ones the model invented, and had no way to tell a
    # file the model created from one that was sitting in the repository beforehand. Reported from
    # real use: six pre-existing untracked files in an unrelated directory were reported as
    # "6 file(s) outside the plan, 6 of them invented" and turned an otherwise good round into
    # patch-damaged.
    #
    # The benchmark could never have caught this. bench/run works in a worktree cut fresh from a
    # commit, where nothing untracked exists — so the harness was correct in the only environment
    # it was ever tested in, and wrong in every real repository.
    git -c core.quotePath=false ls-files --others --exclude-standard >"$RUN_DIR/untracked-before" 2>/dev/null || : >"$RUN_DIR/untracked-before"
    PROMPT="Implement the plan in the file ${PLAN_FILE#"$REPO_ROOT"/} relative to the repository root.

Read that file first, in full. It is the complete specification: implement every step and satisfy every acceptance criterion, and do not do anything it does not ask for.

${PROJECT_RULES}

When you are done, run the verification commands listed in the plan and report the real results. Leave all changes uncommitted in the working tree — the reviewer reads the diff and owns the commit."

    # A repair attempt. The harness has already run the plan's verification commands and knows
    # exactly which ones failed, so the model is told that rather than being asked to look again.
    #
    # This exists as a `do`-mode option rather than relying on `handoff resume` because resume
    # needs provider session support, and the Cline adapter has none: `--id` is incompatible with
    # --json in 3.0.52. A repair loop that only worked for some providers would silently measure
    # different things for different models.
    if [[ -n "${HANDOFF_FEEDBACK_FILE:-}" && -s "${HANDOFF_FEEDBACK_FILE}" ]]; then
        PROMPT="$PROMPT

## Previous attempt

You already attempted this task and the working tree still holds your changes.

$(cat "$HANDOFF_FEEDBACK_FILE")

Fix only what is needed to make those checks pass. Do not start over, do not revert your earlier
work, and do not change anything the plan did not ask for."
    fi
    ;;

resume)
    [[ -f "$RUN_DIR/feedback.md" ]] || { echo "no feedback at $RUN_DIR/feedback.md" >&2; exit 1; }
    [[ -s "$RUN_DIR/session-id" ]] || { echo "no session id for '$SLUG' — run 'handoff do' first" >&2; exit 1; }
    # A resume writes to the same tree as a `do`, so it takes the same lock. Locking only `do`
    # would leave the commonest pairing — one session resuming while another starts fresh —
    # exactly as unprotected as before.
    acquire_lock
    SESSION_ID="$(cat "$RUN_DIR/session-id")"
    PROMPT="Review feedback on your implementation. Address every point, then re-run the verification commands.

$(cat "$RUN_DIR/feedback.md")

${PROJECT_RULES}

Leave all changes uncommitted."
    ;;

queue | drain)
    # The detached half of the GPU lock: enqueue from any project, drain them one at a time.
    # Placed before the modes that need a plan file, because `queue --list` and `drain` need a
    # slug for neither.
    SPOOL="$HANDOFF_HOME/tools/spool"
    [[ -x "$SPOOL" ]] || { echo "no spool at tools/spool" >&2; exit 1; }
    export HANDOFF_BIN="$(_handoff_real_self)"
    if [[ "$MODE" == "drain" ]]; then
        shift
        exec "$SPOOL" drain "$@"
    fi
    shift
    if [[ $# -eq 0 || "${1:-}" == "--list" ]]; then
        exec "$SPOOL" list
    fi
    if [[ "${1:-}" == "--clear" ]]; then
        shift; exec "$SPOOL" clear "$@"
    fi
    QUEUE_SLUG="$1"; shift
    exec "$SPOOL" add "$QUEUE_SLUG" "$REPO_ROOT" "$@"
    ;;

check | prepare)
    # Reachable from any project, which tools/check-plan is not: only bin/ is on PATH, and asking
    # someone to know where the harness is checked out defeats the point of checking at all.
    CHECKER="$HANDOFF_HOME/tools/check-plan"
    [[ -x "$CHECKER" ]] || { echo "no checker at tools/check-plan" >&2; exit 1; }
    [[ -f "$PLAN_FILE" ]] || {
        echo "plan not found: $PLAN_FILE" >&2
        echo "plans for this project live in ${PLANS_DIR#"$REPO_ROOT"/}" >&2
        exit 1
    }
    # Shape first, and it is the only part that can refuse: a plan with six criteria and two
    # commands can never score above 2/6, so the harness will not run it.
    "$CHECKER" "$PLAN_FILE" || exit $?

    # Then the advisory pass. Separate tool, deliberately: this one never refuses, because a
    # second gate that could block would get bypassed and then neither would run.
    #
    # `prepare` is `check --dry-run` under a name that says what it is for. Three of the failures
    # it reads for were found by a reviewer AFTER a round had been spent, and each was visible in
    # the plan beforehand — an unanchored zero-assertion, a grep against coloured output, a state
    # named and never gated. One command before the round, rather than three.
    LINTER="$HANDOFF_HOME/tools/plan-lint"
    if [[ -x "$LINTER" ]]; then
        echo
        "$LINTER" "$PLAN_FILE" --repo "$REPO_ROOT" || true
    fi
    if [[ "$MODE" == "prepare" ]]; then
        set -- "$1" "$2" --dry-run "${@:4}"
    fi

    # --dry-run: run every acceptance command against the tree AS IT IS NOW, before any model time
    # is spent, and show what each one actually saw.
    #
    # This turns two failures that used to cost a whole round into a ten-second read:
    #
    #   already PASSES   the criterion does not test the change. It was true before the work
    #                    started, so it will be true afterwards whatever the model does.
    #   cannot pass      an unsatisfiable command — one that greps for a pattern the tool never
    #                    emits, asserts a count the file already violates, or matches against
    #                    coloured output. Reported from real use twice: a plan asserted zero double
    #                    blank lines in a file that already had eleven, and another grepped
    #                    `Tests:[^0-9]*77 passed` against output whose colour escapes contain
    #                    digits. Both are indistinguishable from a broken implementation once a
    #                    round has been spent.
    #
    # A failing command here is NORMAL — the work has not been done yet. The point is that you read
    # the output and can say why each one fails.
    if [[ "${3:-}" == "--dry-run" || "${HANDOFF_DRY_RUN:-}" == "1" ]]; then
        echo
        echo "==> acceptance commands against the CURRENT tree (no model, nothing changed)"
        DRY_CMDS="$(mktemp)"
        awk '
            /^## Verification/ { in_section=1; next }
            in_section && /^## / { exit }
            in_section && /^```/ { if (in_block) exit; in_block=1; next }
            in_block && NF { print }
        ' "$PLAN_FILE" >"$DRY_CMDS"
        DRY_IDX=0; DRY_PASS=0
        while IFS= read -r dry_command; do
            DRY_IDX=$(( DRY_IDX + 1 ))
            # The assignment IS the condition, deliberately. `set -e` is in force, and a plain
            # `DRY_OUT="$(...)"` whose command fails aborts the whole script — which is every
            # criterion here, since the work has not been done yet. The first version of this
            # printed the heading and then silently exited before a single line.
            # Redirected to a file, NOT captured with $( ).
            #
            # `timeout` signals the process it started; a command substitution waits for the PIPE
            # to close, and any process still holding the write end keeps it open — including one
            # the timeout never signalled. Reproduced:
            #
            #   "$(timeout 3 bash -c 'sleep 30 & echo x; wait')"           3s, rc 124
            #   "$(timeout 3 bash -c 'setsid sleep 25 & echo x; sleep 100')"  25s, rc 124
            #
            # Both timed out; only the detached one blocked, for as long as the grandchild lived.
            # pest-plugin-browser leaves a `playwright run-server` child that inherits stdout and
            # outlives the run, so a criterion running the Browser suite hung `prepare` for ~20
            # minutes with no indication which command was responsible. The timeout has been here
            # since 2026-08-12 and could never have helped.
            #
            # tools/verify-round already writes acceptance output to a file for the same reason,
            # which is why rounds never hung and only `prepare` did.
            DRY_LOG="$(mktemp)"
            if (cd "$REPO_ROOT" && NO_COLOR=1 TERM=dumb CLICOLOR=0 \
                timeout 120 bash -o pipefail -c "$dry_command" >"$DRY_LOG" 2>&1); then
                DRY_OUT="$(cat "$DRY_LOG")"; rm -f "$DRY_LOG"
                DRY_PASS=$(( DRY_PASS + 1 ))
                printf '  %2d  ALREADY PASSES  %s\n' "$DRY_IDX" "${dry_command:0:88}"
                echo "      ^ this criterion does not test the change — it was true before it"
            else
                DRY_OUT="$(cat "$DRY_LOG")"; rm -f "$DRY_LOG"
                printf '  %2d  fails now       %s\n' "$DRY_IDX" "${dry_command:0:88}"
            fi
            # Show the output with control characters VISIBLE. The whole point of this mode is
            # the colour trap, and colour is invisible in a terminal by construction — the escapes
            # are what you need to see. `cat -v` renders them as ^[[90m, which is the form the
            # failure is recognisable in.
            if [[ -n "$DRY_OUT" ]]; then
                sed -n '1,2p' <<<"$DRY_OUT" | cat -v | sed 's/^/      | /'
            elif [[ "$dry_command" == *"|"* ]]; then
                # A silent failure in a pipeline tells you nothing, and "drop -q" does not help:
                # a grep that does not MATCH prints nothing either way. The only thing that shows
                # the trap is the input the last stage was matching against, so run the pipeline
                # up to the final `|` and show that instead.
                #
                # This is what turns the colour failure from a mystery into an obvious one: the
                # escapes appear, rendered by cat -v, and `Tests:[^0-9]*77 passed` is visibly
                # unable to span ^[[39m. It re-runs the left-hand side, so it costs whatever that
                # costs — acceptable in a mode whose entire purpose is inspection.
                DRY_LEFT="${dry_command%|*}"
                # Only when the split lands between stages, not inside a substitution.
                #
                # `test "$(git status --porcelain | wc -l)" -eq 1` has its only pipe INSIDE $( ),
                # so cutting at the last one produces `test "$(git status --porcelain ` — which
                # bash refuses with "unexpected EOF while looking for matching `)'". That message
                # then appeared under a criterion as though it were the criterion's own output,
                # which is exactly the kind of misdirection this mode exists to remove.
                if [[ "$(tr -cd '(' <<<"$DRY_LEFT" | wc -c)" != "$(tr -cd ')' <<<"$DRY_LEFT" | wc -c)" ]]; then
                    echo "      | (silent, and its only pipe is inside a \$( ) substitution, so"
                    echo "      |  there is no left-hand side to show. Run it yourself.)"
                    continue
                fi
                echo "      | (silent. What its last stage was matching against:)"
                if DRY_IN="$(cd "$REPO_ROOT" && NO_COLOR=1 TERM=dumb CLICOLOR=0 \
                    timeout 60 bash -o pipefail -c "$DRY_LEFT" 2>&1)"; then :; fi
                if [[ -n "$DRY_IN" ]]; then
                    sed -n '1,3p' <<<"$DRY_IN" | cat -v | sed 's/^/      | /'
                else
                    echo "      |  (nothing — the left-hand side produced no output either)"
                fi
            else
                echo "      | (no output — a silent command, so there is nothing to show. Run it"
                echo "      |  yourself if the reason it fails is not obvious.)"
            fi
        done <"$DRY_CMDS"
        rm -f "$DRY_CMDS"
        echo
        echo "  $DRY_PASS of $DRY_IDX already pass. Every one of those needs a reason, and"
        echo "  every failure above should fail for the reason you expect — read the output."
    fi
    exit 0
    ;;

verify)
    run_verification "$SLUG"
    exit $?
    ;;

roundup)
    # Read-only, and additive: it reads the journal and the archived evidence bundles, and writes
    # only to the central round-up store. Nothing a run depends on is touched.
    ROUNDUP="$HANDOFF_HOME/tools/roundup"
    [[ -x "$ROUNDUP" ]] || { echo "no roundup at tools/roundup" >&2; exit 1; }
    exec "$ROUNDUP" ${SLUG:+"$SLUG"} --repo "$REPO_ROOT" "${@:3}"
    ;;

retro)
    # Ask the model what it thinks went wrong, after it has been told what actually did.
    #
    # A read-only turn, deliberately: the round is already graded, and a model given a second bite
    # at a rejected tree would take it. The value here is not the model's self-assessment — it is
    # the plan defects the self-assessment names, which are the reviewer's to act on.
    JOURNAL="$HANDOFF_HOME/tools/journal"
    RETRO_PROMPT_FILE="$RUN_DIR/retro-prompt.txt"
    "$JOURNAL" --repo "$REPO_ROOT" retro-prompt "$SLUG" >"$RETRO_PROMPT_FILE" || exit 1
    echo "==> asking $PROVIDER to reflect on '$SLUG' (no edits: this turn is read-only)"
    set +e
    provider_run "$REPO_ROOT" "$SCHEMA" "$RUN_DIR/retro.json" "$RUN_DIR/retro.log" \
        "You are reviewing a finished, already-graded task. Answer the question asked and change nothing. Do not edit files, do not run commands, do not create anything." \
        "$(cat "$RETRO_PROMPT_FILE")"
    RETRO_STATUS=$?
    set -e
    if [[ -s "$RUN_DIR/retro.json" ]]; then
        "$JOURNAL" --repo "$REPO_ROOT" attach "$SLUG" --retro "$RUN_DIR/retro.json"
        echo "==> handoff show: tools/journal show $SLUG"
    else
        echo "==> the provider returned nothing (exit $RETRO_STATUS); nothing attached" >&2
        exit 1
    fi
    exit 0
    ;;

*)
    echo "unknown mode: $MODE (expected do|prepare|contrast|view-lint|check|resume|diff|verify|retro|auto|sequence|overnight|log|stats|init|doctor)" >&2
    exit 64
    ;;
esac

# Degrade loudly, never silently. A prompt-and-validate JSON round is not the same guarantee as
# a schema-enforced one, and the difference has to be visible in the log.
while IFS='=' read -r cap level; do
    [[ "$level" == "native" ]] || echo "==> NOTE: $PROVIDER $cap is '$level', not native"
done < <(provider_capabilities)

# The plan's declared paths, for providers that can enforce them during the round rather than
# leaving them to the gates afterwards. Extracted by tools/plan-files, which shares verify-round's
# expressions rather than adding a parser.
if [[ -f "$PLAN_FILE" ]]; then
    HANDOFF_PLAN_WRITABLE="$("$HANDOFF_HOME/tools/plan-files" "$PLAN_FILE" writable 2>/dev/null | paste -sd: -)"
    HANDOFF_PLAN_READONLY="$("$HANDOFF_HOME/tools/plan-files" "$PLAN_FILE" readonly 2>/dev/null | paste -sd: -)"
    export HANDOFF_PLAN_WRITABLE HANDOFF_PLAN_READONLY
fi

echo "==> handoff $MODE '$SLUG'  provider=$PROVIDER model=${HANDOFF_MODEL:-default} sandbox=${HANDOFF_SANDBOX:-workspace-write}"

# What was actually sent. Nothing recorded this before, and the gap is not cosmetic: a benchmark
# arm whose whole variable is a prompt layer could be a silent no-op — the rules file missing, an
# export landing after the read, a provider overlay not sourced — and every artifact in the results
# directory would look identical to a working arm. There is no way to tell those apart afterwards
# without the prompt, and by then the GPU time is spent.
#
# Written before the provider runs rather than after, so it survives a crash, a timeout, and a
# kill -9 partway through the round.
{
    printf '%s\n' "$DEV_INSTRUCTIONS"
    printf '\n----- 8< ----- task prompt -----\n\n'
    printf '%s\n' "$PROMPT"
} >"$RUN_DIR/prompt.md" 2>/dev/null || true

# A canonical-vocabulary view of the round, beside the artifacts rather than instead of them.
#
# provider.log stays authoritative: twelve tools read its names and 258 archived runs encode them.
# events.jsonl is a second view in one agreed vocabulary, so that "what happened in this round" has
# a single set of names. Nothing in the harness reads it, and nothing breaks if it is absent —
# every emit is best-effort and a failure here must never fail a round.
EVENTS="$RUN_DIR/events.jsonl"
RUN_EVENTS="$HANDOFF_HOME/tools/run-events"
event() {
    [[ -x "$RUN_EVENTS" ]] || return 0
    "$RUN_EVENTS" emit "$EVENTS" "$@" 2>/dev/null || true
}

STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
STARTED_EPOCH="$(date +%s)"

# Who is on the GPU, for anything that waits behind us. Best-effort throughout: this is a register
# a person reads, and it must never be able to fail a round.
if [[ -n "${HANDOFF_GPU_LOCK_HELD:-}" && -x "$HANDOFF_HOME/tools/gpu-queue" ]]; then
    "$HANDOFF_HOME/tools/gpu-queue" holding "$SLUG" "$REPO_ROOT" --pid $$ 2>/dev/null || true
    _release_gpu_holder() { "$HANDOFF_HOME/tools/gpu-queue" released 2>/dev/null || true; }
    trap '_release_gpu_holder; release_lock' EXIT INT TERM
fi

if [[ "$MODE" == "resume" ]]; then
    event ai-run-resume "slug=$SLUG" "plan=${PLAN_FILE#"$REPO_ROOT"/}"
else
    event ai-run-start "slug=$SLUG" "plan=${PLAN_FILE#"$REPO_ROOT"/}" \
        "base=$(cat "$RUN_DIR/tree-before" 2>/dev/null)"
fi

# A repair attempt is a state change, and it is the one worth seeing: the round did not start here,
# it came back with the harness's account of what failed.
if [[ -n "${HANDOFF_FEEDBACK_FILE:-}" && -s "${HANDOFF_FEEDBACK_FILE:-}" ]]; then
    event run.state "state=repair" "slug=$SLUG"
fi

set +e
if [[ "$MODE" == "resume" ]]; then
    provider_resume "$SESSION_ID" "$SCHEMA" "$RUN_DIR/result.json" "$RUN_DIR/stdout.log" "$DEV_INSTRUCTIONS" "$PROMPT"
else
    provider_run "$REPO_ROOT" "$SCHEMA" "$RUN_DIR/result.json" "$RUN_DIR/stdout.log" "$DEV_INSTRUCTIONS" "$PROMPT"
fi
STATUS=$?
set -e

# Only overwrite on a successful parse; a failed grep must not wipe a good id from an earlier run.
if SID="$(provider_parse_session_id "$RUN_DIR/stdout.log")" && [[ -n "$SID" ]]; then
    printf '%s\n' "$SID" >"$RUN_DIR/session-id"
fi

snapshot_tree >"$RUN_DIR/tree-after"

# The model's stream, in the same vocabulary. Read from the log the provider already wrote, so this
# adds no coupling to any adapter.
if [[ -x "$RUN_EVENTS" && -s "$RUN_DIR/stdout.log" ]]; then
    "$RUN_EVENTS" translate "$RUN_DIR/stdout.log" "$EVENTS" >/dev/null 2>&1 || true
fi

echo
echo "==> exit=$STATUS"
echo "==> handoff report: $RUN_DIR/result.json"
echo "==> changed by this run:"
git diff-tree -r --name-status \
    "$(cat "$RUN_DIR/tree-before")" "$(cat "$RUN_DIR/tree-after")" -- "${DIFF_EXCLUDES[@]}" || true

# Verify by default. HANDOFF_NO_VERIFY=1 is for callers that run the same gates themselves —
# bench/run does — so the work is not done twice inside a benchmark.
# resume verifies too. It did not, and exited 0 regardless, so a resumed round that the gates
# would have rejected looked like a pass — and was nearly reported as one.
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && "${HANDOFF_NO_VERIFY:-0}" != 1 ]]; then
    set +e
    run_verification "$SLUG"
    VERDICT=$?
    set -e

    # The gates decide, in both directions.
    #
    # A provider that exited cleanly over a tree the gates reject is a failed round. Less
    # obviously, a provider that failed over a tree the gates ACCEPT is a successful one: the
    # commonest provider failure by far is a missing or malformed completion report, which happens
    # on roughly one run in three and says nothing about the patch. Letting that override the
    # verdict would make `handoff do` exit non-zero on a third of its successes and teach anyone
    # scripting it to throw away good work.
    #
    # This is the same rule as everywhere else here: judge the tree, and treat the report as
    # untrusted metadata.
    if [[ "$STATUS" -ne 0 && "$VERDICT" -eq 0 ]]; then
        echo "==> NOTE: the provider exited $STATUS — most often a missing or malformed report —"
        echo "==>       but the gates accept this tree. Judging the tree: accepted."
    fi
    STATUS="$VERDICT"

    # Each gate, then the terminal event. `ai-run-end` carries the GATES' verdict: a provider that
    # exited cleanly over a rejected tree ends rejected, and one that died over an accepted tree
    # ends accepted. Judge the tree; the report is untrusted metadata.
    if [[ -x "$RUN_EVENTS" && -f "$RUN_DIR/evidence/evidence.json" ]]; then
        "$RUN_EVENTS" gates "$RUN_DIR/evidence/evidence.json" "$EVENTS" >/dev/null 2>&1 || true
    fi
    event ai-run-end "slug=$SLUG" \
        "outcome=$( [[ "$VERDICT" -eq 0 ]] && echo accepted || echo rejected )" \
        "provider_exit=$STATUS"
fi

# Record the round, after the verdict exists so the journal carries it rather than guessing.
#
# The run directory is reused by the next round of the same slug, which is how seven rounds of one
# feature came to leave three surviving logs. This copies the evidence, the plan and a trimmed
# event stream somewhere immutable before that can happen. HANDOFF_NO_JOURNAL=1 opts out;
# bench/run keeps its own records and does not need a second set.
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && "${HANDOFF_NO_JOURNAL:-0}" != 1 &&
      -x "$HANDOFF_HOME/tools/journal" ]]; then
    "$HANDOFF_HOME/tools/journal" --repo "$REPO_ROOT" record \
        --run-dir "$RUN_DIR" --slug "$SLUG" --mode "$MODE" --plan "$PLAN_FILE" \
        --provider "$PROVIDER" --model "${HANDOFF_MODEL:-}" \
        --reasoning "${HANDOFF_CLINE_THINKING:-}" --context "${HANDOFF_CONTEXT:-}" \
        --started "$STARTED_AT" --exit-status "$STATUS" \
        --handoff-home "$HANDOFF_HOME" || true
fi

# What the next waiter's estimate is drawn from. Recorded per provider, because a `native` round
# and a cloud round are not the same measurement and averaging them would describe neither.
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && -x "$HANDOFF_HOME/tools/gpu-queue" ]]; then
    "$HANDOFF_HOME/tools/gpu-queue" record "$PROVIDER" \
        "$(( $(date +%s) - STARTED_EPOCH ))" 2>/dev/null || true
fi

# The callback. `ai-run-end` already carries the verdict THE GATES REACHED — this only delivers it
# somewhere a person or an orchestrator is watching, so a detached round can announce itself
# instead of being polled for.
#
# Best-effort by construction, and deliberately not part of the verdict: a webhook that is down
# must not turn an accepted round into a failed one. The command is given the event as JSON on
# stdin and the verdict as $1, so a one-line notify script is enough to use it.
if [[ ( "$MODE" == "do" || "$MODE" == "resume" ) && -n "${HANDOFF_CALLBACK:-}" ]]; then
    _verdict=$([[ "$STATUS" -eq 0 ]] && echo accepted || echo rejected)
    printf '{"event":"ai-run-end","slug":"%s","repo":"%s","verdict":"%s","exit":%s,"seconds":%s,"started":"%s"}\n' \
        "$SLUG" "$REPO_ROOT" "$_verdict" "$STATUS" \
        "$(( $(date +%s) - STARTED_EPOCH ))" "$STARTED_AT" \
        | ( bash -c "$HANDOFF_CALLBACK" "$HANDOFF_CALLBACK" "$_verdict" "$SLUG" "$REPO_ROOT" \
            >/dev/null 2>&1 || true )
fi

exit "$STATUS"
